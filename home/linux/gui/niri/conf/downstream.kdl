// Downstream (DataEraserC) keybindings.
//
// Kept out of keybindings.kdl so that file stays byte-identical to upstream and a
// replay merge never has to resolve hunks inside it. Include order does the work:
// niri's `include` is positional and "binds will override previously-defined
// conflicting keys", so everything here wins over the upstream binds included
// before it (niri 26.04, wiki "Configuration: Include" -> "Binds").
//
// Consequence: a key may still only appear once *per file* — the duplicate-keybind
// parse error does not reach across includes, but two lines for the same key in
// this file (or in keybindings.kdl) still fail `niri validate`.

binds {
    // Mayuri's keybindings: index workspaces instead of upstream's named ones
    // ("1terminal", "2browser", ...). These override the Mod+1..5 / Mod+Ctrl+1..5
    // binds from keybindings.kdl rather than adding to them.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 0; }
    Mod+Ctrl+1 { move-column-to-workspace 1 ; }
    Mod+Ctrl+2 { move-column-to-workspace 2 ; }
    Mod+Ctrl+3 { move-column-to-workspace 3 ; }
    Mod+Ctrl+4 { move-column-to-workspace 4 ; }
    Mod+Ctrl+5 { move-column-to-workspace 5 ; }
    Mod+Ctrl+6 { move-column-to-workspace 6 ; }
    Mod+Ctrl+7 { move-column-to-workspace 7 ; }
    Mod+Ctrl+8 { move-column-to-workspace 8 ; }
    Mod+Ctrl+9 { move-column-to-workspace 9 ; }
    Mod+Ctrl+0 { move-column-to-workspace 0 ; }

    // Rule for Mayuri
    Mod+Space { toggle-window-floating; }
    Ctrl+Shift+Escape { spawn "missioncenter"; }
    Mod+P { spawn "~/.config/scripts/colorpicker"; }
    Mod+F12 { spawn "~/.config/scripts/dropdown_terminal"; }
    // Mod+E { spawn "nautilus"; } // upstream keeps Mod+E on the noctalia session panel
}
