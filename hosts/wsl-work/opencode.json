{
  "$schema": "https://opencode.ai/config.json",
  "shell": "nu",
  "provider": {
    "agentrouter-openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentRouter (OpenAI Compatible)",
      "options": {
        "baseURL": "https://ps.air-outer.com/v1",
        "apiKey": "{env:AGENTROUTER_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol"
        },
        "gpt-6-astra": {
          "name": "gpt-6-astra"
        },
        "claude-opus-4-8": {
          "name": "claude-opus-4-8"
        },
        "claude-opus-5": {
          "name": "claude-opus-5"
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "glm-5.3": {
          "name": "glm-5.3"
        }
      }
    },
    "agentrouter-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "AgentRouter (Anthropic)",
      "options": {
        "baseURL": "https://ps.air-outer.com",
        "apiKey": "{env:AGENTROUTER_API_KEY}"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "claude-opus-4-8"
        },
        "claude-opus-5": {
          "name": "claude-opus-5"
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        },
        "glm-5.3": {
          "name": "glm-5.3"
        }
      }
    }
  },
  "model": "agentrouter-openai/deepseek-v4-flash"
}
