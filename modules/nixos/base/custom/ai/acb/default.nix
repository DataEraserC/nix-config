{
  config,
  lib,
  pkgs,
  acb,
  llm-agents,
  myvars,
  ...
}:
# ACB（AgentChatBridge）：桥（acbl 静态入口）。
#
# 模块开关与端口来自 vars/networking 的 services.acb 注册表；dsh / drivers /
# opencode 已由 acbl 组件管理，不再由 nix-config 生成单元。本模块当前只生成
# acb-bridge（launcher）一个 systemd --user 单元。
# 数据在 ~/.local/share/acb；可写源码通过 modules.mutableSources 的
# agentChatBridge 根接入；没配置时只跳过链接，不退回 flake store。
let
  cfg = config.modules.acb;

  home = config.users.users.${myvars.username}.home;
  dataDir = cfg.dataDir;
  # profile 是四个单元的稳定入口：seed 之后 current 指向一个 generation，
  # 切换 generation 只换软链，单元文本不变。
  profileDir = "${dataDir}/profile";
  profileCurrent = "${profileDir}/current";
  configFile = "${dataDir}/config/config.toml";
  logDir = cfg.logDir;
  userProfileBin = "/etc/profiles/per-user/${myvars.username}/bin";
  basePath = "/run/current-system/sw/bin:${userProfileBin}:/run/wrappers/bin";

  acbSrc = acb.outPath;
  # acbl：静态入口包（launcher / supervisor / acbctl + unit 模板），进系统环境，
  # 也是 unit 的唯一入口；它的升级不再跟随 payload 换代。
  acblPkg = acb.packages.${pkgs.system}.acbl;
  # payload：bridge / harnesses / start-drivers.sh / acb-contract.json，
  # 由 acbl 的 profile 管理；nix-config 只负责把它 seed 成第一个 generation。
  payloadPkg = acb.packages.${pkgs.system}.acb-payload;
  # payload 收窄后不再带 lua 示例与 opencode-serve.sh；这两个是 nix-config
  # 现有单元仍在用的过渡文件，补在 seed 源上，等它们迁到 acbl 预设后再删。
  profileBootstrap = pkgs.runCommand "acb-profile-bootstrap" { } ''
    mkdir -p $out
    cp -a ${payloadPkg}/. $out/
    chmod -R u+w $out
    mkdir -p $out/examples
    cp -a ${acbSrc}/examples/lua $out/examples/
    mkdir -p $out/deploy/components/opencode
    cp -a ${acbSrc}/deploy/components/opencode/opencode-serve.sh \
      $out/deploy/components/opencode/opencode-serve.sh
  '';

  sourceRoot = config.lib.mutableSources.resolve { name = "agentChatBridge"; };

  # 脚本正文都在同目录的 *.sh 里，这里只替换 @NAME@ 占位符。
  render =
    template: values:
    lib.replaceStrings (map (name: "@${name}@") (lib.attrNames values)) (map (
      name: toString values.${name}
    ) (lib.attrNames values)) (builtins.readFile template);

  notificationsEnabled = cfg.notifications.topicSecret != null;
  notificationsFragment =
    if notificationsEnabled then
      pkgs.writeText "acb-notifications.toml" ''
        # Generated by nix-config for ACB out-of-band notifications.
        [notifications]
        url = "https://ntfy.sh"
        topic = "''${NTFY_ACB_TOPIC}"
        min_interval_secs = 600

        # 省略字段即使用默认值：window_secs=600、room_limit=3、max_entries=256。
        [notifications.in_band]
      ''
    else
      null;
  activeConfigFile = "${dataDir}/config/config.active.toml";

  # 手写的 config.toml 是唯一真源；启用通知时只在启动前把 [notifications]
  # 追加到派生文件，原文件不动。已有 [notifications] 时尊重手写版本。
  configMerge =
    if notificationsEnabled then
      pkgs.writeShellApplication {
        name = "acb-config-merge";
        runtimeInputs = [
          pkgs.coreutils
          pkgs.gnugrep
        ];
        text = render ./config-merge.sh {
          BASE = configFile;
          FRAGMENT = notificationsFragment;
          OUT = activeConfigFile;
        };
      }
    else
      null;
in
{
  options.modules.acb = {
    enable = lib.mkEnableOption "ACB（桥；dsh / drivers 等组件由 acbl 管理）";

    host = lib.mkOption {
      type = lib.types.str;
      description = "dsh / 桥接入点的监听地址（来自 services.acb 注册表）。";
    };

    exposeHost = lib.mkOption {
      type = lib.types.str;
      default = "127.0.0.1";
      description = "console / opencode 的对外监听地址；0.0.0.0 表示所有网卡（ZeroTier 等）。";
    };

    endpointPort = lib.mkOption {
      type = lib.types.port;
      description = "桥的 harness 接入端口。";
    };

    consolePort = lib.mkOption {
      type = lib.types.port;
      description = "桥的控制台端口。";
    };

    relayPort = lib.mkOption {
      type = lib.types.port;
      description = "文件中继端口。";
    };

    dataDir = lib.mkOption {
      type = lib.types.str;
      default = "${home}/.local/share/acb";
      description = "ACB 的配置、状态库、agent workspace 和 opencode 状态目录。";
    };

    logDir = lib.mkOption {
      type = lib.types.str;
      default = "${home}/.local/state/acb";
      description = "ACB 的日志目录。";
    };

    secretsFile = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      description = "EnvironmentFile（600），给配置里的 \${...} 占位符提供密钥；接 agenix 后指向 secret 路径。";
    };

    notifications = {
      topicSecret = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = ''
          ACB 带外通知（ntfy）的 topic 密钥文件，作为 acb-bridge 的 EnvironmentFile，
          内容形如 NTFY_ACB_TOPIC=<topic>。null 表示不启用：不生成
          [notifications] 块，也不注入额外环境。
        '';
      };
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages = [
      acblPkg
    ];

    system.activationScripts.acb-dirs = {
      deps = [ "users" ];
      text = ''
        dataDir=${lib.escapeShellArg dataDir}
        parent="$(dirname "$dataDir")"
        resolvedParent="$(readlink -e "$parent")"
        if [ "$resolvedParent" != "$parent" ]; then
          echo "acb-dirs: refusing symlinked parent $parent -> $resolvedParent" >&2
          exit 1
        fi
        if [ -L "$dataDir" ] || { [ -e "$dataDir" ] && [ ! -d "$dataDir" ]; }; then
          echo "acb-dirs: refusing non-directory or symlink $dataDir" >&2
          exit 1
        fi
        if [ ! -d "$dataDir" ]; then
          install -d -m 0700 -o ${myvars.username} -g users "$dataDir"
        fi
      '';
    };

    modules.managedLinks.links.acb-harnesses = lib.mkIf (sourceRoot != null) {
      sourceName = "agentChatBridge";
      subpath = "harnesses";
      adoptExistingSymlink = true;
      target = "${dataDir}/harnesses";
      after = [ "acb-dirs" ];
    };

    systemd.user.services = {
      "acb-bridge" = {
        # 用户级 unit 默认不随登录拉起；linger 已开，挂到 default.target
        # 就能开机自启（此前只能手工 `acbctl up all`）。
        wantedBy = [ "default.target" ];
        unitConfig = {
          # 单元名保留 acb-bridge（acbl 静态入口）；实际程序是 acb-launcher。
          Description = "ACB launcher (static acbl)";
          After = [ "network.target" ];
          StartLimitIntervalSec = 60;
          StartLimitBurst = 3;
        };
        serviceConfig = {
          # launcher 支持 sd_notify：READY=1 + watchdog 心跳。
          Type = "notify";
          NotifyAccess = "main";
          WatchdogSec = 120;
          WorkingDirectory = dataDir;
          Environment = [
            "PATH=${basePath}"
            # 适配器自有连接库的状态根：绝对路径，桥与所有组件同源继承，
            # 不依赖各进程 CWD（kernel 的连接注入按它解析）。
            "ACB_DATA_DIR=${dataDir}"
            "ACB_ENDPOINT_LISTEN=${cfg.host}:${toString cfg.endpointPort}"
            "ACB_CONSOLE_LISTEN=${cfg.exposeHost}:${toString cfg.consolePort}"
            "ACB_RELAY_LISTEN=0.0.0.0:${toString cfg.relayPort}"
            "ACB_LUA_DIR=${profileCurrent}/examples/lua"
            "ACB_PROFILE_DIR=${profileDir}"
            # profile seed 把它写进 current.json 的 args；没有它，launcher
            # 拉起 bridge 时不会带 --config。
            "ACB_UNIT_CONFIG_FILE=${if notificationsEnabled then activeConfigFile else configFile}"
            # 库内密钥（secrets 表）的解密钥。文件手工创建、0600；没它 bridge
            # 会在 preload 阶段以 78 退出，而且因为没有 LKG 会被判永久失败。
            # 2026-11-11 重启事故：这行原来只写在本机 drop-in 里，rebuild 清掉
            # drop-in 后整条桥起不来。
            "ACB_KEY_FILE=${dataDir}/secrets/acb.key"
            # 仓库根目录：组件模板里的路径是相对仓库的片段，渲染出的
            # supervisor.toml 落在 state/supervisor/ 而**不在仓库里**，
            # 相对路径按配置目录解析永远指不到仓库（2026-11-20：snowluma 的
            # compose 被解析成 state/supervisor/deploy/...，容器起不来）。
            # 没有 sourceRoot（纯 store 部署）时不注入，代码会退到 cwd。
          ]
          ++ lib.optionals (sourceRoot != null) [
            "ACB_REPO_DIR=${sourceRoot}"
          ];
          EnvironmentFile =
            lib.optional (cfg.secretsFile != null) "-${cfg.secretsFile}"
            ++ lib.optional notificationsEnabled cfg.notifications.topicSecret;
          ExecStartPre = [
            "${pkgs.coreutils}/bin/mkdir -p ${lib.escapeShellArg dataDir} ${lib.escapeShellArg logDir}"
          ]
          ++ lib.optional notificationsEnabled "${configMerge}/bin/acb-config-merge"
          ++ [
            # payload 来自 acb-payload（store 路径），用 store 策略建 generation。
            # seed 幂等：已有 generation 时直接跳过。
            "${acblPkg}/bin/acbctl profile seed ${profileBootstrap} --strategy store"
          ];
          # 稳定入口：不写 acblPkg 的具体 store 路径，升级 acbl 不改变这一行。
          # 不带 --config：launcher 自管 state/supervisor/supervisor.toml，
          # 组件表也从那里读。
          ExecStart = "/run/current-system/sw/bin/acb-launcher";
          Restart = "on-failure";
          RestartForceExitStatus = 75;
          RestartPreventExitStatus = 78;
          RestartSec = 1;
          # 停 acbl 不连带杀 bridge；bridge 由新 acbl 启动时 adopt。
          KillMode = "process";
          TimeoutStopSec = "45s";
          # $XDG_STATE_HOME/acb，systemd 在 spawn 前建好，避免日志目录被
          # impermanence 清空后 append: 以 209/STDOUT 失败。
          StateDirectory = "acb";
          StandardOutput = "append:${logDir}/bridge.log";
          StandardError = "append:${logDir}/bridge.log";
        };
      };
    };
  };
}
