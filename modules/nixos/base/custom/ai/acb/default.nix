{
  config,
  lib,
  pkgs,
  acb,
  llm-agents,
  myvars,
  ...
}:
# ACB（AgentChatBridge）：dsh-acb、桥、dsh 驱动、opencode serve。
#
# 模块开关、端口和会话列表都来自 vars/networking 的 services.acb 注册表；
# 四个单元是 systemd --user；acb-stack.target 默认不 enable，由用户显式
# `systemctl --user start acb-stack.target` 或 `acb stack` 启动。
# 数据在 ~/.local/share/acb；可写源码通过 modules.outOfStoreSymlink 的
# agentChatBridge 根接入；没配置时只跳过链接，不退回 flake store。
let
  cfg = config.modules.acb;

  home = config.users.users.${myvars.username}.home;
  dataDir = cfg.dataDir;
  configFile = "${dataDir}/config/config.toml";
  logDir = cfg.logDir;
  userProfileBin = "/etc/profiles/per-user/${myvars.username}/bin";
  basePath = "/run/current-system/sw/bin:${userProfileBin}:/run/wrappers/bin";

  acbSrc = acb.outPath;
  # 上游 acbctl 的 doctor 测试用 `#!/usr/bin/env bash` 起 systemctl shim，
  # Nix 构建沙箱里没有 /usr/bin/env，测试必然失败；部署构建跳过测试。
  acbPkg = acb.packages.${pkgs.system}.acb-bridge.overrideAttrs (_: {
    doCheck = false;
  });
  # 499ec94 的 acb-bridge 产物已经包含 bin/acbctl（workspace 同构建），
  # 不需要再单独建一份 acbctl。
  profileBootstrap = pkgs.runCommand "acb-profile-bootstrap" { } ''
    mkdir -p $out/bin $out/deploy $out/harnesses
    cp -a ${acbPkg}/bin/* $out/bin/
    cp -a ${acbSrc}/deploy/. $out/deploy/
    cp -a ${acbSrc}/harnesses/. $out/harnesses/
  '';
  opencode2 = "${llm-agents.packages.${pkgs.system}.opencode2}/bin/opencode2";
  dshBin = lib.getExe config.modules.dsh.runtimePackage;

  driver = "${acbSrc}/harnesses/dsh/src/driver.mjs";
  sourceRoot = config.modules.outOfStoreSymlink.paths.agentChatBridge or null;

  # 脚本正文都在同目录的 *.sh 里，这里只替换 @NAME@ 占位符。
  render =
    template: values:
    lib.replaceStrings (map (name: "@${name}@") (lib.attrNames values)) (map (
      name: toString values.${name}
    ) (lib.attrNames values)) (builtins.readFile template);

  notificationsEnabled = cfg.notifications.topicSecret != null;
  notificationsFragment =
    if notificationsEnabled then
      pkgs.writeText "acb-notifications.toml" ''
        # Generated by nix-config for ACB out-of-band notifications.
        [notifications]
        url = "https://ntfy.sh"
        topic = "''${NTFY_ACB_TOPIC}"
        min_interval_secs = 600

        # 省略字段即使用默认值：window_secs=600、room_limit=3、max_entries=256。
        [notifications.in_band]
      ''
    else
      null;
  activeConfigFile = "${dataDir}/config/config.active.toml";

  # 手写的 config.toml 是唯一真源；启用通知时只在启动前把 [notifications]
  # 追加到派生文件，原文件不动。已有 [notifications] 时尊重手写版本。
  configMerge =
    if notificationsEnabled then
      pkgs.writeShellApplication {
        name = "acb-config-merge";
        runtimeInputs = [
          pkgs.coreutils
          pkgs.gnugrep
        ];
        text = render ./config-merge.sh {
          BASE = configFile;
          FRAGMENT = notificationsFragment;
          OUT = activeConfigFile;
        };
      }
    else
      null;

  driverSessionBlocks = lib.concatMapStringsSep "\n" (
    item:
    render ./driver-session.sh {
      ID = item.id;
      PRESET = item.preset;
      PORT = item.port;
      ENDPOINT = "${cfg.host}:${toString cfg.endpointPort}";
      DSH_URL = "http://${cfg.host}:${toString cfg.dshPort}";
      DRIVER = driver;
    }
  ) cfg.sessions;

  driverScript = pkgs.writeShellApplication {
    name = "acb-drivers";
    runtimeInputs = [
      pkgs.coreutils
      pkgs.nodejs
      pkgs.gnugrep
      pkgs.gawk
    ];
    text = render ./drivers.sh {
      CONFIG = configFile;
      WORKSPACE = cfg.workspaceDir;
      TITLE = cfg.workspaceTitle;
      SESSIONS = driverSessionBlocks;
    };
  };

  acbUp = pkgs.writeShellApplication {
    name = "acb-up-internal";
    runtimeInputs = [
      pkgs.systemd
      pkgs.coreutils
      pkgs.iproute2
      pkgs.curl
      pkgs.gnugrep
    ];
    text = render ./up.sh {
      DSH_HOST = if cfg.host == "0.0.0.0" || cfg.host == "::" then "127.0.0.1" else cfg.host;
      DSH_PORT = cfg.dshPort;
      ENDPOINT_PORT = cfg.endpointPort;
      OPENCODE_HOST =
        if cfg.exposeHost == "0.0.0.0" || cfg.exposeHost == "::" then "127.0.0.1" else cfg.exposeHost;
      OPENCODE_PORT = cfg.opencodePort;
      STATUS = "${acbStatus}/bin/acb-status-internal";
    };
  };

  acbDown = pkgs.writeShellApplication {
    name = "acb-down-internal";
    runtimeInputs = [ pkgs.systemd ];
    text = builtins.readFile ./down.sh;
  };

  acbStatus = pkgs.writeShellApplication {
    name = "acb-status-internal";
    runtimeInputs = [
      pkgs.systemd
      pkgs.coreutils
      pkgs.iproute2
      pkgs.gnugrep
      pkgs.gawk
      pkgs.curl
    ];
    text = render ./status.sh {
      DATA = dataDir;
      LOG_DIR = logDir;
      CONFIG = configFile;
      DSH_HOST = if cfg.host == "0.0.0.0" || cfg.host == "::" then "127.0.0.1" else cfg.host;
      DSH_PORT = cfg.dshPort;
      ENDPOINT_PORT = cfg.endpointPort;
      CONSOLE_HOST =
        if cfg.exposeHost == "0.0.0.0" || cfg.exposeHost == "::" then "127.0.0.1" else cfg.exposeHost;
      CONSOLE_PORT = cfg.consolePort;
      OPENCODE_HOST =
        if cfg.exposeHost == "0.0.0.0" || cfg.exposeHost == "::" then "127.0.0.1" else cfg.exposeHost;
      OPENCODE_PORT = cfg.opencodePort;
      RELAY_PORT = cfg.relayPort;
      SNOWLUMA_PORT = cfg.snowlumaPort;
    };
  };

  acbLogs = pkgs.writeShellApplication {
    name = "acb-logs-internal";
    runtimeInputs = [ pkgs.coreutils ];
    text = render ./logs.sh { LOG_DIR = logDir; };
  };

  acbStack = pkgs.writeShellApplication {
    name = "acb-stack-internal";
    runtimeInputs = [
      pkgs.systemd
      pkgs.coreutils
      pkgs.iproute2
      pkgs.curl
      pkgs.gnugrep
    ];
    text = render ./stack.sh {
      DSH_HOST = if cfg.host == "0.0.0.0" || cfg.host == "::" then "127.0.0.1" else cfg.host;
      DSH_PORT = cfg.dshPort;
      ENDPOINT_PORT = cfg.endpointPort;
      OPENCODE_HOST =
        if cfg.exposeHost == "0.0.0.0" || cfg.exposeHost == "::" then "127.0.0.1" else cfg.exposeHost;
      OPENCODE_PORT = cfg.opencodePort;
      STATUS = "${acbStatus}/bin/acb-status-internal";
    };
  };

  acbCli = pkgs.writeShellApplication {
    name = "acb";
    runtimeInputs = [ pkgs.coreutils ];
    text = render ./acb.sh {
      UP = "${acbUp}/bin/acb-up-internal";
      DOWN = "${acbDown}/bin/acb-down-internal";
      STATUS = "${acbStatus}/bin/acb-status-internal";
      LOGS = "${acbLogs}/bin/acb-logs-internal";
      STACK = "${acbStack}/bin/acb-stack-internal";
    };
  };

  acbl = pkgs.writeShellApplication {
    name = "acbl";
    text = ''
      # If a future package provides `acb`, rename the dispatcher to `acbctl`; keep `acbl`.
      exec ${acbCli}/bin/acb stack "$@"
    '';
  };
in
{
  options.modules.acb = {
    enable = lib.mkEnableOption "ACB（桥 + 驱动；dsh 由用户管理）";

    autoStart = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "是否把 acb-stack.target 挂到 default.target；默认 false，由用户显式启动。";
    };

    host = lib.mkOption {
      type = lib.types.str;
      description = "dsh / 桥接入点的监听地址（来自 services.acb 注册表）。";
    };

    exposeHost = lib.mkOption {
      type = lib.types.str;
      default = "127.0.0.1";
      description = "console / opencode 的对外监听地址；0.0.0.0 表示所有网卡（ZeroTier 等）。";
    };

    dshPort = lib.mkOption {
      type = lib.types.port;
      description = "dsh-acb 的 Web UI 端口。";
    };

    endpointPort = lib.mkOption {
      type = lib.types.port;
      description = "桥的 harness 接入端口。";
    };

    consolePort = lib.mkOption {
      type = lib.types.port;
      description = "桥的控制台端口。";
    };

    opencodePort = lib.mkOption {
      type = lib.types.port;
      description = "ACB 专用 opencode serve 端口。";
    };

    relayPort = lib.mkOption {
      type = lib.types.port;
      description = "文件中继端口。";
    };

    snowlumaPort = lib.mkOption {
      type = lib.types.port;
      description = "snowluma 的 OneBot WS 端口；acb status 用它判断容器在不在。";
    };

    profile = lib.mkOption {
      type = lib.types.str;
      default = "nix-web-acb";
      description = "dsh 使用的 profile。";
    };

    dataDir = lib.mkOption {
      type = lib.types.str;
      default = "${home}/.local/share/acb";
      description = "ACB 的配置、状态库、agent workspace 和 opencode 状态目录。";
    };

    logDir = lib.mkOption {
      type = lib.types.str;
      default = "${home}/.local/state/acb";
      description = "ACB 的日志目录。";
    };

    workspaceDir = lib.mkOption {
      type = lib.types.str;
      default = "${dataDir}/agents";
      description = "dsh 会话的 cwd（Workspaces 分组）。";
    };

    workspaceTitle = lib.mkOption {
      type = lib.types.str;
      default = "ACB";
      description = "dsh Workspaces 里这个目录的显示标题。";
    };

    sessions = lib.mkOption {
      type = lib.types.listOf (
        lib.types.submodule {
          options = {
            id = lib.mkOption { type = lib.types.str; };
            preset = lib.mkOption { type = lib.types.str; };
            port = lib.mkOption { type = lib.types.port; };
          };
        }
      );
      default = [ ];
      description = "每个 ACB 会话一个 dsh 驱动：会话 id、preset 名、本地 MCP 端口。";
    };

    secretsFile = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      description = "EnvironmentFile（600），给配置里的 \${...} 占位符提供密钥；接 agenix 后指向 secret 路径。";
    };

    notifications = {
      topicSecret = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        description = ''
          ACB 带外通知（ntfy）的 topic 密钥文件，作为 acb-bridge 的 EnvironmentFile，
          内容形如 NTFY_ACB_TOPIC=<topic>。null 表示不启用：不生成
          [notifications] 块，也不注入额外环境。
        '';
      };
    };
  };

  config = lib.mkIf cfg.enable {
    environment.systemPackages = [
      acbPkg
      acbCli
      acbl
    ];

    systemd.user.services = {
      "dsh-acb" = {
        unitConfig = {
          Description = "ACB dsh (${cfg.profile})";
          After = [ "network.target" ];
          PartOf = [ "acb-stack.target" ];
        };
        serviceConfig = {
          Type = "simple";
          WorkingDirectory = home;
          Environment = [
            "PATH=${basePath}"
          ];
          EnvironmentFile = lib.optional (cfg.secretsFile != null) "-${cfg.secretsFile}";
          ExecStartPre = "${pkgs.coreutils}/bin/mkdir -p ${lib.escapeShellArg logDir}";
          ExecStart = "${pkgs.writeShellScript "acb-dsh-exec" ''
            set -e
            mkdir -p ${lib.escapeShellArg logDir}
            exec ${dshBin} --profile ${lib.escapeShellArg cfg.profile} --host ${lib.escapeShellArg cfg.host} --no-open --port ${toString cfg.dshPort}
          ''}";
          Restart = "always";
          RestartSec = 5;
          TimeoutStopSec = "15s";
          StandardOutput = "append:${logDir}/dsh.log";
          StandardError = "append:${logDir}/dsh.log";
        };
      };

      "acb-bridge" = {
        unitConfig = {
          Description = "ACB bridge";
          After = [ "network.target" ];
          PartOf = [ "acb-stack.target" ];
          StartLimitIntervalSec = 60;
          StartLimitBurst = 3;
        };
        serviceConfig = {
          Type = "simple";
          WorkingDirectory = dataDir;
          Environment = [
            "PATH=${basePath}"
            "ACB_ENDPOINT_LISTEN=${cfg.host}:${toString cfg.endpointPort}"
            "ACB_CONSOLE_LISTEN=${cfg.exposeHost}:${toString cfg.consolePort}"
            "ACB_RELAY_LISTEN=0.0.0.0:${toString cfg.relayPort}"
            "ACB_LUA_DIR=${dataDir}/lua"
          ];
          EnvironmentFile =
            lib.optional (cfg.secretsFile != null) "-${cfg.secretsFile}"
            ++ lib.optional notificationsEnabled cfg.notifications.topicSecret;
          ExecStartPre = [
            "${pkgs.coreutils}/bin/mkdir -p ${lib.escapeShellArg dataDir} ${lib.escapeShellArg logDir}"
          ]
          ++ lib.optionals (sourceRoot != null) [
            "${pkgs.coreutils}/bin/ln -sfnT ${lib.escapeShellArg "${sourceRoot}/harnesses"} ${lib.escapeShellArg "${dataDir}/harnesses"}"
            "${pkgs.coreutils}/bin/ln -sfnT ${lib.escapeShellArg "${sourceRoot}/examples/lua"} ${lib.escapeShellArg "${dataDir}/lua"}"
          ]
          ++ lib.optional notificationsEnabled "${configMerge}/bin/acb-config-merge"
          ++ [
            "${profileBootstrap}/bin/acbctl profile seed ${profileBootstrap}"
          ];
          ExecStart = "${acbPkg}/bin/acb-bridge --config ${
            lib.escapeShellArg (if notificationsEnabled then activeConfigFile else configFile)
          }";
          Restart = "on-failure";
          RestartForceExitStatus = 75;
          RestartPreventExitStatus = 78;
          RestartSec = 5;
          StandardOutput = "append:${logDir}/bridge.log";
          StandardError = "append:${logDir}/bridge.log";
        };
      };

      "acb-drivers" = {
        unitConfig = {
          Description = "ACB dsh drivers";
          After = [
            "network.target"
            "acb-bridge.service"
            "dsh-acb.service"
          ];
          Requires = [ "acb-bridge.service" ];
          Wants = [ "dsh-acb.service" ];
          PartOf = [
            "acb-bridge.service"
            "acb-stack.target"
          ];
        };
        serviceConfig = {
          Type = "simple";
          EnvironmentFile = lib.optional (cfg.secretsFile != null) "-${cfg.secretsFile}";
          ExecStartPre = "${pkgs.coreutils}/bin/mkdir -p ${lib.escapeShellArg logDir}";
          ExecStart = "${driverScript}/bin/acb-drivers";
          Restart = "always";
          RestartSec = 5;
          StandardOutput = "append:${logDir}/drivers.log";
          StandardError = "append:${logDir}/drivers.log";
        };
      };

      "acb-opencode-serve" = {
        unitConfig = {
          Description = "ACB opencode serve";
          After = [
            "network.target"
            "acb-bridge.service"
          ];
          Wants = [ "acb-bridge.service" ];
          PartOf = [ "acb-stack.target" ];
        };
        serviceConfig = {
          Type = "simple";
          Environment = [
            "PATH=${basePath}"
            "ACB_OPENCODE_DIR=${dataDir}/opencode"
            "ACB_OPENCODE_PORT=${toString cfg.opencodePort}"
            "ACB_OPENCODE_HOST=${cfg.exposeHost}"
            "ACB_OPENCODE_BIN=${opencode2}"
          ];
          EnvironmentFile = lib.optional (cfg.secretsFile != null) "-${cfg.secretsFile}";
          ExecStartPre = "${pkgs.coreutils}/bin/mkdir -p ${lib.escapeShellArg logDir}";
          ExecStart = "${pkgs.bash}/bin/bash ${acbSrc}/deploy/opencode-serve.sh";
          Restart = "always";
          RestartSec = 5;
          StandardOutput = "append:${logDir}/opencode.log";
          StandardError = "append:${logDir}/opencode.log";
        };
      };
    };

    systemd.user.units."acb-stack.target" = {
      text = ''
        [Unit]
        Description=ACB stack
        Wants=acb-bridge.service acb-drivers.service acb-opencode-serve.service dsh-acb.service
      '';
      wantedBy = lib.optional cfg.autoStart "default.target";
    };
  };
}
