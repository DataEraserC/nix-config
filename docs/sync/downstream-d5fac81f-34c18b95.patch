+      var runLen = runEnd - i + 1;
+      if (runLen >= 3) {
+        // Collapse the run into a single ranged entry.
+        var firstBind = startTok.bind;
+        var lastBind = tokens[runEnd].bind;
+        var lo = startTok.num;
+        var hi = tokens[runEnd].num;
+        var rangeStr = lo + "-" + hi;
