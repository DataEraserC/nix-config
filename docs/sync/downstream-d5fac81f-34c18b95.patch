@@ -55,6 +55,14 @@
       # openfpgaloader
     ];
 
+    # MediaTek MT7925 bluetooth lives on the same USB device (0489:e111) that
+    # gvfs/libmtp misdetects as an MTP player and resets, unbinding btusb.
+    # Clear the media-player tags so gvfsd-mtp ignores it.
