+                system:
+                "${
+                  self.fetchzip {
+                    url = urlBase + "packages/${file system}.tar";
+                    hash = hashes.${system};
+                    stripRoot = false;
+                  }
+                }/${file system}"
+              ) (builtins.attrNames hashes);
