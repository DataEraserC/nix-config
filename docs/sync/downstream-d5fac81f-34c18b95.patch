diff --git a/modules/nixos/base/custom/multi-instance/default.nix b/modules/nixos/base/custom/multi-instance/default.nix
new file mode 100644
index 00000000..03b5318a
--- /dev/null
+++ b/modules/nixos/base/custom/multi-instance/default.nix
@@ -0,0 +1,354 @@
+# ===============================================================================
+#
+# Multi-instance - run a program that hardcodes its state under $HOME as many
+# times as you like, each instance with its own state directory.
+#
+# A program's state paths are listed once, in `apps.<name>.paths`. Each instance
+# gets a directory under `stateRoot`, named by `stateDirectoryKey` (which defaults
+# to the app key), bind-mounted over every one of those paths with bubblewrap, so
+# no package is patched or wrapped. Each instance also gets a private /tmp,
+# because a program that derives a lock name from a state path
+# sees the same path in every instance. The instance store itself is replaced by
+# a tmpfs inside the sandbox, so one instance never sees the others.
+#
+# The sandbox remaps paths; it is not a confinement boundary. $HOME stays
+# writable at its real path, so absolute work-directory paths, git config and
+# build caches behave exactly as before. Only the listed state paths are
+# replaced.
+#
+# Canonical app keys map to the executable resolved by `command -v`, so an
+# entry also covers a binary the user installed themselves. `aliases` accepts
+# obsolete CLI names without duplicating the app or its persistent state.
+#
+# Usage
+#   multi-instance <app> <instance> [args...]
+#
+# An instance always starts empty: nothing is copied from the program's existing
+# state under $HOME, so a plain run keeps its own login untouched.
+# ===============================================================================
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.multi-instance;
+
+  isAppKey = value: builtins.match "[A-Za-z0-9][A-Za-z0-9._+-]*" value != null;
+  isStateDirectoryKey =
+    value: value != "." && value != ".." && builtins.match "[A-Za-z0-9][A-Za-z0-9._-]*" value != null;
+  resolvedExecutable = name: app: if app.executable == null then name else app.executable;
+  resolvedStateDirectoryKey =
+    name: app: if app.stateDirectoryKey == null then name else app.stateDirectoryKey;
+
+  appType = lib.types.submodule {
+    options = {
+      executable = lib.mkOption {
+        type = lib.types.nullOr lib.types.str;
+        default = null;
+        example = "codebuddy-acp";
+        description = ''
+          Executable resolved with `command -v`. Null uses the app key; set it
+          when the CLI key and actual executable differ.
+        '';
+      };
+
+      stateDirectoryKey = lib.mkOption {
+        type = lib.types.nullOr lib.types.str;
+        default = null;
+        example = "codebuddy";
+        description = ''
+          Directory name below `stateRoot`. Null uses the app key. Set it when a
+          renamed app must keep using its existing per-instance login state.
+        '';
+      };
+
+      paths = lib.mkOption {
+        type = lib.types.listOf lib.types.str;
+        description = ''
+          State paths the program hardcodes under $HOME and cannot be told to
+          move, e.g. ".config/Some App". One per element; each instance gets its
+          own copy of every one of them.
+        '';
+      };
+
+      userDataDir = lib.mkOption {
+        type = lib.types.nullOr lib.types.str;
+        default = null;
+        description = ''
+          One of `paths`: the program's user data directory, for programs whose
+          single-instance lock is named after it. Chromium and Electron derive
+          the lock socket from that path, which every instance sees unchanged, so
+          a second instance hands its window to the first. Set this and the
+          directory is mounted a second time under a per-instance path passed as
+          `--user-data-dir`, so the lock name differs while the data does not.
+        '';
+      };
+
+      persist = lib.mkOption {
+        type = lib.types.listOf lib.types.unspecified;
+        default = [ ];
+        description = ''
+          Subset of `paths` to carry across a tmpfs root, in the shape
+          `preservation.preserveAt.<store>.users.<user>.directories` accepts: a
+          path, or an attrset with `directory` and `mode`. Empty means the paths
+          are not preserved.
+        '';
+      };
+
+      desktop = lib.mkOption {
+        type = lib.types.nullOr (
+          lib.types.submodule {
+            options = {
+              label = lib.mkOption {
+                type = lib.types.str;
+                description = "Name shown in the launcher and as the app's generic name.";
+              };
+              icon = lib.mkOption {
+                type = lib.types.str;
+                description = "Icon name, usually the one the package's own .desktop file uses.";
+              };
+              wmclass = lib.mkOption {
+                type = lib.types.str;
+                description = "Startup window class, so the window is recognised as this app.";
+              };
+            };
+          }
+        );
+        default = null;
+        description = ''
+          Set to `{ label; icon; wmclass; }` to give every instance a launcher
+          entry. Programs without it are CLI-only and get none.
+        '';
+      };
+    };
+  };
+
+  # The spec is the only thing the launcher reads at runtime: each line starts
+  # with the accepted CLI key, executable and stable state-directory key,
+  # followed by the canonical app's state paths and an @-prefixed user data
+  # directory when it has one. Aliases expand to the same canonical app data;
+  # they never create a second app, launcher or persistence declaration.
+  # Keeping it a file, not shell arguments, means a path with a space (`Trae CN`)
+  # never goes through desktop-entry quoting.
+  specLine =
+    cliName: canonicalName: app:
+    lib.concatStringsSep "|" (
+      [
+        cliName
+        (resolvedExecutable canonicalName app)
+        (resolvedStateDirectoryKey canonicalName app)
+      ]
+      ++ app.paths
+      ++ lib.optional (app.userDataDir != null) "@${app.userDataDir}"
+    );
+  canonicalSpecLines = lib.mapAttrsToList (name: specLine name name) cfg.apps;
+  aliasSpecLines = lib.concatLists (
+    lib.mapAttrsToList (
+      alias: canonical:
+      lib.optional (cfg.apps ? ${canonical}) (specLine alias canonical cfg.apps.${canonical})
+    ) cfg.aliases
+  );
+  spec = pkgs.writeText "multi-instance.spec" (
+    lib.concatStringsSep "\n" (canonicalSpecLines ++ aliasSpecLines) + "\n"
+  );
+
+  # The only parameters nix passes to the script: the spec it reads and the store
+  # its instances live in. bubblewrap and coreutils are the only tools it runs.
+  multi-instance = pkgs.writeShellApplication {
+    name = "multi-instance";
+    runtimeInputs = [
+      pkgs.bubblewrap
+      pkgs.coreutils
+    ];
+    text = ''
+      export MULTI_INSTANCE_SPEC=${spec}
+      export MULTI_INSTANCE_ROOT="$HOME/${cfg.stateRoot}"
+    ''
+    + builtins.readFile ./multi-instance.sh;
+  };
+
+  # A number means that many instances, named "1".."N"; a list names them
+  # explicitly, for instances that are not just numbered.
+  instanceNames = value: if builtins.isInt value then map toString (lib.range 1 value) else value;
+
+  mkLauncher =
+    name: instance:
+    let
+      meta = cfg.apps.${name}.desktop;
+    in
+    pkgs.makeDesktopItem {
+      name = "multi-instance-${name}-${instance}";
+      desktopName = "${meta.label} ${instance}";
+      genericName = meta.label;
+      comment = "${meta.label}, instance ${instance}, with its own state directory";
+      icon = meta.icon;
+      exec = "${multi-instance}/bin/multi-instance ${name} ${instance} %F";
+      categories = [ "Development" ];
+      startupWMClass = meta.wmclass;
+      startupNotify = true;
+    };
+
+  launchers = lib.concatLists (
+    lib.mapAttrsToList (name: value: map (mkLauncher name) (instanceNames value)) cfg.instances
+  );
+
+  # Every path the programs redirect, plus the store they redirect into. The same
+  # path can be listed by two programs (`CodeBuddyExtension` holds auth shared by
+  # codebuddy-acp and workbuddy), and duplicate mount units are an error.
+  preserveDirectories = lib.unique (
+    [
+      {
+        directory = cfg.stateRoot;
+        mode = "0700";
+      }
+    ]
+    ++ lib.concatLists (map (app: app.persist) (lib.attrValues cfg.apps))
+  );
+in
+{
+  options.modules.multi-instance = {
+    enable = lib.mkEnableOption ''
+      the `multi-instance` launcher, which runs each program in `apps` under
+      bubblewrap with one state directory per instance
+    '';
+
+    stateRoot = lib.mkOption {
+      type = lib.types.str;
+      default = ".local/state/multi-instance";
+      description = ''
+        Store for per-instance state, relative to $HOME. Each instance uses
+        `<stateRoot>/<stateDirectoryKey>/<instance>`; a null
+        `stateDirectoryKey` uses the app key. Owner-only: instances hold
+        credentials and history.
+      '';
+    };
+
+    apps = lib.mkOption {
+      type = lib.types.attrsOf appType;
+      default = { };
+      description = ''
+        Canonical programs that can be run as several instances. `executable`
+        controls what `command -v` resolves; obsolete CLI names belong in
+        `aliases`. Declaring a program here also exposes its state paths in
+        `preserveDirectories`.
+      '';
+    };
+
+    aliases = lib.mkOption {
+      type = lib.types.attrsOf lib.types.str;
+      default = { };
+      example = {
+        old-name = "new-name";
+      };
+      description = ''
+        Compatibility names accepted by the `multi-instance` CLI, mapping each
+        alias to a canonical key in `apps`. Aliases reuse the canonical
+        executable, state key and paths; they do not create another app,
+        desktop launcher or preservation declaration.
+      '';
+    };
+
+    specFile = lib.mkOption {
+      type = lib.types.path;
+      readOnly = true;
+      description = "Generated runtime specification consumed by the multi-instance launcher.";
+    };
+
+    preserveDirectories = lib.mkOption {
+      type = lib.types.listOf lib.types.unspecified;
+      readOnly = true;
+      description = ''
+        Preservation entries for the instance store and every `apps.*.persist`
+        path, in the shape
+        `preservation.preserveAt.<store>.users.<user>.directories` accepts. The
+        facts live here, next to the paths themselves; the host decides which
+        preservation store to put them in, because a host without the
+        preservation module has no such option to declare.
+      '';
+    };
+
+    instances = lib.mkOption {
+      type = lib.types.attrsOf (
+        lib.types.oneOf [
+          lib.types.ints.positive
+          (lib.types.listOf lib.types.str)
+        ]
+      );
+      default = { };
+      description = ''
+        Instances to create a desktop launcher for, keyed by program. A number
+        means that many instances, named "1".."N"; a list names them explicitly.
+        Only programs with `desktop` metadata are accepted.
+      '';
+    };
+  };
+
+  config = lib.mkMerge [
+    {
+      assertions = [
+        {
+          assertion = lib.all (name: cfg.apps ? ${name} && cfg.apps.${name}.desktop != null) (
+            lib.attrNames cfg.instances
+          );
+          message = "modules.multi-instance.instances: only a program in `apps` with `desktop` metadata can have a launcher";
+        }
+        {
+          assertion = lib.all isAppKey (lib.attrNames cfg.apps);
+          message = "modules.multi-instance.apps: app keys must be non-empty command basenames";
+        }
+        {
+          assertion = lib.all isAppKey (lib.attrNames cfg.aliases);
+          message = "modules.multi-instance.aliases: alias keys must be non-empty command basenames";
+        }
+        {
+          assertion = lib.intersectLists (lib.attrNames cfg.apps) (lib.attrNames cfg.aliases) == [ ];
+          message = "modules.multi-instance.aliases: aliases must not replace canonical `apps` keys";
+        }
+        {
+          assertion = lib.all (canonical: cfg.apps ? ${canonical}) (lib.attrValues cfg.aliases);
+          message = "modules.multi-instance.aliases: every target must name a canonical entry in `apps`";
+        }
+        {
+          assertion = lib.all (name: isAppKey (resolvedExecutable name cfg.apps.${name})) (
+            lib.attrNames cfg.apps
+          );
+          message = "modules.multi-instance.apps: `executable` must be one non-empty command basename";
+        }
+        {
+          assertion = lib.all (name: isStateDirectoryKey (resolvedStateDirectoryKey name cfg.apps.${name})) (
+            lib.attrNames cfg.apps
+          );
+          message = "modules.multi-instance.apps: `stateDirectoryKey` must be one non-empty safe directory name";
+        }
+        {
+          assertion = lib.all (app: lib.all (path: !lib.hasPrefix "/" path) app.paths) (
+            lib.attrValues cfg.apps
+          );
+          message = "modules.multi-instance.apps: `paths` are relative to $HOME, so they cannot start with /";
+        }
+        {
+          assertion = lib.all (app: app.userDataDir == null || lib.elem app.userDataDir app.paths) (
+            lib.attrValues cfg.apps
+          );
+          message = "modules.multi-instance.apps: `userDataDir` must also be one of `paths`, so the instance has a directory to mount it from";
+        }
+      ];
+    }
+
+    (lib.mkIf cfg.enable {
+      environment.systemPackages = [ multi-instance ] ++ launchers;
+    })
+
+    # Exposed whether or not the launcher is enabled: the paths are facts about
+    # the programs, and their existing logins must survive a host that stops
+    # enabling this module.
+    {
+      modules.multi-instance = {
+        preserveDirectories = if cfg.apps == { } then [ ] else preserveDirectories;
+        specFile = spec;
+      };
+    }
+  ];
+}
diff --git a/modules/nixos/base/custom/multi-instance/multi-instance.sh b/modules/nixos/base/custom/multi-instance/multi-instance.sh
new file mode 100644
index 00000000..89264b5e
--- /dev/null
+++ b/modules/nixos/base/custom/multi-instance/multi-instance.sh
@@ -0,0 +1,175 @@
+#!/usr/bin/env bash
+# Run one program under bubblewrap with a per-instance state directory.
+#
+# This file holds no program-specific data. Nix supplies the two inputs it
+# needs from modules.multi-instance:
+#   MULTI_INSTANCE_SPEC  one "cli-key|executable|state-key|path|path..." line
+#                        per canonical app or compatibility alias, with state
+#                        paths relative to $HOME
+#   MULTI_INSTANCE_ROOT  instance store, one directory per
+#                        <state-key>/<instance>
+# bubblewrap and coreutils are on PATH via the wrapper's runtimeInputs.
+#
+# Each path on the line is a location the program hardcodes under $HOME with no
+# switch to move it, so the instance's directory is bind-mounted over each one.
+# Mounting redirects all of them without patching or wrapping the program.
+#
+# One field may be prefixed with @: the program's user data directory, for
+# programs whose single-instance lock is named after it. Chromium derives the
+# lock socket "<sha256 of that path>-<version>-main.sock" from the string, and
+# every instance sees the same string, so a second instance finds the first
+# instance's socket, hands its command line over and exits, and the window that
+# appears belongs to the first instance. That directory is mounted a second time
+# under a per-instance path and passed as --user-data-dir, so the name differs
+# while the data does not.
+#
+# /tmp is a fresh tmpfs per instance, not the host's: a program that derives a
+# lock or socket name from a state path gets the same name in every instance —
+# the path is redirected, not rewritten — so on a shared /tmp the second instance
+# finds the first instance's lock and refuses to start. The X11 and X session
+# manager sockets belong to the desktop session and are mounted back in.
+#
+# Usage
+#   multi-instance <app> <instance> [args...]
+set -euo pipefail
+
+spec=${MULTI_INSTANCE_SPEC:?MULTI_INSTANCE_SPEC must point at the generated spec}
+
+# Only the first field: the program names, one per line, in file order.
+list_apps() {
+  while IFS='|' read -r name _; do
+    echo "  $name"
+  done <"$spec"
+}
+
+usage() {
+  cat <<'EOF'
+usage: multi-instance <app> <instance> [args...]
+
+apps:
+EOF
+  list_apps
+  cat <<'EOF'
+
+Each instance keeps its state in $MULTI_INSTANCE_ROOT/<state-key>/<instance>; the
+state key usually matches the app but may stay stable across an executable rename.
+The directory you start the command in stays available at its real path.
+EOF
+}
+
+case "${1:-}" in
+  -h | --help | "")
+    usage
+    exit 2
+    ;;
+esac
+
+app=$1
+if [ $# -lt 2 ]; then
+  echo "multi-instance: missing <instance> for $app" >&2
+  exit 2
+fi
+instance=$2
+shift 2
+
+line=
+while IFS= read -r candidate; do
+  case $candidate in
+    "$app|"*)
+      line=$candidate
+      break
+      ;;
+  esac
+done <"$spec"
+
+if [ -z "$line" ]; then
+  echo "multi-instance: unknown app: $app" >&2
+  echo "multi-instance: known apps:" >&2
+  list_apps >&2
+  exit 2
+fi
+
+IFS='|' read -r -a fields <<<"$line"
+executable=${fields[1]}
+state_key=${fields[2]}
+data=
+paths=()
+for field in "${fields[@]:3}"; do
+  case $field in
+    @*) data=${field#@} ;;
+    *) paths+=("$field") ;;
+  esac
+done
+
+bin=$(command -v "$executable" || true)
+if [ -z "$bin" ]; then
+  echo "multi-instance: $executable (app $app) is not installed on this host" >&2
+  exit 127
+fi
+
+root=${MULTI_INSTANCE_ROOT:-$HOME/.local/state/multi-instance}
+dir=$root/$state_key/$instance
+mkdir -p "$dir"
+
+mounts=()
+for rel in "${paths[@]}"; do
+  # Owner-only: some programs (Raccoon Work) refuse a profile directory that
+  # grants group/other any access, and every directory here holds credentials.
+  install -d -m 700 "$dir/$rel"
+  mounts+=(--bind "$dir/$rel" "$HOME/$rel")
+done
+
+# The same directory under a per-instance path, for the user data directory
+# whose name the program's single-instance lock is derived from; see the header.
+# It is created inside the tmpfs below, so it exists nowhere on the host.
+data_mounts=()
+data_args=()
+if [ -n "$data" ]; then
+  data_mounts=(--dir "$dir/data" --bind "$dir/$data" "$dir/data")
+  data_args=(--user-data-dir="$dir/data")
+fi
+
+runtime=()
+if [ -d "/run/user/$(id -u)" ]; then
+  runtime=(--bind "/run/user/$(id -u)" "/run/user/$(id -u)")
+fi
+
+# /tmp starts empty in the sandbox; see the header. A socket directory the
+# desktop session owns is mounted back so the program can still reach its display.
+tmp=(--tmpfs /tmp)
+for sock in /tmp/.X11-unix /tmp/.ICE-unix; do
+  if [ -d "$sock" ]; then
+    tmp+=(--bind "$sock" "$sock")
+  fi
+done
+
+# A bind of a parent directory hides every mount made under it, so $PWD is bound
+# only when it is outside $HOME: started from $HOME (a plain shell, or a desktop
+# entry, which both run in $HOME), binding it again after the instance mounts
+# would cover every one of them and the program would open the real profile.
+cwd=()
+case $PWD/ in
+  "$HOME"/*) ;;
+  *) cwd=(--bind "$PWD" "$PWD") ;;
+esac
+
+# No --unshare-pid: Electron names its single-instance lock "<host>-<pid>", and
+# inside a PID namespace that pid is always 2, which the next launch reads as a
+# live instance (pid 2 is kthreadd on the host) and exits as if another window
+# owned the instance.
+exec bwrap \
+  --die-with-parent \
+  --unshare-uts --unshare-ipc --unshare-user-try \
+  --ro-bind / / \
+  --proc /proc \
+  --dev-bind /dev /dev \
+  --bind "$HOME" "$HOME" \
+  "${tmp[@]}" \
+  "${cwd[@]}" \
+  "${mounts[@]}" \
+  --tmpfs "$root" \
+  "${data_mounts[@]}" \
+  --chdir "$PWD" \
+  --setenv MULTI_INSTANCE "$app/$instance" \
+  "${runtime[@]}" \
+  -- "$bin" "${data_args[@]}" "$@"
diff --git a/modules/nixos/base/custom/network/clash-verge.nix b/modules/nixos/base/custom/network/clash-verge.nix
new file mode 100644
index 00000000..5034abe8
--- /dev/null
+++ b/modules/nixos/base/custom/network/clash-verge.nix
@@ -0,0 +1,126 @@
+# ===============================================================================
+#
+# Clash Verge Rev - the GUI mihomo client, wrapped as a self-contained module
+# around nixpkgs' `programs.clash-verge` (package comes from nixpkgs-master,
+# which carries a much newer clash-verge-rev than the locked nixpkgs).
+#
+# Service mode is on by default (mihomo runs as a root systemd service instead
+# of a user process), autoStart and TUN mode stay off - this host reaches the
+# network through dae/gost instead, and clash-verge is started on demand.
+# Currently only enabled on idols-ai.
+#
+# NOTE: There is a known pitfall with mihomo's fake-IP for IPv6
+# (fake-ip-range6: fdfe:dcba:9876::/64): TCP connections to IPv6 fake-IPs are
+# not proxied correctly and simply hang until connect() times out.
+# Clients without a fast IPv4 fallback stall for ~2 minutes per attempt:
+# every git remote operation (fetch/pull/push alike, they all go through ssh)
+# hangs on "Connecting to ssh.github.com [fdfe:dcba:9876::x] port 443"
+# before falling back to IPv4.
+# Browsers recover silently thanks to Happy Eyeballs (RFC 8305: when a name
+# resolves to both IPv4 and IPv6, the client tries one stack first, then races
+# the other after a ~50ms delay and keeps whichever connects first).
+# Fix: disable IPv6 in Clash Verge's DNS/TUN settings (confirmed working);
+# or work around per-client, e.g. `AddressFamily inet` in ssh_config
+# (see home/base/tui/ssh.nix).
+#
+# NOTE: GNOME top-bar tray menu stall (diagnosed on clash-verge-rev 2.5.2 +
+# GNOME Shell 50.4 + appindicator extension v64): clicking the tray icon at
+# the right of the clock opened an EMPTY menu that stalled for several
+# seconds before the buttons appeared; it happened even without restarting
+# clash, and only a restart of clash made the first click slow again.
+# Root cause: clash-verge-rev embeds the whole subscription node list once
+# per proxy group into its dbusmenu tray menu (~3686 items = 18 groups x
+# ~204 nodes for a mid-size subscription) and re-assigns a fresh id space on
+# every menu rebuild; the appindicator extension defers LayoutUpdated
+# signals received while the menu is closed (dbusMenu.js `_onSignal`), then
+# performs the full 3686-item destroy+rebuild synchronously on the next
+# click: measured ~413ms main-thread slice unpacking the layout + 1.7MB
+# GetGroupProperties reply + thousands of St widgets created in a single
+# PRIORITY_LOW idle => 5-6s shell freeze, menu visible empty until widgets
+# and labels land. Re-opens stay fast until clash rebuilds its menu again
+# (restart, subscription/config change, or any tray action such as
+# "open window").
+# Workaround (landed 2026-10-04, lives in clash-verge's own runtime config,
+# NOT managed by this module): Clash Verge GUI -> Settings -> Layout
+# Settings -> "Proxy Groups Display Mode" -> Disable, i.e.
+# `tray_proxy_groups_display_mode: disable` in verge.yaml. The tray menu
+# shrinks to ~14 items and the stall disappears.
+# Upstream issues (bodies verified 2026-10-04):
+#   * clash-verge-rev PR #5946 (merged, milestone 2.4.5/2.5.0) - added the
+#     disable switch; author measured ~30s whole-desktop freeze on tray open
+#     with 42 groups x 316 items and states the menu update cannot be made
+#     fast: https://github.com/clash-verge-rev/clash-verge-rev/pull/5946
+#   * clash-verge-rev issue #7779 - large subscription freezes GNOME Shell
+#     through ubuntu-appindicators dbusMenu.js (GC/destroy storm, stacks
+#     match the same destroy path); same tray_proxy_groups_display_mode
+#     workaround: https://github.com/clash-verge-rev/clash-verge-rev/issues/7779
+#   * clash-verge-rev issue #8076 - Ubuntu 24.04: tray click does not fully
+#     expand the menu and the next click stalls; upstream contributor
+#     suggests disabling tray proxy groups:
+#     https://github.com/clash-verge-rev/clash-verge-rev/issues/8076
+#   * No issue on ubuntu/gnome-shell-extension-appindicator matches this
+#     deferred-LayoutUpdated click stall exactly (searched 2026-10-04);
+#     closest relatives: #548 introduced the defer-while-closed branch that
+#     causes it, #616 reports a dbusMenu.js GC callback storm with the same
+#     stacks as clash-verge-rev #7779.
+# ===============================================================================
+{
+  config,
+  lib,
+  pkgs-master,
+  ...
+}:
+let
+  cfg = config.modules.clash-verge;
+in
+{
+  options.modules.clash-verge = {
+    enable = lib.mkEnableOption "the Clash Verge Rev GUI client (mihomo with a web dashboard), via nixpkgs' programs.clash-verge";
+
+    package = lib.mkOption {
+      type = lib.types.package;
+      # clash-verge-rev moves fast (subscription/rule fixes land as minor
+      # releases); the locked nixpkgs lags months behind, so take master.
+      default = pkgs-master.clash-verge-rev;
+      description = "Clash Verge package to install; defaults to nixpkgs-master's clash-verge-rev for a current build.";
+    };
+
+    autoStart = lib.mkOption {
+      type = lib.types.bool;
+      default = false;
+      description = "Launch Clash Verge automatically at desktop login (user systemd autostart unit).";
+    };
+
+    serviceMode = lib.mkOption {
+      type = lib.types.bool;
+      default = true;
+      description = ''
+        Run the mihomo core as a root systemd service (clash-verge's
+        "Service Mode") instead of a child of the GUI process; requires the
+        GUI to be started as the same user the service is delegated to.
+      '';
+    };
+
+    tunMode = lib.mkOption {
+      type = lib.types.bool;
+      default = false;
+      description = ''
+        Enable TUN mode (a tun device with setuid wrapper plus relaxed
+        checkReversePath). Off by default: the system-wide transparent proxy
+        on this host is dae, and two TUN stacks would fight over routes.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    programs.clash-verge = {
+      enable = true;
+      inherit (cfg)
+        package
+        autoStart
+        serviceMode
+        tunMode
+        ;
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/network/dae.nix b/modules/nixos/base/custom/network/dae.nix
new file mode 100644
index 00000000..3c109932
--- /dev/null
+++ b/modules/nixos/base/custom/network/dae.nix
@@ -0,0 +1,157 @@
+# dae - eBPF/tproxy transparent proxy, packaged as one self-contained module.
+#
+# The host supplies its own dae config files via `installFiles` (each entry is at
+# least <source, target>, optionally with mode/owner/group); this module owns the
+# rest: the daeuniverse NixOS modules, the dae service and the activation script
+# that installs the files under /etc/dae. Currently only enabled on idols-ai.
+{
+  config,
+  lib,
+  pkgs,
+  daeuniverse,
+  nur-DataEraserC,
+  ...
+}:
+let
+  cfg = config.modules.dae;
+
+  # Parse a single-unit duration ("30min" / "2h" / "1day") into whole minutes.
+  # Only forced when autoReload is enabled (the timer attrs are lazy mkIfs).
+  autoReloadMinutes =
+    let
+      m = builtins.match "([0-9]+)(min|h|hr|day)" cfg.autoReload.interval;
+    in
+    if m == null then
+      throw ''modules.dae.autoReload.interval: "${cfg.autoReload.interval}" is not a supported duration; use one unit, e.g. "30min", "2h" or "1day"''
+    else
+      let
+        count = builtins.fromJSON (builtins.elemAt m 0);
+        unit = builtins.elemAt m 1;
+      in
+      count
+      * (
+        if unit == "min" then
+          1
+        else if unit == "h" || unit == "hr" then
+          60
+        else
+          1440
+      );
+in
+{
+  imports = [
+    daeuniverse.nixosModules.dae
+    daeuniverse.nixosModules.daed
+  ];
+
+  options.modules.dae = {
+    enable = lib.mkEnableOption "the dae transparent proxy, along with installFiles and the activation script";
+
+    configFile = lib.mkOption {
+      type = lib.types.str;
+      default = "/etc/dae/config.dae";
+      description = "Main dae config path passed to services.dae.configFile; normally also one of installFiles' targets.";
+    };
+
+    assetsPath = lib.mkOption {
+      type = lib.types.either lib.types.path lib.types.str;
+      default = "${nur-DataEraserC.packages.${pkgs.system}.v2ray-rules-dat}/share/v2ray-rules-dat";
+      description = "Directory holding geoip.dat / geosite.dat (DAE_LOCATION_ASSET); defaults to nur-DataEraserC's v2ray-rules-dat share directory.";
+    };
+
+    installFiles = lib.mkOption {
+      type = lib.types.listOf (
+        lib.types.submodule {
+          options = {
+            source = lib.mkOption {
+              type = lib.types.either lib.types.path lib.types.str;
+              description = "Source file: a repo path (copied into the store) or an absolute runtime path such as an agenix secret.";
+            };
+            target = lib.mkOption {
+              type = lib.types.str;
+              description = "Absolute destination path, e.g. /etc/dae/config.dae.";
+            };
+            mode = lib.mkOption {
+              type = lib.types.str;
+              default = "0600";
+              description = "File mode passed to install -m; dae refuses group-writable or world-readable configs.";
+            };
+            owner = lib.mkOption {
+              type = lib.types.str;
+              default = "root";
+              description = "File owner passed to install -o.";
+            };
+            group = lib.mkOption {
+              type = lib.types.str;
+              default = "root";
+              description = "File group passed to install -g.";
+            };
+          };
+        }
+      );
+      default = [ ];
+      description = "Files installed into the dae config tree at activation: entries are <source, target> pairs extended with mode/owner/group as needed.";
+    };
+
+    autoReload = {
+      enable = lib.mkEnableOption ''
+        a periodic `systemctl reload dae`; dae only fetches subscriptions at
+        startup and on reload, so a timer keeps the node pool following
+        refreshed subscriptions without a manual reload or rebuild
+      '';
+
+      interval = lib.mkOption {
+        type = lib.types.str;
+        default = "60min";
+        example = "2h";
+        description = ''
+          Time between reloads as a duration with a single unit: minutes
+          (`30min`), hours (`2h`) or days (`1day`); seconds are not supported.
+          The value feeds the timer's OnBootSec/OnUnitActiveSec directly.
+        '';
+      };
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    services.dae = {
+      enable = true;
+      configFile = cfg.configFile;
+      # tproxy only serves locally injected transparent traffic, so keep 12345
+      # closed on the firewall; tproxy_port_protect already blocks direct hits.
+      openFirewall.enable = false;
+      assetsPath = cfg.assetsPath;
+    };
+
+    # daed shares dae's tproxy port - only one of them may run, pin daed off here.
+    services.daed.enable = false;
+
+    # Install the host-provided config files at activation; mode defaults to
+    # 0600 root:root so dae's permission check keeps passing.
+    system.activationScripts.installDaeConfig = lib.concatMapStringsSep "\n" (file: ''
+      install -D -m ${file.mode} -o ${file.owner} -g ${file.group} ${file.source} ${file.target}
+    '') cfg.installFiles;
+
+    # Periodic reload (autoReload): each run skips while dae is stopped, and
+    # dae's own reload guard keeps a run that resolves 0 nodes harmless.
+    systemd.services.dae-auto-reload = lib.mkIf cfg.autoReload.enable {
+      description = "Periodically reload dae to re-fetch subscriptions";
+      serviceConfig.Type = "oneshot";
+      script = ''
+        if ! ${pkgs.systemd}/bin/systemctl is-active --quiet dae; then
+          echo "dae is not active, skipping reload" >&2
+          exit 0
+        fi
+        exec ${pkgs.systemd}/bin/systemctl reload dae
+      '';
+    };
+
+    systemd.timers.dae-auto-reload = lib.mkIf cfg.autoReload.enable {
+      wantedBy = [ "timers.target" ];
+      timerConfig = {
+        OnBootSec = "${toString autoReloadMinutes}min";
+        OnUnitActiveSec = "${toString autoReloadMinutes}min";
+      };
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/network/default.nix b/modules/nixos/base/custom/network/default.nix
