+      bindsFoundInFile++;
+      var action = currentBindAction.trim().replace(/;$/, "").trim();
+
+      var hotkeyTitle = null;
+      var titleMatch = currentBindAttributes.match(/hotkey-overlay-title="([^"]+)"/);
+      if (titleMatch) hotkeyTitle = titleMatch[1];
