+      defaultPort = 22;
+      # keyed by hostsAddr key (that is how the ssh_config fold looks rows up):
+      # the work laptop runs sshd on 8022 instead of the stock 22, and
+      # `wsl-work` aliases `work` (same machine), so it reuses that row instead
