+  # ==========================================================================
+  services = {
+    # --- sshd; the per-host listen ports live here, not on hostsAddr ---
+    ssh = {
+      # no `enable` on purpose: modules/nixos/base/ssh.nix turns sshd on for
+      # every NixOS machine (base-wide), so the rows below carry host/port
+      # only
