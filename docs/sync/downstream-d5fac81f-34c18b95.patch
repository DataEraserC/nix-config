diff --git a/modules/nixos/base/custom/ai/lobsterai.nix b/modules/nixos/base/custom/ai/lobsterai.nix
new file mode 100644
index 00000000..a7449962
--- /dev/null
+++ b/modules/nixos/base/custom/ai/lobsterai.nix
@@ -0,0 +1,37 @@
+# ===============================================================================
+#
+# LobsterAI - NetEase Youdao's open-source desktop-grade AI agent.
+#
+# The derivation lives in nur-DataEraserC (pkgs/uncategorized-DataEraserC/
+# lobsterai-wrapper, which wraps lobsterai-unwrapped) but has no update script,
+# so its version tag is bumped by hand; this file only wires it up.
+# nur-DataEraserC exports no nixosModule for it, so the enable option below is
+# the only switch (there is no upstream module to import).
+#
+# State lives in ~/.config/LobsterAI (Electron userData: lobsterai.sqlite with
+# sessions, SKILLs, dsh/ and openclaw/ runtimes, logs) and ~/lobsterai/project
+# (default working directory, created at startup). On a tmpfs root,
+# modules.agent-accounts preserves both.
+#
+# Check
+#   command -v lobsterai   # GUI app, there is no --version CLI
+# ===============================================================================
+{
+  config,
+  lib,
+  pkgs,
+  nur-DataEraserC,
+  ...
+}:
+let
+  cfg = config.modules.lobsterai;
+in
+{
+  options.modules.lobsterai.enable = lib.mkEnableOption "LobsterAI, NetEase Youdao's desktop-grade AI agent";
+
+  config = lib.mkIf cfg.enable {
+    environment.systemPackages = [
+      nur-DataEraserC.packages.${pkgs.stdenv.hostPlatform.system}.lobsterai-wrapper
+    ];
+  };
+}
diff --git a/modules/nixos/base/custom/ai/m365-copilot2api.nix b/modules/nixos/base/custom/ai/m365-copilot2api.nix
new file mode 100644
index 00000000..6ef3f597
--- /dev/null
+++ b/modules/nixos/base/custom/ai/m365-copilot2api.nix
@@ -0,0 +1,75 @@
+# ===============================================================================
+#
+# M365 Copilot2API - Microsoft 365 Copilot to OpenAI/Anthropic compatible API gateway.
+#
+# This wrapper uses the DataEraserC NUR module, which provides
+# `services.dataEraserc.m365Copilot2api`.
+#
+# Binds to 0.0.0.0:1104; reach the web console at http://<host-ip>:1104/
+# (set listenAddress = "127.0.0.1" to keep it loopback-only). The console is
+# plain HTTP, so keep a TLS reverse proxy in front when exposing it.
+#
+# The adminPasswordFile secret seeds the console password on first start and
+# again whenever its content changes; a password changed in the web console
+# stays in effect until then.
+#
+# The masterKeyFile secret encrypts the refresh tokens in accounts.json (and
+# enables the Microsoft Graph admin connection). Changing or removing it makes
+# the already-stored tokens unreadable, so the accounts have to be authorized
+# again.
+#
+# forceIpv4 pins outbound connections to IPv4. Intermittent IPv6 failures on the
+# Microsoft endpoints surface as WS_READ_TIMEOUT transport errors, which put
+# every account into cooldown and make the 2api gateway answer 503 "all accounts
+# cooling down" until a restart clears the in-memory cooldowns (CopilotChat stays
+# healthy because it does not share that state); see upstream issue #79.
+#
+# Check Service Status
+#   systemctl status m365-copilot2api
+# Check logs
+#   journalctl -u m365-copilot2api --since "2 minutes ago"
+# Read the admin password
+#   sudo cat /run/agenix/m365-copilot2api-admin-password
+{
+  config,
+  lib,
+  pkgs,
+  nur-DataEraserC,
+  ...
+}:
+let
+  cfg = config.modules.m365-copilot2api;
+  system = pkgs.stdenv.hostPlatform.system;
+
+  # Auto-updates from nur-DataEraserC flow straight through here. The former
+  # dev-branch override (HEXUXIU/M365-Copilot2API#93: withheld stream tails,
+  # mid-rune snapshot splits, leaked citation markers) was dropped once the
+  # upstream release carried those fixes — the maintainer closed #93 against
+  # v0.7.0 (2026-09-27) and v0.7.1 added the stream/UTF-8 regression tests.
+  # The override pinned only version + src while inheriting the base
+  # vendorHash, so it broke as soon as an auto-update moved that hash.
+  m365Copilot2api = nur-DataEraserC.packages.${system}.m365-copilot2api;
+in
+{
+  imports = [ nur-DataEraserC.nixosModules.m365-copilot2api ];
+
+  options.modules.m365-copilot2api = {
+    enable = lib.mkEnableOption "M365 Copilot2API gateway";
+    port = lib.mkOption {
+      type = lib.types.port;
+      description = "Port m365-copilot2api listens on; the host that uses this module must set it (port registry myvars.networking.services.m365-copilot2api.hosts.<machine>.port).";
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    services.dataEraserc.m365Copilot2api = {
+      enable = true;
+      package = m365Copilot2api;
+      listenAddress = "0.0.0.0";
+      port = cfg.port;
+      adminPasswordFile = "/run/agenix/m365-copilot2api-admin-password";
+      masterKeyFile = "/run/agenix/m365-copilot2api-master-key";
+      forceIpv4 = true;
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/ai/meoo2api.nix b/modules/nixos/base/custom/ai/meoo2api.nix
new file mode 100644
index 00000000..10bc9619
--- /dev/null
+++ b/modules/nixos/base/custom/ai/meoo2api.nix
@@ -0,0 +1,59 @@
+# ===============================================================================
+#
+# meoo2api - Meoo model gateway to OpenAI compatible API, with an account
+# management console on the same port.
+#
+# This wrapper uses the DataEraserC NUR module, which provides
+# `services.dataEraserc.meoo2api`.
+#
+# Binds to 0.0.0.0:1110; the OpenAI compatible API lives under /v1 and the
+# console is served at /. The host firewall only trusts the VPN overlays
+# (tailscale/zerotier/easytier), so the console is not exposed to the LAN; the
+# API and console are plain HTTP, so keep a TLS reverse proxy in front when
+# reaching them from an untrusted network.
+#
+# Without adminPasswordFile the server generates a random administrator
+# password on first start and prints it once to the journal; read it with
+#   sudo journalctl -u meoo2api | grep '管理端初始密码'
+# Accounts are added through the console (browser device authorization), so
+# state.json in /var/lib/meoo2api holds the accounts, project keys, client API
+# keys, usage log and settings.
+#
+# Check Service Status
+#   systemctl status meoo2api
+# Check logs
+#   journalctl -u meoo2api --since "2 minutes ago"
+# Probe the gateway
+#   curl http://127.0.0.1:1110/healthz
+{
+  config,
+  lib,
+  pkgs,
+  nur-DataEraserC,
+  ...
+}:
+let
+  cfg = config.modules.meoo2api;
+  system = pkgs.stdenv.hostPlatform.system;
+in
+{
+  imports = [ nur-DataEraserC.nixosModules.meoo2api ];
+
+  options.modules.meoo2api = {
+    enable = lib.mkEnableOption "meoo2api gateway";
+    port = lib.mkOption {
+      type = lib.types.port;
+      description = "Port meoo2api listens on for both the API and the console; the host that uses this module must set it (port registry myvars.networking.services.meoo2api.hosts.<machine>.port).";
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    services.dataEraserc.meoo2api = {
+      enable = true;
+      package = nur-DataEraserC.packages.${system}.meoo2api;
+      host = "0.0.0.0";
+      port = cfg.port;
+      openFirewall = false;
+    };
+  };
+}
