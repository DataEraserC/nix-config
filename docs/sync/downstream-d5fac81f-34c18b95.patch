+        ''
+          ${vmware-unpack-env}/bin/vmware-unpack-env -c "sh ${vself.src} ${vmware-tools} --extract unpacked"
+
+          ${lib.optionalString enableMacOSGuests ''
+            mkdir -p fusion/
