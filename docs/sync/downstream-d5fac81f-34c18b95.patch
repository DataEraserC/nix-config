+# ===============================================================================
+#
+# omniroute - OmniRoute unified LLM gateway (OpenAI/Anthropic-compatible
+# aggregator with dashboard and MITM proxy).
+#
+# This wrapper uses the DataEraserC NUR module, which provides
+# `services.dataEraserc.omniroute`.
+#
+# Binds 0.0.0.0:1106 like the sibling gateways; idols-ai keeps openFirewall
+# off (see hosts/idols-ai firewall note), so exposure follows the LAN posture
+# only. REQUIRE_API_KEY=true satisfies the upstream non-loopback API key
+# guard for the 0.0.0.0 bind (upstream Docker image does the same).
+#
+# Fresh install: the management bootstrap token is printed to the journal on
+# first start (journalctl -u omniroute); with INITIAL_PASSWORD unset the
+# dashboard falls back to CHANGEME - change it after first login (upstream
+# docs 12.5). Mutable state lives in /var/lib/omniroute (DATA_DIR:
+# storage.sqlite, generated server.env secrets, logs).
+#
+# The unit is Type=notify: upstream sends READY/WATCHDOG through
+# systemd-notify after the socket listens, with WatchdogSec=120s covering
+# the upstream 60s ping period.
+#
+# Check Service Status
+#   systemctl status omniroute
+# Check logs / bootstrap token
+#   journalctl -fu omniroute
+#   sudo journalctl -u omniroute | grep -i token
+{
+  config,
+  lib,
+  pkgs,
+  nur-DataEraserC,
+  ...
+}:
+let
+  cfg = config.modules.omniroute;
+  system = pkgs.stdenv.hostPlatform.system;
+in
+{
+  imports = [ nur-DataEraserC.nixosModules.omniroute ];
+
+  options.modules.omniroute = {
+    enable = lib.mkEnableOption "OmniRoute unified LLM gateway";
+    port = lib.mkOption {
+      type = lib.types.port;
+      description = "Port omniroute listens on; the host that uses this module must set it (port registry myvars.networking.services.omniroute.hosts.<machine>.port).";
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    services.dataEraserc.omniroute = {
+      enable = true;
+      package = nur-DataEraserC.packages.${system}.omniroute;
+      host = "0.0.0.0";
+      port = cfg.port;
+      extraEnvironment.REQUIRE_API_KEY = "true";
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/ai/open-webui.nix b/modules/nixos/base/custom/ai/open-webui.nix
new file mode 100644
index 00000000..93913e54
--- /dev/null
+++ b/modules/nixos/base/custom/ai/open-webui.nix
@@ -0,0 +1,67 @@
+# ===============================================================================
+#
+# open-webui - self-hosted web UI for LLMs (ChatGPT-style chat), fronting ollama
+# and the OpenAI-compatible gateways on the same host (new-api 1100,
+# opencode2api 1101/1102, mimocode2api 1103, m365-copilot2api 1104,
+# cliproxyapi 1105, omniroute 1106, agent2api 1108).
+#
+# Uniform wrapper shared by every host, same pattern as new-api.nix: hosts only
+# toggle `modules.open-webui.enable` and set `modules.open-webui.port` (taken
+# from the port registry, myvars.networking.services.open-webui.hosts.<machine>.port),
+# while the remaining service settings (package, bind address) live here so the
+# hosts stay byte-identical. The port is only read under `enable`, so a host that
+# does not run the unit never forces it.
+#
+# Binds to 0.0.0.0 and takes its listen port from the port registry (1120 on
+# every host today - the slot after the 1100-1108 gateway block; this module
+# itself has no default port). Currently disabled on every host
+# (modules.open-webui.enable = false); wsl-work runs no copy at all and reaches
+# idols-ai through the `openwebui` port-forward tunnel (local 31120 -> remote
+# 1120, both derived from the registry row), kept for a future re-enable.
+#
+# Mutable state lives in /var/lib/open-webui (the NixOS module default); the
+# legacy ~/.config/open-webui entry kept in preservation.nix only preserves
+# pre-migration data.
+#
+# Check Service Status
+#   systemctl status open-webui
+# Check logs
+#   journalctl -u open-webui --since "2 minutes ago"
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.open-webui;
+in
+{
+  options.modules.open-webui = {
+    enable = lib.mkEnableOption "Open WebUI chat frontend for the local LLM gateways";
+    port = lib.mkOption {
+      type = lib.types.port;
+      description = "Port open-webui listens on; the host that uses this module must set it (port registry myvars.networking.services.open-webui.hosts.<machine>.port).";
+    };
+  };
+
+  # Package and bind address apply on every host so the binding is identical
+  # whether or not the unit runs here; enable and port (set by the host from
+  # the port registry) are gated by enable, since cfg.port has no default.
+  config = lib.mkMerge [
+    {
+      services.open-webui = {
+        # mkDefault: one uniform package choice (primary nixpkgs) that a host can
+        # still override plainly via services.open-webui.package if needed.
+        package = lib.mkDefault pkgs.open-webui;
+        host = "0.0.0.0";
+      };
+    }
+    (lib.mkIf cfg.enable {
+      services.open-webui = {
+        enable = true;
+        port = cfg.port;
+      };
+    })
+  ];
+}
