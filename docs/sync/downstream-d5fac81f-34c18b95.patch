diff --git a/modules/nixos/wsl/wsl_import.nix b/modules/nixos/wsl/wsl_import.nix
new file mode 100644
index 00000000..ea3c2398
--- /dev/null
+++ b/modules/nixos/wsl/wsl_import.nix
@@ -0,0 +1,66 @@
+{
+  lib,
+  myvars,
+  ...
+}:
+{
+  imports = [
+    ../server/server.nix
+    ../desktop/fonts.nix
+    ../desktop/fhs.nix
+    ../desktop/appcast.nix
+    ../base/i18n.nix
+    ../base/user-group.nix
+    ../base/custom
+    ./apparmor-workaround.nix
+
+    # ./vscode-remote-workaround.nix
+  ];
+
+  # WSL has no wireless hardware, disable wpa_supplicant
+  networking.wireless.enable = lib.mkForce false;
+
+  # The WSL Home Manager profile imports gui/base/gtk.nix, whose activation
+  # writes GTK settings through dconf. Without the system dconf D-Bus service
+  # (normally pulled in by desktop modules WSL does not import), HM activation
+  # fails at dconfSettings with "The name is not activatable".
+  programs.dconf.enable = true;
+
+  # Service accounts required by agenix secrets (cpolar.yml).
+  # alist is superseded by the unconditional account in ../base/custom/services/alist.nix
+  # (this stub declared group = "nogroup", which conflicts with it).
+  users.users.cpolar = {
+    isSystemUser = true;
+    group = "cpolar";
+  };
+  users.groups.cpolar = { };
+
+  users.users.cliproxyapi = {
+    isSystemUser = true;
+    group = "cliproxyapi";
+  };
+  users.groups.cliproxyapi = { };
+
+  users.users.m365-copilot2api = {
+    isSystemUser = true;
+    group = "m365-copilot2api";
+  };
+  users.groups.m365-copilot2api = { };
+
+  users.users.opencode2api = {
+    isSystemUser = true;
+    group = "opencode2api";
+  };
+  users.groups.opencode2api = { };
+
+  # The OpenSSH agent remembers private keys for you
+  # so that you don’t have to type in passphrases every time you make an SSH connection.
+  # Use `ssh-add` to add a key to the agent.
+  programs.ssh.startAgent = true;
+
+  # WSL launches the default shell directly without a PAM login, so systemd-logind
+  # never registers a session for the default user and `user@.service` never starts
+  # (`/run/user/$UID` missing => `systemctl --user` fails, ssh-agent won't run).
+  # Enable lingering so the user manager starts at boot regardless of sessions.
+  users.users.${myvars.username}.linger = true;
+}
