+          port = 22;
+        };
+        wsl-y9000p2025 = {
+          host = "0.0.0.0";
+          port = 22;
+        };
+        work = {
+          host = "0.0.0.0";
+          port = 8022;
+        };
+        wsl-work = work;
+      };
+    };
+
+    # --- authenticated SOCKS5 + HTTP proxy (modules/nixos/base/custom/network/gost-proxy.nix)
