diff --git a/devshells/development.nix b/devshells/development.nix
new file mode 100644
index 00000000..64416052
--- /dev/null
+++ b/devshells/development.nix
@@ -0,0 +1,32 @@
+{
+  self,
+  forAllSystems,
+  nixpkgs,
+  ...
+}@inputs:
+forAllSystems (
+  system:
+  let
+    pkgs = nixpkgs.legacyPackages.${system};
+  in
+  {
+    development = pkgs.mkShell {
+      packages = with pkgs; [
+        # fix https://discourse.nixos.org/t/non-interactive-bash-errors-from-flake-nix-mkshell/33310
+        bashInteractive
+        # fix `cc` replaced by clang, which causes nvim-treesitter compilation error
+        gcc
+        # Nix-related
+        nixfmt
+        deadnix
+        statix
+        # spell checker
+        typos
+        # code formatter
+        prettier
+      ];
+      name = "dots";
+      inherit (self.checks.${system}.pre-commit-check) shellHook;
+    };
+  }
+)
