diff --git a/modules/nixos/base/custom/ai/browser4.nix b/modules/nixos/base/custom/ai/browser4.nix
new file mode 100644
index 00000000..d55d7a44
--- /dev/null
+++ b/modules/nixos/base/custom/ai/browser4.nix
@@ -0,0 +1,49 @@
+# ===============================================================================
+#
+# Browser4 - MCP-driven browser automation: Rust CLI (browser4-cli) driving a
+# prebuilt Java/Spring backend bundle via HTTP MCP on 127.0.0.1:8182.
+#
+# This wrapper uses the DataEraserC NUR module, which provides
+# `programs.dataEraserc.browser4`. It only puts the CLI on PATH (the packaged
+# wrapper supplies the store runtime, creates the log directory and warns on
+# a BROWSER4_RUNTIME_DIR override) and wires an optional browser path.
+#
+# The backend is deliberately NOT a systemd service; `browser4-cli` has no
+# start/serve subcommand and re-spawns the backend on demand. Under the dsh
+# harness, run long-lived backend work in a harness background job instead —
+# recipe in pkgs/uncategorized/browser4/AGENTS.md of the nur-packages repo.
+#
+# Set browserPath to the Chrome/Chromium binary to drive on NixOS (nothing on
+# PATH matches by default); it is exported as BROWSER4_BROWSER_PATH.
+{
+  config,
+  lib,
+  pkgs,
+  nur-DataEraserC,
+  ...
+}:
+let
+  cfg = config.modules.browser4;
+  system = pkgs.stdenv.hostPlatform.system;
+in
+{
+  imports = [ nur-DataEraserC.nixosModules.browser4 ];
+
+  options.modules.browser4 = {
+    enable = lib.mkEnableOption "browser4 browser automation CLI";
+
+    browserPath = lib.mkOption {
+      type = lib.types.nullOr lib.types.str;
+      default = null;
+      description = "Path to the Chrome/Chromium binary browser4 drives, exported as BROWSER4_BROWSER_PATH; null leaves it unset.";
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    programs.dataEraserc.browser4 = {
+      enable = true;
+      package = nur-DataEraserC.packages.${system}.browser4;
+      inherit (cfg) browserPath;
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/ai/cliproxyapi.nix b/modules/nixos/base/custom/ai/cliproxyapi.nix
new file mode 100644
index 00000000..c9a56263
--- /dev/null
+++ b/modules/nixos/base/custom/ai/cliproxyapi.nix
@@ -0,0 +1,56 @@
+# ===============================================================================
+#
+# CLIProxyAPI - proxy that exposes Gemini/Claude/Codex/Grok as OpenAI-compatible APIs.
+#
+# This wrapper uses the DataEraserC NUR module, which provides
+# `services.dataEraserc.cliproxyapi` and adds:
+#   - an offline management panel from `cliproxyapi-management-center-bin`, the
+#     prebuilt upstream release asset (no npm build, no GitHub download at runtime)
+#   - a management key managed by agenix (`/run/agenix/cliproxyapi-management.key`)
+#   - `mutableConfig = true` so panel/API edits survive restarts
+#
+# Binds to 0.0.0.0:1105; reach the panel at http://<host-ip>:1105/management.html
+# (access restricted by firewall). Every management API request needs the
+# management key, so `allowRemote` only lifts the loopback-only check that would
+# otherwise answer 403 to a browser connecting from another host.
+#
+# Check Service Status
+#   systemctl status cliproxyapi
+# Check logs
+#   journalctl -u cliproxyapi --since "2 minutes ago"
+# Read the management key
+#   sudo cat /run/agenix/cliproxyapi-management.key
+{
+  config,
+  lib,
+  pkgs,
+  nur-DataEraserC,
+  ...
+}:
+let
+  cfg = config.modules.cliproxyapi;
+  system = pkgs.stdenv.hostPlatform.system;
+in
+{
+  imports = [ nur-DataEraserC.nixosModules.cliproxyapi ];
+
+  options.modules.cliproxyapi = {
+    enable = lib.mkEnableOption "CLIProxyAPI proxy with an offline management panel";
+    port = lib.mkOption {
+      type = lib.types.port;
+      description = "Port cliproxyapi listens on; the host that uses this module must set it (port registry myvars.networking.services.cliproxyapi.hosts.<machine>.port).";
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    services.dataEraserc.cliproxyapi = {
+      enable = true;
+      package = nur-DataEraserC.packages.${system}.cliproxyapi;
+      managementCenterPackage = nur-DataEraserC.packages.${system}.cliproxyapi-management-center-bin;
+      host = "0.0.0.0";
+      port = cfg.port;
+      allowRemote = true;
+      managementKeyFile = "/run/agenix/cliproxyapi-management.key";
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/ai/codearts.nix b/modules/nixos/base/custom/ai/codearts.nix
new file mode 100644
index 00000000..90810326
--- /dev/null
+++ b/modules/nixos/base/custom/ai/codearts.nix
@@ -0,0 +1,34 @@
+# ===============================================================================
+#
+# CodeArts - Huawei Cloud's terminal coding agent (unfree vendor binary).
+#
+# The derivation lives in nur-DataEraserC (pkgs/uncategorized-DataEraserC/
+# codearts) together with its update script; this file only wires it up.
+#
+# State lives in ~/.codeartsdoer (settings, opencode.db, permission storage,
+# generative-ui); on a tmpfs root, modules.agent-accounts preserves it.
+# ~/.codebase-cli is deliberately left out - it is a
+# self-updating CLI cache the tool re-downloads on demand.
+#
+# Check
+#   codearts --version
+# ===============================================================================
+{
+  config,
+  lib,
+  pkgs,
+  nur-DataEraserC,
+  ...
+}:
+let
+  cfg = config.modules.codearts;
+in
+{
+  options.modules.codearts.enable = lib.mkEnableOption "CodeArts, Huawei Cloud's terminal coding agent";
+
+  config = lib.mkIf cfg.enable {
+    environment.systemPackages = [
+      nur-DataEraserC.packages.${pkgs.stdenv.hostPlatform.system}.codearts
+    ];
+  };
+}
diff --git a/modules/nixos/base/custom/ai/codebuddy-acp.nix b/modules/nixos/base/custom/ai/codebuddy-acp.nix
new file mode 100644
index 00000000..74fe15fa
--- /dev/null
+++ b/modules/nixos/base/custom/ai/codebuddy-acp.nix
@@ -0,0 +1,53 @@
+# ===============================================================================
+#
+# CodeBuddy ACP - ACP proxy for Tencent's terminal AI coding assistant.
+#
+# The derivation lives in nur-DataEraserC (pkgs/uncategorized-DataEraserC/
+# codebuddy-acp). It installs only the `codebuddy-acp` command and transparently
+# execs the vendor CLI for non-stdio-ACP invocations; the vendor `codebuddy` /
+# `cbc` commands are not exposed by this module.
+#
+# The proxy keeps the vendor's state layout: ~/.codebuddy contains sessions,
+# plugins, credentials and history, while ~/.local/share/CodeBuddyExtension
+# holds auth shared with WorkBuddy. On a tmpfs root, modules.agent-accounts
+# preserves both.
+#
+# Check
+#   codebuddy-acp --version
+# ===============================================================================
+{
+  config,
+  lib,
+  pkgs,
+  nur-DataEraserC,
+  ...
+}:
+let
+  cfg = config.modules.codebuddy-acp;
+in
+{
+  options.modules.codebuddy-acp = {
+    enable = lib.mkEnableOption "the CodeBuddy ACP proxy for Tencent's terminal AI coding assistant";
+
+    package = lib.mkOption {
+      type = lib.types.nullOr lib.types.package;
+      default = nur-DataEraserC.legacyPackages.${pkgs.stdenv.hostPlatform.system}.codebuddy-acp or null;
+      description = ''
+        Package providing the `codebuddy-acp` executable. Defaults to the ACP
+        proxy from the DataEraserC NUR; a host may override it to pin a
+        different build.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    environment.systemPackages = lib.optional (cfg.package != null) cfg.package;
+
+    assertions = [
+      {
+        assertion = cfg.package != null;
+        message = "modules.codebuddy-acp.package must be set when the module is enabled (the DataEraserC NUR is not providing `codebuddy-acp`).";
+      }
+    ];
+  };
+}
