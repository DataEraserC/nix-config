+  .controls {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .service-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .reason,
+  .hint {
+    padding-left: 0;
+  }
+}
diff --git a/modules/nixos/base/custom/system/auto-shutdown/auto-shutdown-check.sh b/modules/nixos/base/custom/system/auto-shutdown/auto-shutdown-check.sh
new file mode 100644
index 00000000..7c7dc29b
--- /dev/null
+++ b/modules/nixos/base/custom/system/auto-shutdown/auto-shutdown-check.sh
@@ -0,0 +1,160 @@
+#!/usr/bin/env bash
+# ===============================================================================
+#
+# auto-shutdown-check: power off when the machine stays in a shutdown-worthy
+# state for too long.
+#
+# On every tick the *conditions* are run to decide whether to keep the machine
+# on. Each condition is an executable path; exit 0 means "this check is OK":
+#   MODE=all -> every condition must pass to keep the machine on
+#   MODE=any -> at least one passing condition keeps it on
+# Once the machine stays shutdown-worthy for GRACE_SECONDS, we power off.
+#
+# Effective settings resolution (highest priority last):
+#   1. nix-declared defaults, injected via systemd `environment`:
+#        CONDITIONS       space separated list of condition executables
+#        CONDITION_NAMES  space separated labels matching CONDITIONS(for logs)
+#        MODE             how the conditions are combined: all|any
+#        GRACE_SECONDS    duration(seconds) in the shutdown-worthy state
+#                         after which we power off
+#        VERBOSE          1 logs every condition result + verdict each tick
+#   2. runtime override file(if present):
+#        AUTO_SHUTDOWN_ENABLED           0 disables, 1 enables(default)
+#        AUTO_SHUTDOWN_GRACE_SECONDS     overrides GRACE_SECONDS
+#
+# Logs go to the journal(`journalctl -u auto-shutdown`). State transitions and
+# the final power-off are always logged; per-condition results only when
+# VERBOSE=1.
+#
+# The override file lives under /run(tmpfs), so any runtime tweak made with the
+# `auto-shutdown` command is temporary and reverts to the nix defaults after a
+# reboot. It is re-read on every timer tick; no rebuild/service restart is
+# needed to apply a change(it takes effect on the next tick at the latest).
+#
+# State: /run/auto-shutdown/failing-since (epoch seconds of the first failed
+# probe). /run is wiped on reboot, so a reboot always restarts the grace period.
+#
+# Exit codes are intentionally 0 for every handled branch: failing conditions,
+# a short shutdown-worthy window, or an override that disables the check is not
+# a unit failure. Real failures surface as non-zero from the tools used here.
+# ===============================================================================
+
+set -euo pipefail
+
+STATE_DIR=/run/auto-shutdown
+STATE_FILE="$STATE_DIR/failing-since"
+OVERRIDE_FILE="$STATE_DIR/override.env"
+
+# --- defaults from nix ------------------------------------------------------
+GRACE_SECONDS="${GRACE_SECONDS:-1800}"
+VERBOSE="${VERBOSE:-0}"
+ENABLED=1
+
+# verbose-only logging helper(state transitions/poweroff use plain echo below)
+log() {
+  if [ "$VERBOSE" = "1" ]; then
+    echo "auto-shutdown: $*"
+  fi
+}
+
+# --- load runtime override (temporary, reboot-reset) ------------------------
+if [ -r "$OVERRIDE_FILE" ]; then
+  # shellcheck disable=SC1090
+  while IFS='=' read -r _key _val; do
+    case "$_key" in
+      AUTO_SHUTDOWN_ENABLED) [ "$_val" = "1" ] && ENABLED=1 || ENABLED=0 ;;
+      AUTO_SHUTDOWN_GRACE_SECONDS)
+        if [ "$_val" -ge 0 ] 2>/dev/null; then
+          GRACE_SECONDS="$_val"
+        else
+          echo "ignoring invalid AUTO_SHUTDOWN_GRACE_SECONDS=$_val in $OVERRIDE_FILE" >&2
+        fi
+        ;;
+    esac
+  done < "$OVERRIDE_FILE"
+fi
+
+# --- disabled via runtime override: disarm & do nothing ---------------------
+if [ "$ENABLED" -ne 1 ]; then
+  rm -f "$STATE_FILE"
+  echo "auto-shutdown disabled by runtime override, skipping"
+  exit 0
+fi
+
+# shellcheck disable=SC2310
+is_ok() {
+  # no conditions configured -> always OK, never power off
+  if [ -z "${CONDITIONS:-}" ]; then
+    log "no conditions configured -> OK (never powers off)"
+    return 0
+  fi
+
+  local mode="${MODE:-all}"
+  local -a conds names
+  read -r -a conds <<<"$CONDITIONS"
+  read -r -a names <<<"${CONDITION_NAMES:-}"
+
+  # run every condition so the log shows all results, not just until the first
+  # short-circuit; the number of checks is small and runs at most once per tick.
+  local total="${#conds[@]}"
+  local passed=0 i cond name
+  for i in "${!conds[@]}"; do
+    cond="${conds[$i]}"
+    name="${names[$i]:-$cond}"
+    if "$cond" >/dev/null 2>&1; then
+      passed=$((passed + 1))
+      log "[ok]   $name"
+    else
+      log "[fail] $name"
+    fi
+  done
+
+  if [ "$mode" = "any" ]; then
+    if [ "$passed" -gt 0 ]; then
+      log "verdict: OK (${passed}/${total} passed, mode=any)"
+      return 0
+    fi
+    log "verdict: shutdown-worthy (${passed}/${total} passed, mode=any)"
+    return 1
+  fi
+
+  if [ "$passed" -eq "$total" ]; then
+    log "verdict: OK (${passed}/${total} passed, mode=all)"
+    return 0
+  fi
+  log "verdict: shutdown-worthy (${passed}/${total} passed, mode=all)"
+  return 1
+}
+
+now() {
+  date +%s
+}
+
+mkdir -p "$STATE_DIR"
+
+if is_ok; then
+  # conditions OK again (or nothing configured): cancel any pending poweroff
+  if [ -f "$STATE_FILE" ]; then
+    echo "auto-shutdown: conditions OK again after $(( $(now) - $(cat "$STATE_FILE") ))s, cancelling countdown"
+  fi
+  rm -f "$STATE_FILE"
+  exit 0
+fi
+
+# in a shutdown-worthy state right now
+if [ ! -f "$STATE_FILE" ]; then
+  # start counting from now
+  now >"$STATE_FILE"
+  echo "auto-shutdown: shutdown-worthy, starting ${GRACE_SECONDS}s countdown"
+  exit 0
+fi
+
+failing_since=$(cat "$STATE_FILE")
+elapsed=$(( $(now) - failing_since ))
+
+if [ "$elapsed" -ge "$GRACE_SECONDS" ]; then
+  echo "auto-shutdown: shutdown-worthy for ${elapsed}s >= ${GRACE_SECONDS}s, powering off"
+  systemctl poweroff
+else
+  echo "auto-shutdown: still shutdown-worthy for ${elapsed}s (power off after ${GRACE_SECONDS}s)"
+fi
diff --git a/modules/nixos/base/custom/system/auto-shutdown/auto-shutdown-cli.sh b/modules/nixos/base/custom/system/auto-shutdown/auto-shutdown-cli.sh
new file mode 100644
index 00000000..d5eccead
--- /dev/null
+++ b/modules/nixos/base/custom/system/auto-shutdown/auto-shutdown-cli.sh
@@ -0,0 +1,148 @@
+#!/usr/bin/env bash
+# ===============================================================================
+#
+# auto-shutdown: temporarily tweak the auto-power-off behavior WITHOUT a nix
+# rebuild. Writes /run/auto-shutdown/override.env, which the
+# auto-shutdown.service re-reads on every tick. Because the file lives under
+# /run(tmpfs), every change is reset to the nix-declared defaults on reboot.
+#
+# Usage:
+#   auto-shutdown status                      show current override & state
+#   auto-shutdown enable                      re-enable (undo a disable)
+#   auto-shutdown disable                     disable until the next reboot
+#   auto-shutdown grace <span>                e.g. 45min / 2h / 3600 (seconds)
+#   auto-shutdown reset                       drop the override file entirely
+#
+# Examples:
+#   sudo auto-shutdown disable                # tonight, don't auto power off
+#   sudo auto-shutdown grace 1h               # power off only after 1h offline
+# ===============================================================================
+
+set -euo pipefail
+
+STATE_DIR=/run/auto-shutdown
+OVERRIDE_FILE="$STATE_DIR/override.env"
+STATE_FILE="$STATE_DIR/failing-since"
+
+span_to_seconds() {
+  local span="$1"
+  local num mul
+  case "$span" in
+    *min) num="${span%min}" mul=60 ;;
+    *m) num="${span%m}" mul=60 ;;
+    *h) num="${span%h}" mul=3600 ;;
+    *d) num="${span%d}" mul=86400 ;;
+    *s) num="${span%s}" mul=1 ;;
+    *)
+      if [[ "$span" =~ ^[0-9]+$ ]]; then
+        echo "$span"
+        return 0
+      fi
+      echo "invalid span: $span (expected e.g. 45min / 2h / 1d / 90s / 3600)" >&2
+      return 1
+      ;;
+  esac
+  echo "$((num * mul))"
+}
+
+read_override() {
+  _enabled=1
+  _grace=""
+  if [ -f "$OVERRIDE_FILE" ]; then
+    # shellcheck disable=SC1090
+    while IFS='=' read -r _key _val; do
+      case "$_key" in
+        AUTO_SHUTDOWN_ENABLED) _enabled="$_val" ;;
+        AUTO_SHUTDOWN_GRACE_SECONDS) _grace="$_val" ;;
+      esac
+    done < "$OVERRIDE_FILE"
+  fi
+}
+
+write_override() {
+  mkdir -p "$STATE_DIR"
+  local out="$STATE_DIR/.override.env.tmp"
+  : >"$out"
+  if [ "$_enabled" = "0" ]; then
+    printf 'AUTO_SHUTDOWN_ENABLED=%s\n' "$_enabled" >>"$out"
+  fi
+  if [ -n "$_grace" ]; then
+    printf 'AUTO_SHUTDOWN_GRACE_SECONDS=%s\n' "$_grace" >>"$out"
+  fi
+  # nothing overridden -> drop the file so status reports "none"
+  if [ ! -s "$out" ]; then
+    rm -f "$out" "$OVERRIDE_FILE"
+    return 0
+  fi
+  mv "$out" "$OVERRIDE_FILE"
+}
+
+cmd_status() {
+  read_override
+  echo "override file: ${OVERRIDE_FILE}"
+  if [ ! -f "$OVERRIDE_FILE" ]; then
+    echo "  (none - using nix-declared defaults; changes reset on reboot)"
+    return 0
+  fi
+  echo "  enabled:  $([ "$_enabled" = 0 ] && echo 'no' || echo 'yes')"
+  if [ -n "$_grace" ]; then
+    echo "  grace:    ${_grace}s"
+  fi
+  if [ -f "$STATE_FILE" ]; then
+    local since elapsed
+    since=$(cat "$STATE_FILE")
+    elapsed=$(( $(date +%s) - since ))
+    echo "  failing:  ${elapsed}s (counting since boot/toggle)"
+  else
+    echo "  failing:  not counting (conditions OK or freshly booted)"
+  fi
+}
+
+cmd_enable() {
+  read_override
+  _enabled=1
+  write_override
+  rm -f "$STATE_FILE"
+  echo "auto-shutdown enabled (runtime override, until next reboot)"
+}
+
+cmd_disable() {
+  read_override
+  _enabled=0
+  write_override
+  rm -f "$STATE_FILE"
+  echo "auto-shutdown disabled (runtime override, until next reboot)"
+}
+
+cmd_grace() {
+  local seconds
+  seconds=$(span_to_seconds "${1:?usage: auto-shutdown grace <span>}")
+  read_override
+  _grace="$seconds"
+  write_override
+  echo "auto-shutdown grace set to ${seconds}s (runtime override, until next reboot)"
+}
+
+cmd_reset() {
+  rm -f "$OVERRIDE_FILE"
+  echo "runtime override removed; nix-declared defaults restored (until reboot)"
+}
+
+if [ "$(id -u)" -ne 0 ]; then
+  echo "auto-shutdown: needs root to write ${OVERRIDE_FILE}; re-run with sudo" >&2
+  exit 1
+fi
+
+cmd="${1:-status}"
+shift || true
+case "$cmd" in
+  status) cmd_status ;;
+  enable) cmd_enable ;;
+  disable) cmd_disable ;;
+  grace) cmd_grace "${1:-}" ;;
+  reset) cmd_reset ;;
+  *)
+    echo "usage: auto-shutdown {status|enable|disable|grace <span>|reset}" >&2
+    exit 1
+    ;;
+esac
diff --git a/modules/nixos/base/custom/system/auto-shutdown/default.nix b/modules/nixos/base/custom/system/auto-shutdown/default.nix
new file mode 100644
index 00000000..11bd623a
--- /dev/null
+++ b/modules/nixos/base/custom/system/auto-shutdown/default.nix
@@ -0,0 +1,246 @@
+# ===============================================================================
+#
+# Auto power-off when the machine stays in a shutdown-worthy state for a while.
+#
+# A systemd timer periodically runs a list of *condition* executables
+# (`conditions`). Each executable exits 0 to mean "this check is OK"; any
+# non-zero exit marks the machine shutdown-worthy for that check. How the list
+# is combined is controlled by `mode`:
+#   all -> every check must pass to keep the machine on(default)
+#   any -> at least one passing check keeps the machine on
+# Once the machine stays shutdown-worthy for `gracePeriod`, it is powered off.
+#
+# Conditions can be any executable: a ping wrapper, a service health probe, a
+# load/temperature check, ... Build one from a shell script with
+# `pkgs.writeShellScript` and point `command` at it.
+#
+# `targets` is legacy convenience sugar: it expands to one ping condition per
+# host/IP and forces mode `any`(one reachable target keeps the machine on),
+# preserving the original "auto power-off when offline" behavior.
+#
+# Safety:
+#   - The countdown only starts after the first failed condition run, and
+#     resets as soon as the conditions are OK again.
+#   - The "failing since" state lives under /run so it is cleared on every
+#     boot: a boot into failing conditions restarts the full grace period
+#     instead of powering off immediately.
+#   - No check runs if neither `conditions` nor `targets` is set, so an
+#     unconfigured host never powers off by accident.
+#
+# All knobs(`enable`, `conditions`, `mode`, `targets`, `gracePeriod`, ...) are
+# exposed as options so the behavior can be overridden per host.
+#
+# TEMPORARY RUNTIME OVERRIDES (no rebuild, reset on reboot):
+#   The check script re-reads /run/auto-shutdown/override.env on every tick.
+#   Use the `auto-shutdown` command(root) to tweak it live:
+#     sudo auto-shutdown disable            # disable until next reboot
+#     sudo auto-shutdown enable
+#     sudo auto-shutdown grace 1h           # change grace until next reboot
+#     sudo auto-shutdown reset              # drop override, back to nix defaults
+#   Because the override lives under /run(tmpfs), every change reverts to the
+#   nix-declared defaults after a reboot.
+#
+# Check timer:    systemctl list-timers auto-shutdown.timer
+# Check logs:     journalctl -u auto-shutdown --since "1 hour ago"
+# Manual test:    systemctl start auto-shutdown.service
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.auto-shutdown;
+
+  # Parse a single-token systemd-style span("30min", "1h", "90s" ...) into
+  # seconds. Kept intentionally simple; supported units: s/m/min/h/d.
+  toSeconds =
+    span:
+    let
+      m = builtins.match "([0-9]+)(min|[smhd])?" span;
+      n = builtins.fromJSON (builtins.elemAt m 0);
+      unit = builtins.elemAt m 1;
+      mul = {
+        s = 1;
+        m = 60;
+        min = 60;
+        h = 3600;
+        d = 86400;
+      };
+    in
+    if m == null then
+      throw "modules.auto-shutdown: invalid span '${span}', expected e.g. 30s/30m/30min/1h/1d"
+    else
+      n * mul.${if unit == null then "s" else unit};
+
+  # Legacy sugar: turn `targets` into one ping condition per host/IP.
+  targetCondition = target: {
+    command = pkgs.writeShellScript "auto-shutdown-ping" ''
+      exec ping -c 1 -W 2 ${target}
+    '';
+    name = "ping ${target}";
+  };
+
+  # Explicit `conditions` take precedence over the `targets` sugar.
+  conditions = if cfg.conditions != [ ] then cfg.conditions else map targetCondition cfg.targets;
+
+  # Human-readable labels for logs; fall back to the command path.
+  conditionNames = map (c: if c.name == "" then toString c.command else c.name) conditions;
+
+  # `targets` implies mode "any"(one reachable target = online), matching the
+  # original offline-shutdown behavior; `conditions` follow the declared mode.
+  mode = if cfg.conditions != [ ] then cfg.mode else "any";
+
+  checkScript = pkgs.writeShellScript "auto-shutdown-check" (
+    builtins.readFile ./auto-shutdown-check.sh
+  );
+
+  # CLI for temporary runtime overrides(no rebuild). It only writes a file under
+  # /run, so any change resets to the nix defaults on the next reboot.
+  cli = pkgs.writeShellScriptBin "auto-shutdown" (builtins.readFile ./auto-shutdown-cli.sh);
+in
+{
+  options.modules.auto-shutdown = {
+    enable = lib.mkEnableOption ''
+      auto power-off when a shutdown-worthy state(e.g. offline) lasts for
+      `gracePeriod`
+    '';
+
+    conditions = lib.mkOption {
+      type = lib.types.listOf (
+        lib.types.submodule {
+          options = {
+            command = lib.mkOption {
+              type = lib.types.path;
+              description = ''
+                Path to an executable run on every tick. Exit 0 means this check
+                is OK; any non-zero exit marks the machine shutdown-worthy. Build
+                one from a shell script with `pkgs.writeShellScript`.
+              '';
+            };
+            name = lib.mkOption {
+              type = lib.types.str;
+              default = "";
+              description = ''
+                Label used in logs(whitespace is replaced with `_`). Defaults to
+                the command path.
+              '';
+            };
+          };
+        }
+      );
+      default = [ ];
+      description = ''
+        Executables that decide whether the machine should stay powered on,
+        combined per `mode`. Empty(default, with `targets` also empty) disables
+        the check entirely.
+      '';
+    };
+
+    mode = lib.mkOption {
+      type = lib.types.enum [
+        "all"
+        "any"
+      ];
+      default = "all";
+      description = ''
+        How `conditions` are combined. `all`: every check must pass to keep the
+        machine on(any single failure is shutdown-worthy). `any`: at least one
+        passing check keeps it on. Ignored while the `targets` sugar is used
+        (which forces `any`).
+      '';
+    };
+
+    targets = lib.mkOption {
+      type = lib.types.listOf lib.types.str;
+      default = [ ];
+      description = ''
+        Legacy convenience sugar: hosts/IPs probed by ping, expanded into ping
+        `conditions` with mode `any`. Ignored when `conditions` is set.
+      '';
+    };
+
+    gracePeriod = lib.mkOption {
+      type = lib.types.str;
+      default = "30min";
+      example = "1h";
+      description = ''
+        How long the machine must stay in a shutdown-worthy state before it is
+        powered off. Single-token span, supported units: s/m/min/h/d.
+      '';
+    };
+
+    bootDelay = lib.mkOption {
+      type = lib.types.str;
+      default = "2min";
+      example = "5min";
+      description = ''
+        How long after boot to wait before the first check runs, so the network
+        has a chance to come up.
+      '';
+    };
+
+    checkInterval = lib.mkOption {
+      type = lib.types.str;
+      default = "1min";
+      description = ''
+        How often to run the condition checks.
+      '';
+    };
+
+    verbose = lib.mkOption {
+      type = lib.types.bool;
+      default = false;
+      description = ''
+        Log every condition's result and the overall verdict on each tick to the
+        journal(`journalctl -u auto-shutdown`). Useful to see which check keeps
+        the machine on. When off, only state transitions and failures are logged.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    # `conditions` silently wins over `targets`; make the shadowing visible.
+    warnings = lib.optional (cfg.conditions != [ ] && cfg.targets != [ ]) ''
+      modules.auto-shutdown: both `conditions` and `targets` are set; the
+      `targets` list is ignored in favor of `conditions`.
+    '';
+
+    environment.systemPackages = [ cli ];
+
+    systemd.timers.auto-shutdown = {
+      wantedBy = [ "timers.target" ];
+      timerConfig = {
+        Unit = "auto-shutdown.service";
+        OnBootSec = cfg.bootDelay;
+        OnUnitActiveSec = cfg.checkInterval;
+      };
+    };
+
+    systemd.services.auto-shutdown = {
+      description = "Power off after a shutdown-worthy state lasts ${cfg.gracePeriod}";
+      path = with pkgs; [
+        bash
+        coreutils
+        iputils
+        systemd
+      ];
+      # config-dependent values are injected as environment variables so the
+      # shell scripts stay decoupled from nix evaluation.
+      environment = {
+        CONDITIONS = lib.concatStringsSep " " (map (c: c.command) conditions);
+        CONDITION_NAMES = lib.concatStringsSep " " (
+          map (n: lib.replaceStrings [ " " ] [ "_" ] n) conditionNames
+        );
+        MODE = mode;
+        GRACE_SECONDS = toString (toSeconds cfg.gracePeriod);
+        VERBOSE = if cfg.verbose then "1" else "0";
+      };
+      serviceConfig = {
+        Type = "oneshot";
+        User = "root";
+        ExecStart = checkScript;
+      };
+    };
+  };
+}
