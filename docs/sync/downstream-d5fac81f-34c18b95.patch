+    if (mask & 64) m.push("Super");   // LOGO / SUPER / META
+    if (mask & 1)  m.push("Shift");
+    if (mask & 4)  m.push("Ctrl");
+    if (mask & 8)  m.push("Alt");
+    if (mask & 16) m.push("Mod2");
+    if (mask & 32) m.push("Mod3");
