+    // Add remaining categories
+    for (var cat in collectedBinds) {
+      if (categoryOrder.indexOf(cat) === -1 && collectedBinds[cat].length > 0) {
+        categories.push({ "title": cat, "binds": collectedBinds[cat] });
+      }
+    }
