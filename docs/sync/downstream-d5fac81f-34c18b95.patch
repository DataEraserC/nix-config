diff --git a/modules/nixos/base/custom/notify/host-heartbeat/default.nix b/modules/nixos/base/custom/notify/host-heartbeat/default.nix
new file mode 100644
index 00000000..d1c3d37f
--- /dev/null
+++ b/modules/nixos/base/custom/notify/host-heartbeat/default.nix
@@ -0,0 +1,148 @@
+# ===============================================================================
+#
+# Periodically push a host liveness heartbeat via ntfy.
+#
+# The heartbeat message is rendered as markdown by the ntfy app, it contains:
+#   - host alive status: hostname / uptime / ISO8601 timestamp
+#   - network info: per-interface IPv4/IPv6 and public IP
+#   - cpolar tunnel status(optional, skipped gracefully if credentials missing)
+#
+# Notification metadata follows the repo-wide ntfy message spec:
+#   title "<host> · <event>", tags -> emoji, priority by importance.
+#   this service: title "<host> · heartbeat", tags "computer", priority "min".
+#
+# Architecture note: the script's logic lives in ./host-heartbeat-notify.sh
+# as a plain shell file(no nix interpolation inside), all config-dependent values
+# are injected into the systemd unit via `environment`. This keeps the script
+# free of nix indented-string escaping/indentation pitfalls and easy to test.
+#
+# Secrets are sourced at runtime from environment files configurable via:
+#   - ntfyTopicFile(default /etc/agenix/ntfy-topic.env, provides $NTFY_TOPIC)
+#   - cpolarEnvFile(default /etc/agenix/cpolar-status.env)
+# ntfy publish failures are logged only, they never fail this service.
+#
+# Check logs:
+#   journalctl -u host-heartbeat --since "1 hour ago"
+# Check timer:
+#   systemctl list-timers host-heartbeat.timer
+{
+  config,
+  lib,
+  pkgs,
+  cpolar-status,
+  ...
+}:
+let
+  cfg = config.modules.host-heartbeat;
+
+  cpolarStatus = cpolar-status.packages.${pkgs.system}.default;
+
+  script = pkgs.writeShellScript "host-heartbeat-notify" (
+    builtins.readFile ./host-heartbeat-notify.sh
+  );
+in
+{
+  options.modules.host-heartbeat = {
+    enable = lib.mkEnableOption ''
+      periodic host liveness heartbeat pushed to a ntfy server(topic from agenix secrets)
+    '';
+
+    hostName = lib.mkOption {
+      type = lib.types.str;
+      description = ''
+        Hostname shown in the heartbeat message and the ntfy title.
+        Set it explicitly from the importing host(keeps this module decoupled
+        from other modules' configuration).
+      '';
+    };
+
+    username = lib.mkOption {
+      type = lib.types.str;
+      description = ''
+        Primary username shown in the heartbeat message.
+        Set it explicitly from the importing host.
+      '';
+    };
+
+    interval = lib.mkOption {
+      type = lib.types.str;
+      default = "30min";
+      description = ''
+        Time between heartbeats, as a systemd time span(see systemd.time(7)).
+        Applied via OnUnitActiveSec of the systemd timer.
+      '';
+    };
+
+    includeCpolarStatus = lib.mkOption {
+      type = lib.types.bool;
+      default = true;
+      description = ''
+        Include cpolar tunnel status in the heartbeat.
+        Requires the credentials file configured by cpolarEnvFile; the section is
+        skipped gracefully when it is missing or unreadable instead of failing.
+      '';
+    };
+
+    ntfyTopicFile = lib.mkOption {
+      type = lib.types.path;
+      default = "/etc/agenix/ntfy-topic.env";
+      description = ''
+        Environment file sourced at runtime to obtain the ntfy topic.
+        Expected content: NTFY_TOPIC=<topic>. When the file is missing or the
+        variable is empty, the heartbeat is skipped with a log message.
+      '';
+    };
+
+    cpolarEnvFile = lib.mkOption {
+      type = lib.types.path;
+      default = "/etc/agenix/cpolar-status.env";
+      description = ''
+        Environment file providing the cpolar credentials(CPOLAR_USERNAME and
+        CPOLAR_PASSWORD), used only when includeCpolarStatus is enabled.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    systemd.timers.host-heartbeat = {
+      wantedBy = [ "timers.target" ];
+      timerConfig = {
+        Unit = "host-heartbeat.service";
+        OnBootSec = "2min";
+        OnUnitActiveSec = cfg.interval;
+      };
+    };
+
+    systemd.services.host-heartbeat = {
+      description = "Push host liveness heartbeat via ntfy";
+      after = [ "network-online.target" ] ++ lib.optionals cfg.includeCpolarStatus [ "cpolar.service" ];
+      wants = [ "network-online.target" ] ++ lib.optionals cfg.includeCpolarStatus [ "cpolar.service" ];
+      path = with pkgs; [
+        bash
+        procps
+        coreutils
+        gnugrep
+        gnused
+        iproute2
+        curl
+        ntfy-sh
+      ];
+      # all config-dependent values are injected as environment variables,
+      # so that the shell script stays decoupled from nix evaluation.
+      environment = {
+        HOST_NAME = cfg.hostName;
+        USER_NAME = cfg.username;
+        NTFY_TOPIC_FILE = toString cfg.ntfyTopicFile;
+      }
+      // lib.optionalAttrs cfg.includeCpolarStatus {
+        CPOLAR_CREDENTIALS_FILE = toString cfg.cpolarEnvFile;
+        CPOLAR_STATUS_BIN = toString (lib.getExe cpolarStatus);
+      };
+      serviceConfig = {
+        Type = "oneshot";
+        User = "root";
+        ExecStart = script;
+      };
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/notify/host-heartbeat/host-heartbeat-notify.sh b/modules/nixos/base/custom/notify/host-heartbeat/host-heartbeat-notify.sh
new file mode 100644
index 00000000..73d93813
--- /dev/null
+++ b/modules/nixos/base/custom/notify/host-heartbeat/host-heartbeat-notify.sh
@@ -0,0 +1,175 @@
+#!/usr/bin/env bash
+# Periodically push a host liveness heartbeat via ntfy(markdown).
+#
+# All inputs are injected by the systemd unit as environment variables, so this
+# script stays free of any nix/config coupling:
+#   HOST_NAME                target hostname, e.g. ai
+#   USER_NAME                primary username, e.g. nixos
+#   NTFY_TOPIC_FILE          env-file providing $NTFY_TOPIC(required)
+#   CPOLAR_CREDENTIALS_FILE  env-file providing CPOLAR_USERNAME/CPOLAR_PASSWORD
+#   CPOLAR_STATUS_BIN        absolute path to the cpolar-status binary
+# The cpolar section runs only when CPOLAR_STATUS_BIN is set; it is skipped
+# gracefully when the credentials file is missing/unreadable.
+#
+# Message spec(repo-wide): title "<host> · heartbeat", tags "computer",
+# priority "min", body rendered as markdown by the ntfy app.
+set -uo pipefail
+
+# --------------------------------------------------------------------
+# ntfy topic(sourced at runtime, never hardcoded)
+# --------------------------------------------------------------------
+topic_file="${NTFY_TOPIC_FILE:?NTFY_TOPIC_FILE must be set}"
+if [ -f "$topic_file" ]; then
+  . "$topic_file"
+fi
+if [ -z "${NTFY_TOPIC:-}" ]; then
+  echo "ntfy topic unavailable($topic_file missing or NTFY_TOPIC empty), skip heartbeat" >&2
+  exit 0
+fi
+
+# --------------------------------------------------------------------
+# host alive status(hostname / uptime / ISO8601 timestamp)
+# --------------------------------------------------------------------
+NOW="$(date --iso-8601=seconds)"
+# prefer procps' pretty format, fall back to coreutils' plain output
+UP="$(uptime -p 2>/dev/null)"
+if [ -z "$UP" ]; then
+  UP="$(uptime 2>/dev/null)"
+fi
+
+# power state(AC/battery + capacity), omitted when the host has no battery
+POWER_LINE=""
+mains_online=""
+for dev in /sys/class/power_supply/*; do
+  [ -d "$dev" ] || continue
+  [ "$(cat "$dev/type" 2>/dev/null)" = "Mains" ] || continue
+  mains_online="$(cat "$dev/online" 2>/dev/null)"
+  break
+done
+capacity=""
+for dev in /sys/class/power_supply/*; do
+  [ -d "$dev" ] || continue
+  [ "$(cat "$dev/type" 2>/dev/null)" = "Battery" ] || continue
+  capacity="$(cat "$dev/capacity" 2>/dev/null)"
+  [ -n "$capacity" ] && break
+done
+if [ -n "$mains_online" ] || [ -n "$capacity" ]; then
+  if [ "$mains_online" = "1" ]; then
+    POWER_LINE="**Power** AC"
+  else
+    POWER_LINE="**Power** battery"
+  fi
+  if [ -n "$capacity" ]; then
+    POWER_LINE="$POWER_LINE (${capacity}%)"
+  fi
+fi
+POWER_BLOCK=""
+if [ -n "$POWER_LINE" ]; then
+  POWER_BLOCK="
+$POWER_LINE"
+fi
+
+MSG="**Host** ${HOST_NAME} (${USER_NAME})
+**State** alive
+**Uptime** ${UP:-unknown}
+**Time** $NOW$POWER_BLOCK"
+
+# --------------------------------------------------------------------
+# network info(per-interface IPv4/IPv6 + public IP)
+# --------------------------------------------------------------------
+DEFAULT_IFACE="$(ip route show default 2>/dev/null | grep -oP 'dev \K\S+' | head -n1)"
+
+# collect every interface(excluding loopback) with its IPs, one markdown list
+# item each; the default outbound interface is annotated.
+INTERFACES_INFO=""
+for IFACE in $(ls /sys/class/net 2>/dev/null); do
+  [ "$IFACE" = "lo" ] && continue
+
+  IPV4_ADDR="$(ip -4 addr show dev "$IFACE" 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n1)"
+  IPV6_ADDR="$(ip -6 addr show dev "$IFACE" 2>/dev/null | grep -oP '(?<=inet6\s)[0-9a-f:]+' | grep -v '^fe80:' | head -n1)"
+
+  PART=""
+  [ -n "$IPV4_ADDR" ] && PART="IPv4 $IPV4_ADDR"
+  if [ -n "$IPV6_ADDR" ]; then
+    if [ -n "$PART" ]; then
+      PART="$PART · IPv6 $IPV6_ADDR"
+    else
+      PART="IPv6 $IPV6_ADDR"
+    fi
+  fi
+
+  MARK=""
+  [ "$IFACE" = "$DEFAULT_IFACE" ] && MARK=" *(default)*"
+
+  INTERFACES_INFO="$INTERFACES_INFO
+- **$IFACE**$MARK ${PART:-no IP}"
+done
+
+get_public_ip() {
+  local family endpoint response
+
+  for family in -4 -6; do
+    for endpoint in \
+      "https://api64.ipify.org" \
+      "https://ifconfig.co/ip" \
+      "https://icanhazip.com"; do
+      response="$(curl -fsS --max-time 5 "$family" "$endpoint" 2>/dev/null || true)"
+      response="${response//$'\r'/}"
+      response="${response//$'\n'/}"
+
+      if [[ "$response" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] ||
+         [[ "$response" =~ ^[0-9A-Fa-f:]+$ && "$response" == *:* ]]; then
+        printf '%s\n' "$response"
+        return 0
+      fi
+    done
+  done
+
+  return 1
+}
+
+PUBLIC_IP="$(get_public_ip || true)"
+
+MSG="$MSG
+
+**Interfaces**${INTERFACES_INFO}"
+if [ -n "$PUBLIC_IP" ]; then
+  MSG="$MSG
+
+**Public IP** $PUBLIC_IP"
+fi
+
+# --------------------------------------------------------------------
+# cpolar tunnel status(skipped gracefully on any problem)
+# --------------------------------------------------------------------
+if [ -n "${CPOLAR_STATUS_BIN:-}" ]; then
+  credentials_file="$CPOLAR_CREDENTIALS_FILE"
+  if [ -f "$credentials_file" ]; then
+    . "$credentials_file" 2>/dev/null
+  fi
+  if [ -z "${CPOLAR_USERNAME:-}" ] || [ -z "${CPOLAR_PASSWORD:-}" ]; then
+    echo "cpolar credentials missing($credentials_file), skip cpolar status" >&2
+  else
+    OUTPUT="$("$CPOLAR_STATUS_BIN" --username "$CPOLAR_USERNAME" --password "$CPOLAR_PASSWORD")"
+    if [ $? -eq 0 ]; then
+      TUNNELS_MD="$(printf '%s\n' "$OUTPUT" | sed 's/^/- /')"
+      MSG="$MSG
+
+**Tunnels (cpolar)**
+$TUNNELS_MD"
+    else
+      echo "cpolar-status failed, skip cpolar status" >&2
+    fi
+  fi
+fi
+
+# --------------------------------------------------------------------
+# publish(markdown mode; failure is logged only, never fails the service)
+# --------------------------------------------------------------------
+ntfy publish \
+  --title "${HOST_NAME} · heartbeat" \
+  --tags "computer" \
+  --priority "min" \
+  --markdown \
+  "$NTFY_TOPIC" "$MSG" || echo "ntfy publish failed" >&2
+exit 0
diff --git a/modules/nixos/base/custom/notify/network-event-notify/default.nix b/modules/nixos/base/custom/notify/network-event-notify/default.nix
new file mode 100644
index 00000000..8869783a
--- /dev/null
+++ b/modules/nixos/base/custom/notify/network-event-notify/default.nix
@@ -0,0 +1,78 @@
+# ===============================================================================
+#
+# NetworkManager dispatcher hook(shared): push a network event notification via
+# ntfy(markdown) on up/down/vpn-up/vpn-down, and re-authenticate the tp_link
+# router(anonymous host) on up/vpn-up events.
+#
+# Notification metadata follows the repo-wide ntfy message spec:
+#   title "<host> · network <status>", tags globe_with_meridians(up) /
+#   warning(down), priority default(high for down), markdown body.
+#
+# Architecture note: the script's logic lives in
+# ./network-event-notify.sh as a plain shell file(no nix interpolation
+# inside); config-dependent values are injected by a thin generated wrapper via
+# environment variables, then exec'd with the original NM arguments.
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.network-event-notify;
+
+  script = pkgs.writeShellScript "network-event-notify" (builtins.readFile ./network-event-notify.sh);
+
+  # Thin NM dispatcher entry: injects environment, then execs the shared script
+  # with the original arguments(interface & status).
+  wrapper = pkgs.writeShellScript "nm-dispatcher-hook" ''
+    export PATH="${
+      lib.makeBinPath [
+        pkgs.coreutils
+        pkgs.gnugrep
+        pkgs.iproute2
+        pkgs.curl
+        pkgs.ntfy-sh
+        pkgs.libnotify
+      ]
+    }''${PATH:+:$PATH}"
+    export HOST_NAME="${cfg.hostName}"
+    export NTFY_TOPIC_FILE="${toString cfg.ntfyTopicFile}"
+    exec ${script} "$@"
+  '';
+in
+{
+  options.modules.network-event-notify = {
+    enable = lib.mkEnableOption ''
+      ntfy network event notifications via the NetworkManager dispatcher
+    '';
+
+    hostName = lib.mkOption {
+      type = lib.types.str;
+      description = ''
+        Hostname shown in the notification message and title.
+        Set it explicitly from the importing host(keeps this module decoupled
+        from other modules' configuration).
+      '';
+    };
+
+    ntfyTopicFile = lib.mkOption {
+      type = lib.types.path;
+      default = "/etc/agenix/ntfy-topic.env";
+      description = ''
+        Environment file sourced at runtime to obtain the ntfy topic.
+        Expected content: NTFY_TOPIC=<topic>. When the file is missing or the
+        variable is empty, the notification is skipped with a log message.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    networking.networkmanager.dispatcherScripts = [
+      {
+        source = wrapper;
+        type = "basic";
+      }
+    ];
+  };
+}
diff --git a/modules/nixos/base/custom/notify/network-event-notify/network-event-notify.sh b/modules/nixos/base/custom/notify/network-event-notify/network-event-notify.sh
new file mode 100644
index 00000000..e5259954
--- /dev/null
+++ b/modules/nixos/base/custom/notify/network-event-notify/network-event-notify.sh
@@ -0,0 +1,178 @@
+#!/usr/bin/env bash
+# NetworkManager dispatcher hook: push a network event notification via ntfy
+# and re-authenticate the tp_link router(anonymous host) on up/vpn-up events.
+#
+# NM contract: invoked as this-script <interface> <status>, with env vars like
+# DEVICE_IFACE / CONNECTION_ID / CONNECTION_UUID provided by NetworkManager.
+#
+# All inputs are injected by the systemd unit(wrapper) as environment variables,
+# so this script stays free of any nix/config coupling:
+#   HOST_NAME        target hostname, e.g. ai
+#   NTFY_TOPIC_FILE  env-file providing $NTFY_TOPIC(required)
+#
+# Message spec(repo-wide): title "<host> · network <status>",
+# tags globe_with_meridians(up)/warning(down), priority default/high, markdown.
+set -uo pipefail
+
+INTERFACE=$1
+STATUS=$2
+
+notify_status(){
+  if [ -f "$NTFY_TOPIC_FILE" ]; then
+    . "$NTFY_TOPIC_FILE"
+  else
+    echo "No ntfy topic file found($NTFY_TOPIC_FILE)"
+    return 1
+  fi
+
+  IPV4_ADDR=$(ip -4 addr show dev "$INTERFACE" 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n1)
+  IPV6_ADDR=$(ip -6 addr show dev "$INTERFACE" 2>/dev/null | grep -oP '(?<=inet6\s)[0-9a-f:]+' | grep -v '^fe80:' | head -n1)
+  get_public_ip() {
+    local family endpoint response
+
+    for family in -4 -6; do
+      for endpoint in \
+        "https://api64.ipify.org" \
+        "https://ifconfig.co/ip" \
+        "https://icanhazip.com"; do
+        response="$(curl -fsS --max-time 5 "$family" "$endpoint" 2>/dev/null || true)"
+        response="${response//$'\r'/}"
+        response="${response//$'\n'/}"
+
+        if [[ "$response" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] ||
+           [[ "$response" =~ ^[0-9A-Fa-f:]+$ && "$response" == *:* ]]; then
+          printf '%s\n' "$response"
+          return 0
+        fi
+      done
+    done
+
+    return 1
+  }
+
+  PUBLIC_IP=$(get_public_ip || true)
+
+  case "$STATUS" in
+    down|vpn-down) TAGS="warning"; PRIO="high" ;;
+    *)             TAGS="globe_with_meridians"; PRIO="default" ;;
+  esac
+
+  MSG="**Host** ${HOST_NAME}
+**Iface** $DEVICE_IFACE
+**Conn** $CONNECTION_ID ($CONNECTION_UUID)
+**Event** $STATUS
+**Time** $(date --iso-8601=seconds)
+
+**Addresses**
+- IPv4 ${IPV4_ADDR:-N/A}
+- IPv6 ${IPV6_ADDR:-N/A}"
+  if [ -n "$PUBLIC_IP" ]; then
+    MSG="$MSG
+
+**Public IP** $PUBLIC_IP"
+  fi
+
+  notify-send "Network $STATUS" "$DEVICE_IFACE: IPv4=${IPV4_ADDR:-N/A} Public=${PUBLIC_IP:-N/A}" || true
+  ntfy publish \
+    --title "${HOST_NAME} · network $STATUS" \
+    --tags "$TAGS" \
+    --priority "$PRIO" \
+    --markdown \
+    "$NTFY_TOPIC" "$MSG" || echo "ntfy publish failed" >&2
+}
+
+# 获取MAC地址函数
+get_mac() {
+    local interface="wlp0s20f3"
+    local mac_file="/sys/class/net/$interface/address"
+
+    if [[ -f "$mac_file" ]]; then
+        cat "$mac_file"
+        return 0
+    else
+        echo "Warning: Cannot get MAC address for network interface $interface" >&2
+        echo "Warning: File $mac_file does not exist" >&2
+        return 1
+    fi
+}
+# 查找tp_link_script函数（严格版本）
+find_tp_link_script() {
+    local script_pattern="$HOME/.config/*/scripts/tp_link_script"
+    local script_paths=($script_pattern)
+    local script_path
+
+    if [[ ${#script_paths[@]} -eq 0 ]]; then
+        echo "Error: No tp_link_script found matching pattern: $script_pattern" >&2
+        return 1
+    elif [[ ${#script_paths[@]} -gt 1 ]]; then
+        echo "Warning: Multiple tp_link_script files found, using the first one" >&2
+        for path in "${script_paths[@]}"; do
+            echo "  Found: $path" >&2
+        done
+    fi
+
+    script_path="${script_paths[0]}"
+
+    if [[ ! -f "$script_path" ]]; then
+        echo "Error: tp_link_script not found: $script_path" >&2
+        return 1
+    fi
+
+    if [[ ! -x "$script_path" ]]; then
+        echo "Error: tp_link_script is not executable: $script_path" >&2
+        return 1
+    fi
+
+    echo "$script_path"
+    return 0
+}
+
+# 匿名函数
+anonymous() {
+    local mac_address
+    local script_path
+
+    # 获取MAC地址
+    mac_address=$(get_mac)
+    if [[ $? -ne 0 ]] || [[ -z "$mac_address" ]]; then
+        echo "Error: Failed to get MAC address, aborting execution" >&2
+        return 1
+    fi
+
+    # 查找tp_link_script
+    script_path=$(find_tp_link_script)
+    if [[ $? -ne 0 ]] || [[ -z "$script_path" ]]; then
+        echo "Error: Cannot find tp_link_script, aborting execution" >&2
+        return 1
+    fi
+
+    echo "Info: Using script: $script_path"
+    echo "Info: MAC address: $mac_address"
+
+    # 执行命令
+    "$script_path" "http://192.168.0.1" "111111" "$mac_address" "Anonymous Host" "0"
+}
+
+case "$STATUS" in
+  up)
+    # 等待一下确保IP地址已经分配
+    sleep 2
+    notify_status
+    anonymous
+  ;;
+  vpn-up)
+    sleep 2
+    notify_status
+    anonymous
+  ;;
+  down)
+    notify_status
+  ;;
+  vpn-down)
+    notify_status
+  ;;
+esac
+
+# NM ignores dispatcher exit codes, but keep this hook always-successful by
+# contract: notification failures above are already logged only.
+exit 0
diff --git a/modules/nixos/base/custom/notify/power-event-notify/default.nix b/modules/nixos/base/custom/notify/power-event-notify/default.nix
new file mode 100644
index 00000000..3e5c80ff
--- /dev/null
+++ b/modules/nixos/base/custom/notify/power-event-notify/default.nix
@@ -0,0 +1,149 @@
+# ===============================================================================
+#
+# Notify on AC power loss/restore via ntfy(markdown), event-driven.
+#
+# The Linux kernel emits a `change` uevent for the power_supply Mains device
+# whenever the AC adapter is plugged/unplugged. A udev rule matches those
+# events and starts a one-shot systemd unit that publishes the notification, so
+# there is zero polling cost and the message arrives within ~1s of the event.
+#
+# Notification metadata follows the repo-wide ntfy message spec:
+#   title "<host> · power lost"/"<host> · power restored",
+#   tags "warning"/"electric_plug", priority high/low.
+#
+# Architecture note: the script's logic lives in ./power-event-notify.sh
+# as a plain shell file(no nix interpolation inside), all config-dependent values
+# are injected into the systemd unit via `environment`.
+#
+# Secrets are sourced at runtime from ntfyTopicFile(default
+# /etc/agenix/ntfy-topic.env, provides $NTFY_TOPIC). Publish failures are logged
+# only, they never fail the service.
+#
+# Edge handling: the script keeps the last notified state under /run(tmpfs), so
+# duplicate uevents for the same state are ignored, events that happen while
+# suspended are delivered as change events on resume, and the state resets on
+# every boot with no stale notifications.
+#
+# Fallback: if the platform's ACPI/legion driver does not emit Mains change
+# events(check with `udevadm monitor --property` while unplugging), switch
+# `trigger` to "timer" to poll every `interval` instead; the notify logic is
+# shared and needs no code change.
+#
+# Check logs:
+#   journalctl -u power-event-notify
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.power-event-notify;
+
+  script = pkgs.writeShellScript "power-event-notify" (builtins.readFile ./power-event-notify.sh);
+
+  # udev rule file shipped via services.udev.packages(composes cleanly with
+  # other udev rule sources such as modules/nixos/desktop/peripherals.nix).
+  # ACTION=="change" only: `add` events at boot would not be a real transition,
+  # and in udev mode every change event is a genuine plug/unplug.
+  udevRules = pkgs.writeTextFile {
+    name = "power-event-notify-udev-rules";
+    destination = "/lib/udev/rules.d/80-power-event-notify.rules";
+    # udev rules are parsed per physical line: no backslash continuation, keep
+    # the whole rule on one line.
+    text = ''
+      SUBSYSTEM=="power_supply", ATTR{type}=="Mains", ACTION=="change", RUN+="${pkgs.systemd}/bin/systemctl start --no-block power-event-notify.service"
+    '';
+  };
+in
+{
+  options.modules.power-event-notify = {
+    enable = lib.mkEnableOption ''
+      ntfy notifications when the AC power supply is lost/restored
+    '';
+
+    hostName = lib.mkOption {
+      type = lib.types.str;
+      description = ''
+        Hostname shown in the notification message and the ntfy title.
+        Set it explicitly from the importing host(keeps this module decoupled
+        from other modules' configuration).
+      '';
+    };
+
+    trigger = lib.mkOption {
+      type = lib.types.enum [
+        "udev"
+        "timer"
+      ];
+      default = "udev";
+      description = ''
+        How the check is triggered:
+        - "udev": react to kernel power_supply(Mains) uevents(no polling, ~1s
+          response). Default, requires the platform to emit those events.
+        - "timer": poll every `interval` as a fallback when the uevent is
+          unreliable on the target hardware.
+      '';
+    };
+
+    interval = lib.mkOption {
+      type = lib.types.str;
+      default = "1min";
+      description = ''
+        Poll interval, only used when `trigger` is "timer". Time between checks,
+        as a systemd time span(see systemd.time(7)).
+      '';
+    };
+
+    ntfyTopicFile = lib.mkOption {
+      type = lib.types.path;
+      default = "/etc/agenix/ntfy-topic.env";
+      description = ''
+        Environment file sourced at runtime to obtain the ntfy topic.
+        Expected content: NTFY_TOPIC=<topic>. When the file is missing or the
+        variable is empty, the notification is skipped with a log message.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    systemd.services.power-event-notify = {
+      description = "Notify on AC power loss/restore via ntfy";
+      # No network-online dependency on purpose: this unit is started on demand
+      # by udev at runtime, and waiting on network-online could wedge the start
+      # job while the machine is offline. Publishing is best-effort anyway.
+      path = with pkgs; [
+        bash
+        coreutils
+        gnugrep
+        gnused
+        curl
+        ntfy-sh
+      ];
+      # all config-dependent values are injected as environment variables,
+      # so that the shell script stays decoupled from nix evaluation.
+      environment = {
+        HOST_NAME = cfg.hostName;
+        NTFY_TOPIC_FILE = toString cfg.ntfyTopicFile;
+        SEED_IF_EMPTY = if cfg.trigger == "timer" then "1" else "0";
+      };
+      serviceConfig = {
+        Type = "oneshot";
+        User = "root";
+        ExecStart = script;
+      };
+    };
+
+    services.udev.packages = lib.mkIf (cfg.trigger == "udev") [ udevRules ];
+
+    # polling fallback trigger(instead of the udev rule above)
+    systemd.timers.power-event-notify = lib.mkIf (cfg.trigger == "timer") {
+      wantedBy = [ "timers.target" ];
+      timerConfig = {
+        Unit = "power-event-notify.service";
+        OnBootSec = "2min";
+        OnUnitActiveSec = cfg.interval;
+      };
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/notify/power-event-notify/power-event-notify.sh b/modules/nixos/base/custom/notify/power-event-notify/power-event-notify.sh
new file mode 100644
index 00000000..cba14e55
--- /dev/null
+++ b/modules/nixos/base/custom/notify/power-event-notify/power-event-notify.sh
@@ -0,0 +1,145 @@
+#!/usr/bin/env bash
+# Notify on AC power loss/restore via ntfy(markdown).
+#
+# All inputs are injected by the systemd unit as environment variables, so this
+# script stays free of any nix/config coupling:
+#   HOST_NAME        target hostname, e.g. ai
+#   NTFY_TOPIC_FILE  env-file providing $NTFY_TOPIC(required)
+#   SEED_IF_EMPTY    "1" for timer mode(the first run is a boot baseline and must
+#                    not notify), anything else for udev mode(where every run is
+#                    a genuine power_supply change event).
+#
+# The current mains state is read from /sys/class/power_supply; the last
+# notified state is kept under /run/power-event-notify/state(tmpfs), so:
+#   - duplicate uevents for the same state are ignored,
+#   - events that happen while suspended are delivered as change events on
+#     resume and picked up here,
+#   - the state resets on every boot(no stale notifications).
+#
+# Message spec(repo-wide): title "<host> · power lost|power restored",
+# tags "warning"/"electric_plug", priority high/low, markdown body.
+set -uo pipefail
+
+# --------------------------------------------------------------------
+# ntfy topic(sourced at runtime, never hardcoded)
+# --------------------------------------------------------------------
+topic_file="${NTFY_TOPIC_FILE:?NTFY_TOPIC_FILE must be set}"
+if [ -f "$topic_file" ]; then
+  . "$topic_file"
+fi
+if [ -z "${NTFY_TOPIC:-}" ]; then
+  echo "ntfy topic unavailable($topic_file missing or NTFY_TOPIC empty), skip power notification" >&2
+  exit 0
+fi
+
+# --------------------------------------------------------------------
+# current mains state(no Mains device -> not a battery-powered laptop)
+# --------------------------------------------------------------------
+mains_dev=""
+for dev in /sys/class/power_supply/*; do
+  [ -d "$dev" ] || continue
+  [ "$(cat "$dev/type" 2>/dev/null)" = "Mains" ] || continue
+  mains_dev="$dev"
+  break
+done
+if [ -z "$mains_dev" ]; then
+  echo "no Mains power supply found, skip power notification" >&2
+  exit 0
+fi
+
+ONLINE="$(cat "$mains_dev/online" 2>/dev/null)"
+if [ "$ONLINE" = "1" ]; then
+  CUR="on"
+elif [ "$ONLINE" = "0" ]; then
+  CUR="off"
+else
+  echo "cannot read Mains online state($mains_dev/online), skip power notification" >&2
+  exit 0
+fi
+
+# battery capacity(optional, included in the message when available)
+CAPACITY=""
+for dev in /sys/class/power_supply/*; do
+  [ -d "$dev" ] || continue
+  [ "$(cat "$dev/type" 2>/dev/null)" = "Battery" ] || continue
+  CAPACITY="$(cat "$dev/capacity" 2>/dev/null)"
+  [ -n "$CAPACITY" ] && break
+done
+
+# --------------------------------------------------------------------
+# edge detection vs. last notified state(/run, cleared on every boot)
+# --------------------------------------------------------------------
+STATE_DIR=/run/power-event-notify
+STATE_FILE="$STATE_DIR/state"
+# create the state dir unconditionally: it only exists after a previous write,
+# so without this every state write below fails with "No such file or
+# directory" on udev-triggered runs and dedup against duplicate uevents never
+# works(observed in journalctl -u power-event-notify).
+install -d -m 0755 "$STATE_DIR"
+
+PREV=""
+[ -f "$STATE_FILE" ] && PREV="$(cat "$STATE_FILE" 2>/dev/null)"
+
+if [ -z "$PREV" ]; then
+  if [ "${SEED_IF_EMPTY:-0}" = "1" ]; then
+    # timer mode: first run after boot establishes the baseline, no notify.
+    printf '%s\n' "$CUR" > "$STATE_FILE"
+    echo "power-event-notify: baseline state $CUR(no notification on first run)" >&2
+    exit 0
+  fi
+  # udev mode: every run is a real change event, so an empty state is a
+  # genuine transition(after boot, no plug/unplug could have been missed).
+  TRANSITIONED=1
+elif [ "$PREV" != "$CUR" ]; then
+  TRANSITIONED=1
+else
+  TRANSITIONED=0
+fi
+
+if [ "$TRANSITIONED" = "0" ]; then
+  echo "power-event-notify: state unchanged($CUR), skip" >&2
+  exit 0
+fi
+
+# --------------------------------------------------------------------
+# state transition -> build & publish the message
+# --------------------------------------------------------------------
+if [ "$CUR" = "off" ]; then
+  EVENT="power lost"
+  TITLE="${HOST_NAME} · power lost"
+  TAGS="warning"
+  PRIO="high"
+  SOURCE="battery"
+else
+  EVENT="power restored"
+  TITLE="${HOST_NAME} · power restored"
+  TAGS="electric_plug"
+  PRIO="low"
+  SOURCE="AC"
+fi
+
+POWER_LINE="**Power** ${SOURCE}"
+if [ -n "$CAPACITY" ]; then
+  POWER_LINE="$POWER_LINE (${CAPACITY}%)"
+fi
+
+MSG="**Host** ${HOST_NAME}
+**Event** $EVENT
+$POWER_LINE
+**Time** $(date --iso-8601=seconds)"
+
+if ntfy publish \
+  --title "$TITLE" \
+  --tags "$TAGS" \
+  --priority "$PRIO" \
+  --markdown \
+  "$NTFY_TOPIC" "$MSG"; then
+  # remember the state we just handled so duplicate uevents are ignored.
+  # persisted only after a successful publish: a failed publish stays a
+  # pending transition, so the next uevent for the same state retries it.
+  printf '%s\n' "$CUR" > "$STATE_FILE" \
+    || echo "cannot persist state($STATE_FILE), dedup degraded" >&2
+else
+  echo "ntfy publish failed" >&2
+fi
+exit 0
diff --git a/modules/nixos/base/custom/services/alist.nix b/modules/nixos/base/custom/services/alist.nix
new file mode 100644
index 00000000..da2d98ef
--- /dev/null
+++ b/modules/nixos/base/custom/services/alist.nix
@@ -0,0 +1,183 @@
+# alist (openlist) - self-hosted file listing / management program.
+#
+# Moved out of the old desktop custom tree and wrapped as an options+config
+# module: `modules.alist.enable` toggles the service, while the service
+# account is defined UNCONDITIONALLY on purpose:
+#
+#   - agenix decrypts `alist-jwt` with owner=alist on every host with desktop
+#     secrets (idols-ai, shoukei, both wsl hosts) and on aquamarine (webserver
+#     secrets). The user must exist even where the service is disabled,
+#     otherwise activation fails on chown.
+#   - wsl_import.nix used to carry an ad-hoc alist stub for the same reason;
+#     it is superseded by this definition.
+#
+# The uid/gid are pinned to 998:997 in hosts/service-user-ids.nix: dynamic ids
+# (400-999) are only persisted per host in /var/lib/nixos/uid-map, which does
+# not survive the wiped /var of an impermanence setup - re-allocating would
+# orphan /var/lib/openlist and the decrypted secret. Access is owner-based
+# (uid); agenix uses mode 0700 owner=alist.
+{
+  config,
+  lib,
+  pkgs,
+  nur-Moraxyc,
+  ...
+}:
+let
+  cfg = config.modules.alist;
+in
+{
+  imports = [ nur-Moraxyc.nixosModules.alist ];
+
+  options.modules.alist = {
+    enable = lib.mkEnableOption "alist (openlist) file listing service";
+    port = lib.mkOption {
+      type = lib.types.port;
+      description = "Port alist listens on; the host that uses this module must set it (port registry myvars.networking.services.alist.hosts.<machine>.port).";
+    };
+    s3Port = lib.mkOption {
+      type = lib.types.port;
+      description = "alist settings.s3 listen port; the host that uses this module must set it (port registry myvars.networking.services.alist.hosts.<machine>.s3Port).";
+    };
+  };
+
+  # NOTE: bare config attributes cannot coexist with an explicit `config` key,
+  # so the unconditional account lives inside `config` alongside the mkIf'ed
+  # service definition.
+  config = {
+    users.users.alist = {
+      isSystemUser = true;
+      group = "alist";
+    };
+
+    # The NUR module only declares this group while services.alist is enabled,
+    # but the account above is unconditional - declare the group here so hosts
+    # that only decrypt alist-jwt (wsl, shoukei) can still useradd -g alist.
+    users.groups.alist = { };
+
+    services.alist = lib.mkIf cfg.enable {
+      enable = true;
+      user = "alist";
+      group = "alist";
+      dataDir = "/var/lib/openlist/data";
+      allowModify = true;
+      package = pkgs.openlist;
+      settings = {
+        force = false;
+        site_url = "";
+        cdn = "";
+        jwt_secret = {
+          _secret = "/run/agenix/alist-jwt";
+        };
+        token_expires_in = 48;
+        database = {
+          type = "sqlite3";
+          host = "";
+          port = 0;
+          user = "";
+          password = "";
+          name = "";
+          db_file = "/var/lib/openlist/data/data.db";
+          table_prefix = "x_";
+          ssl_mode = "";
+          dsn = "";
+        };
+        meilisearch = {
+          host = "http://localhost:7700";
+          api_key = "";
+          index_prefix = "";
+        };
+        scheme = {
+          address = "0.0.0.0";
+          http_port = cfg.port;
+          https_port = -1;
+          force_https = false;
+          cert_file = "";
+          key_file = "";
+          unix_file = "";
+          unix_file_perm = "";
+        };
+        temp_dir = "/var/lib/openlist/data/temp";
+        bleve_dir = "/var/lib/openlist/data/bleve";
+        dist_dir = "";
+        log = {
+          enable = true;
+          name = "/var/lib/openlist/data/log/log.log";
+          max_size = 10;
+          max_backups = 5;
+          max_age = 28;
+          compress = false;
+        };
+        delayed_start = 0;
+        max_connections = 0;
+        max_concurrency = 64;
+        tls_insecure_skip_verify = true;
+        tasks = {
+          download = {
+            workers = 5;
+            max_retry = 1;
+            task_persistent = false;
+          };
+          transfer = {
+            workers = 5;
+            max_retry = 2;
+            task_persistent = false;
+          };
+          upload = {
+            workers = 5;
+            max_retry = 0;
+            task_persistent = false;
+          };
+          copy = {
+            workers = 5;
+            max_retry = 2;
+            task_persistent = false;
+          };
+          decompress = {
+            workers = 5;
+            max_retry = 2;
+            task_persistent = false;
+          };
+          decompress_upload = {
+            workers = 5;
+            max_retry = 2;
+            task_persistent = false;
+          };
+          allow_retry_canceled = false;
+        };
+        cors = {
+          allow_origins = [
+            "*"
+          ];
+          allow_methods = [
+            "*"
+          ];
+          allow_headers = [
+            "*"
+          ];
+        };
+        s3 = {
+          enable = false;
+          port = cfg.s3Port;
+          ssl = false;
+        };
+        ftp = {
+          enable = false;
+          listen = ":5221";
+          find_pasv_port_attempts = 50;
+          active_transfer_port_non_20 = false;
+          idle_timeout = 900;
+          connection_timeout = 30;
+          disable_active_mode = false;
+          default_transfer_binary = false;
+          enable_active_conn_ip_check = true;
+          enable_pasv_conn_ip_check = true;
+        };
+        sftp = {
+          enable = false;
+          listen = ":5222";
+        };
+      };
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/services/bigdata-hadoop.nix b/modules/nixos/base/custom/services/bigdata-hadoop.nix
new file mode 100644
index 00000000..4020e4d9
--- /dev/null
+++ b/modules/nixos/base/custom/services/bigdata-hadoop.nix
@@ -0,0 +1,83 @@
+{
+  config,
+  lib,
+  pkgs,
+  myvars,
+  ...
+}:
+with lib;
+let
+  cfg = config.features.bigdata_hadoop;
+in
+{
+  options = {
+    features.bigdata_hadoop = {
+      enable = mkEnableOption (lib.mdDoc "hadoop instance required by bigdata lesson");
+      package = lib.mkPackageOption pkgs "hadoop" { };
+      impermanence.enable = mkEnableOption "whether use impermanence and ephemeral root file system";
+    };
+  };
+
+  # IDK why config.environment.persistence != null do not work
+  config =
+    mkIf (cfg.enable && cfg.impermanence.enable) {
+      environment.persistence."/persistent" = {
+        users.hadoop = {
+          directories = [
+            {
+              directory = ".gnupg";
+              mode = "0700";
+            }
+            {
+              directory = ".ssh";
+              mode = "0700";
+            }
+          ];
+        };
+      };
+    }
+    // mkIf cfg.enable {
+      environment.variables = {
+        HADOOP_HOME = "${cfg.package}";
+        JAVA_HOME = "${pkgs.jdk11_headless}";
+      };
+      system.activationScripts.hadoop_init_mkdir = {
+        deps = [ "var" ];
+        text = ''
+          mkdir -p /tmp/hadoop/hadoop
+          chown hadoop:hadoop -R /tmp/hadoop/hadoop
