+          # modules.networking.mihomo.enable = true;
         }
       ];
-    home-modules = map mylib.relativeToRoot [
-      "home/hosts/linux/idols-${name}.nix"
-    ];
   };
 
   modules-niri = {
     nixos-modules = [
-      { programs.niri.enable = true; }
+      {
+        programs.niri.enable = true;
+        modules.desktop.niri.enable = true;
+      }
