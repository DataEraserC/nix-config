+{
+  lib,
+  outputs,
+  ...
+}:
+let
+  cfg = outputs.darwinConfigurations.fern.config;
+  # 实际调用一次，确保 nix-darwin 求值下 pkgs.runCommandLocal 可用
+  link = cfg.lib.file.mkOutOfStoreSymlink "/home/nixos/nix-config/home/base/outOfStoreSymlink.nix";
+in
+{
+  darwinLibFileExists = builtins.isFunction (cfg.lib.file.mkOutOfStoreSymlink or null);
+  darwinCallReturnsDrv = lib.isDerivation link;
+  darwinLinkBasename = lib.hasSuffix "outOfStoreSymlink.nix" (toString link);
+  # darwin 主机未声明池，enable 取选项默认值
+  poolEnabled = cfg.modules.outOfStoreSymlink.enable;
+}
diff --git a/outputs/aarch64-droid/default.nix b/outputs/aarch64-droid/default.nix
new file mode 100644
index 00000000..0a41ad28
--- /dev/null
+++ b/outputs/aarch64-droid/default.nix
@@ -0,0 +1,35 @@
+{
+  lib,
+  inputs,
+  ...
+}@args:
+let
+  inherit (inputs) haumea;
+
+  # Contains all the flake outputs of this system architecture.
+  data = haumea.lib.load {
+    src = ./src;
+    inputs = args;
+  };
+  # nix file names is redundant, so we remove it.
+  dataWithoutPaths = builtins.attrValues data;
+
+  # Merge all the machine's data into a single attribute set.
+  outputs = {
+    nixOnDroidConfigurations = lib.attrsets.mergeAttrsList (
+      map (it: it.nixOnDroidConfigurations or { }) dataWithoutPaths
+    );
+  };
+in
+outputs
+// {
+  inherit data; # for debugging purposes
+
+  # NixOS's unit tests.
+  evalTests = haumea.lib.loadEvalTests {
+    src = ./tests;
+    inputs = args // {
+      inherit outputs;
+    };
+  };
+}
