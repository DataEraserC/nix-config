+            if (!root.parsedFiles[resolvedPath] && root.filesToParse.indexOf(resolvedPath) === -1) {
+              root.filesToParse.push(resolvedPath);
+            }
+          }
+        }
+      }
+      root.currentLines = [];
+      root.parseNextHyprlandFile();
+    }
+  }
+
+  // ========== HYPRLAND PARSER ==========
+  function parseHyprlandConfig(text) {
