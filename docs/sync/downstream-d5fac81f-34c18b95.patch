diff --git a/modules/nixos/base/custom/ai/dsh/tui-failsafe.yml b/modules/nixos/base/custom/ai/dsh/tui-failsafe.yml
new file mode 100644
index 00000000..42759506
--- /dev/null
+++ b/modules/nixos/base/custom/ai/dsh/tui-failsafe.yml
@@ -0,0 +1,10 @@
+%YAML 1.1
+---
+# Profile-level DSH patch for nix-tui-failsafe (dsh.nix key `tui-failsafe`): rows that
+# apply only to this profile, layered above the home file
+# ($DSH_HOME/cordis.patch.yml) and below CLI overlays. Nix is the source of
+# truth: programs.dsh.patch reads this file at build time, so the managed
+# profile file is a store snapshot of it - edit here, run `just local`, then
+# restart dsh. In-place edits (Settings UI or $DSH_HOME/profiles/...) are
+# reverted to the snapshot on the next launch, by design (managed fingerprint).
+[]
diff --git a/modules/nixos/base/custom/ai/dsh/tui.yml b/modules/nixos/base/custom/ai/dsh/tui.yml
new file mode 100644
index 00000000..edce4ca2
--- /dev/null
+++ b/modules/nixos/base/custom/ai/dsh/tui.yml
@@ -0,0 +1,10 @@
