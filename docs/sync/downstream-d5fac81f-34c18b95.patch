+          apiKey = "$AGENTROUTER_API_KEY";
+          models = [
+            {
+              id = "claude-opus-4-8";
+              name = "claude-opus-4-8";
+            }
+            {
+              id = "claude-opus-5";
+              name = "claude-opus-5";
+            }
+            {
+              id = "deepseek-v4-flash";
+              name = "deepseek-v4-flash";
