+      root.currentLines = [];
+      root.parseNextNiriFile();
+    }
+  }
+
+  function parseNiriFileContent(text) {
+    var lines = text.split('\n');
+    var inBindsBlock = false;
+    var bindsBlockDepth = 0;
+    var currentCategory = null;
+    var bindsFoundInFile = 0;
