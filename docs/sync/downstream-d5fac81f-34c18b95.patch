diff --git a/modules/nixos/base/custom/ai/acb/config-merge.sh b/modules/nixos/base/custom/ai/acb/config-merge.sh
new file mode 100644
index 00000000..bab0a593
--- /dev/null
+++ b/modules/nixos/base/custom/ai/acb/config-merge.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+# Derive the bridge's effective config from the hand-written base file plus the
+# Nix-generated [notifications] fragment. The base file is never modified; an
+# existing [notifications] table wins, so a manual block is not duplicated.
+set -euo pipefail
+
+base="@BASE@"
+fragment="@FRAGMENT@"
+out="@OUT@"
+
+tmp="${out}.tmp.$$"
+trap 'rm -f "$tmp"' EXIT
+
+if grep -Eq '^[[:space:]]*\[notifications\][[:space:]]*(#.*)?$' "$base"; then
+  cat "$base" >"$tmp"
+else
+  {
+    cat "$base"
+    printf '\n'
+    cat "$fragment"
+  } >"$tmp"
+fi
+
+chmod 600 "$tmp"
+mv "$tmp" "$out"
+trap - EXIT
diff --git a/modules/nixos/base/custom/ai/acb/default.nix b/modules/nixos/base/custom/ai/acb/default.nix
new file mode 100644
index 00000000..be031f96
--- /dev/null
+++ b/modules/nixos/base/custom/ai/acb/default.nix
@@ -0,0 +1,244 @@
+{
+  config,
+  lib,
+  pkgs,
+  acb,
+  llm-agents,
+  myvars,
+  ...
+}:
+# ACB（AgentChatBridge）：桥（acbl 静态入口）。
+#
+# 模块开关与端口来自 vars/networking 的 services.acb 注册表；dsh / drivers /
+# opencode 已由 acbl 组件管理，不再由 nix-config 生成单元。本模块当前只生成
+# acb-bridge（launcher）一个 systemd --user 单元。
+# 数据在 ~/.local/share/acb；可写源码通过 modules.outOfStoreSymlink 的
+# agentChatBridge 根接入；没配置时只跳过链接，不退回 flake store。
+let
+  cfg = config.modules.acb;
+
+  home = config.users.users.${myvars.username}.home;
+  dataDir = cfg.dataDir;
+  # profile 是四个单元的稳定入口：seed 之后 current 指向一个 generation，
+  # 切换 generation 只换软链，单元文本不变。
+  profileDir = "${dataDir}/profile";
+  profileCurrent = "${profileDir}/current";
+  configFile = "${dataDir}/config/config.toml";
+  logDir = cfg.logDir;
+  userProfileBin = "/etc/profiles/per-user/${myvars.username}/bin";
+  basePath = "/run/current-system/sw/bin:${userProfileBin}:/run/wrappers/bin";
+
+  acbSrc = acb.outPath;
+  # acbl：静态入口包（launcher / supervisor / acbctl + unit 模板），进系统环境，
+  # 也是 unit 的唯一入口；它的升级不再跟随 payload 换代。
+  acblPkg = acb.packages.${pkgs.system}.acbl;
+  # payload：bridge / harnesses / start-drivers.sh / acb-contract.json，
+  # 由 acbl 的 profile 管理；nix-config 只负责把它 seed 成第一个 generation。
+  payloadPkg = acb.packages.${pkgs.system}.acb-payload;
+  # payload 收窄后不再带 lua 示例与 opencode-serve.sh；这两个是 nix-config
+  # 现有单元仍在用的过渡文件，补在 seed 源上，等它们迁到 acbl 预设后再删。
+  profileBootstrap = pkgs.runCommand "acb-profile-bootstrap" { } ''
+    mkdir -p $out
+    cp -a ${payloadPkg}/. $out/
+    chmod -R u+w $out
+    mkdir -p $out/examples
+    cp -a ${acbSrc}/examples/lua $out/examples/
+    mkdir -p $out/deploy/components/opencode
+    cp -a ${acbSrc}/deploy/components/opencode/opencode-serve.sh \
+      $out/deploy/components/opencode/opencode-serve.sh
+  '';
+
+  sourceRoot = config.modules.outOfStoreSymlink.paths.agentChatBridge or null;
+
+  # 脚本正文都在同目录的 *.sh 里，这里只替换 @NAME@ 占位符。
+  render =
+    template: values:
+    lib.replaceStrings (map (name: "@${name}@") (lib.attrNames values)) (map (
+      name: toString values.${name}
+    ) (lib.attrNames values)) (builtins.readFile template);
+
+  notificationsEnabled = cfg.notifications.topicSecret != null;
+  notificationsFragment =
+    if notificationsEnabled then
+      pkgs.writeText "acb-notifications.toml" ''
+        # Generated by nix-config for ACB out-of-band notifications.
+        [notifications]
+        url = "https://ntfy.sh"
+        topic = "''${NTFY_ACB_TOPIC}"
+        min_interval_secs = 600
+
+        # 省略字段即使用默认值：window_secs=600、room_limit=3、max_entries=256。
+        [notifications.in_band]
+      ''
+    else
+      null;
+  activeConfigFile = "${dataDir}/config/config.active.toml";
+
+  # 手写的 config.toml 是唯一真源；启用通知时只在启动前把 [notifications]
+  # 追加到派生文件，原文件不动。已有 [notifications] 时尊重手写版本。
+  configMerge =
+    if notificationsEnabled then
+      pkgs.writeShellApplication {
+        name = "acb-config-merge";
+        runtimeInputs = [
+          pkgs.coreutils
+          pkgs.gnugrep
+        ];
+        text = render ./config-merge.sh {
+          BASE = configFile;
+          FRAGMENT = notificationsFragment;
+          OUT = activeConfigFile;
+        };
+      }
+    else
+      null;
+in
+{
+  options.modules.acb = {
+    enable = lib.mkEnableOption "ACB（桥；dsh / drivers 等组件由 acbl 管理）";
+
+    host = lib.mkOption {
+      type = lib.types.str;
+      description = "dsh / 桥接入点的监听地址（来自 services.acb 注册表）。";
+    };
+
+    exposeHost = lib.mkOption {
+      type = lib.types.str;
+      default = "127.0.0.1";
+      description = "console / opencode 的对外监听地址；0.0.0.0 表示所有网卡（ZeroTier 等）。";
+    };
+
+    endpointPort = lib.mkOption {
+      type = lib.types.port;
+      description = "桥的 harness 接入端口。";
+    };
+
+    consolePort = lib.mkOption {
+      type = lib.types.port;
+      description = "桥的控制台端口。";
+    };
+
+    relayPort = lib.mkOption {
+      type = lib.types.port;
+      description = "文件中继端口。";
+    };
+
+    dataDir = lib.mkOption {
+      type = lib.types.str;
+      default = "${home}/.local/share/acb";
+      description = "ACB 的配置、状态库、agent workspace 和 opencode 状态目录。";
+    };
+
+    logDir = lib.mkOption {
+      type = lib.types.str;
+      default = "${home}/.local/state/acb";
+      description = "ACB 的日志目录。";
+    };
+
+    secretsFile = lib.mkOption {
+      type = lib.types.nullOr lib.types.str;
+      default = null;
+      description = "EnvironmentFile（600），给配置里的 \${...} 占位符提供密钥；接 agenix 后指向 secret 路径。";
+    };
+
+    notifications = {
+      topicSecret = lib.mkOption {
+        type = lib.types.nullOr lib.types.str;
+        default = null;
+        description = ''
+          ACB 带外通知（ntfy）的 topic 密钥文件，作为 acb-bridge 的 EnvironmentFile，
+          内容形如 NTFY_ACB_TOPIC=<topic>。null 表示不启用：不生成
+          [notifications] 块，也不注入额外环境。
+        '';
+      };
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    environment.systemPackages = [
+      acblPkg
+    ];
+
+    systemd.user.services = {
+      "acb-bridge" = {
+        # 用户级 unit 默认不随登录拉起；linger 已开，挂到 default.target
+        # 就能开机自启（此前只能手工 `acbctl up all`）。
+        wantedBy = [ "default.target" ];
+        unitConfig = {
+          # 单元名保留 acb-bridge（acbl 静态入口）；实际程序是 acb-launcher。
+          Description = "ACB launcher (static acbl)";
+          After = [ "network.target" ];
+          StartLimitIntervalSec = 60;
+          StartLimitBurst = 3;
+        };
+        serviceConfig = {
+          # launcher 支持 sd_notify：READY=1 + watchdog 心跳。
+          Type = "notify";
+          NotifyAccess = "main";
+          WatchdogSec = 120;
+          WorkingDirectory = dataDir;
+          Environment = [
+            "PATH=${basePath}"
+            # 适配器自有连接库的状态根：绝对路径，桥与所有组件同源继承，
+            # 不依赖各进程 CWD（kernel 的连接注入按它解析）。
+            "ACB_DATA_DIR=${dataDir}"
+            "ACB_ENDPOINT_LISTEN=${cfg.host}:${toString cfg.endpointPort}"
+            "ACB_CONSOLE_LISTEN=${cfg.exposeHost}:${toString cfg.consolePort}"
+            "ACB_RELAY_LISTEN=0.0.0.0:${toString cfg.relayPort}"
+            "ACB_LUA_DIR=${profileCurrent}/examples/lua"
+            "ACB_PROFILE_DIR=${profileDir}"
+            # profile seed 把它写进 current.json 的 args；没有它，launcher
+            # 拉起 bridge 时不会带 --config。
+            "ACB_UNIT_CONFIG_FILE=${if notificationsEnabled then activeConfigFile else configFile}"
+            # 库内密钥（secrets 表）的解密钥。文件手工创建、0600；没它 bridge
+            # 会在 preload 阶段以 78 退出，而且因为没有 LKG 会被判永久失败。
+            # 2026-11-11 重启事故：这行原来只写在本机 drop-in 里，rebuild 清掉
+            # drop-in 后整条桥起不来。
+            "ACB_KEY_FILE=${dataDir}/secrets/acb.key"
+            # 仓库根目录：组件模板里的路径是相对仓库的片段，渲染出的
+            # supervisor.toml 落在 state/supervisor/ 而**不在仓库里**，
+            # 相对路径按配置目录解析永远指不到仓库（2026-11-20：snowluma 的
+            # compose 被解析成 state/supervisor/deploy/...，容器起不来）。
+            # 没有 sourceRoot（纯 store 部署）时不注入，代码会退到 cwd。
+          ]
+          ++ lib.optionals (sourceRoot != null) [
+            "ACB_REPO_DIR=${sourceRoot}"
+          ];
+          EnvironmentFile =
+            lib.optional (cfg.secretsFile != null) "-${cfg.secretsFile}"
+            ++ lib.optional notificationsEnabled cfg.notifications.topicSecret;
+          ExecStartPre = [
+            "${pkgs.coreutils}/bin/mkdir -p ${lib.escapeShellArg dataDir} ${lib.escapeShellArg logDir}"
+          ]
+          ++ lib.optionals (sourceRoot != null) [
+            # 只保留 harnesses 的开发覆盖链接（opencode 插件路径仍指向这里）；
+            # lua 已由 profile/current/examples/lua 提供，不再另建一份。
+            "${pkgs.coreutils}/bin/ln -sfnT ${lib.escapeShellArg "${sourceRoot}/harnesses"} ${lib.escapeShellArg "${dataDir}/harnesses"}"
+          ]
+          ++ lib.optional notificationsEnabled "${configMerge}/bin/acb-config-merge"
+          ++ [
+            # payload 来自 acb-payload（store 路径），用 store 策略建 generation。
+            # seed 幂等：已有 generation 时直接跳过。
+            "${acblPkg}/bin/acbctl profile seed ${profileBootstrap} --strategy store"
+          ];
+          # 稳定入口：不写 acblPkg 的具体 store 路径，升级 acbl 不改变这一行。
+          # 不带 --config：launcher 自管 state/supervisor/supervisor.toml，
+          # 组件表也从那里读。
+          ExecStart = "/run/current-system/sw/bin/acb-launcher";
+          Restart = "on-failure";
+          RestartForceExitStatus = 75;
+          RestartPreventExitStatus = 78;
+          RestartSec = 1;
+          # 停 acbl 不连带杀 bridge；bridge 由新 acbl 启动时 adopt。
+          KillMode = "process";
+          TimeoutStopSec = "45s";
+          # $XDG_STATE_HOME/acb，systemd 在 spawn 前建好，避免日志目录被
+          # impermanence 清空后 append: 以 209/STDOUT 失败。
+          StateDirectory = "acb";
+          StandardOutput = "append:${logDir}/bridge.log";
+          StandardError = "append:${logDir}/bridge.log";
+        };
+      };
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/ai/agent-accounts.nix b/modules/nixos/base/custom/ai/agent-accounts.nix
new file mode 100644
index 00000000..fabcf916
--- /dev/null
+++ b/modules/nixos/base/custom/ai/agent-accounts.nix
@@ -0,0 +1,563 @@
+# ===============================================================================
+#
+# Agent accounts - run each AI agent / IDE with one state directory per account.
+#
+# The mechanism lives in modules/multi-instance: every app below keeps its state
+# in a path hardcoded under $HOME, and no single upstream switch covers them, so
+# each account gets a directory bind-mounted over each path. Nothing here
+# patches or wraps a package.
+#
+# Usage
+#   multi-instance <app> <account> [args...]
+#   multi-instance codebuddy-acp work
+#   multi-instance trae-cn 1
+#
+# An account always starts empty. Nothing is copied out of the app's existing
+# state under $HOME, so a plain `trae-cn` keeps its own login untouched and an
+# account never inherits it. Configuring `desktopAccounts` gives each account a
+# launcher entry (`Trae CN 1`, `Trae CN 2`, ...).
+# ===============================================================================
+{
+  config,
+  lib,
+  ...
+}:
+let
+  cfg = config.modules.agent-accounts;
+
+  codebuddyApp = {
+    executable = "codebuddy-acp";
+    stateDirectoryKey = "codebuddy";
+    paths = [
+      ".codebuddy"
+      ".local/share/CodeBuddyExtension"
+    ];
+    persist = [
+      {
+        directory = ".codebuddy";
+        mode = "0700";
+      }
+      {
+        directory = ".local/share/CodeBuddyExtension";
+        mode = "0700";
+      }
+    ];
+  };
+
+  # The one table: where each app keeps its state, which of those paths survive a
+  # tmpfs root, and how an account window is recognised by the desktop. An
+  # account is added by changing `desktopAccounts`, not this table.
+  apps = {
+    # `codebuddy-acp` is the canonical app key. The old CLI name is an alias
+    # below because WebMux launch-configs.json is seed-once; it does not create
+    # a second app/state declaration.
+    codebuddy-acp = codebuddyApp;
+
+    # Its launcher exports these paths unconditionally.
+    codearts = {
+      paths = [ ".codeartsdoer" ];
+      persist = [
+        {
+          directory = ".codeartsdoer";
+          mode = "0700";
+        }
+      ];
+    };
+
+    # The shared Tencent auth (codebuddy-acp + workbuddy) is built from os.homedir(),
+    # so no environment variable reaches it; mounting over each path redirects
+    # all of them the same way. ~/.sheetagent holds logs only and ~/WorkBuddy is
+    # an empty scaffold, so neither is preserved.
+    workbuddy = {
+      paths = [
+        ".workbuddy"
+        ".sheetagent"
+        "WorkBuddy"
+        ".local/share/CodeBuddyExtension"
+      ];
+      persist = [
+        {
+          directory = ".workbuddy";
+          mode = "0700";
+        }
+        {
+          directory = ".local/share/CodeBuddyExtension";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "WorkBuddy";
+        icon = "workbuddy";
+        wmclass = "workbuddy";
+      };
+    };
+
+    # The international build of the same app (nur-DataEraserC.workbuddy-ai). Its
+    # `dataFolderName` moves the main state to ~/.workbuddy-ai, but it still
+    # writes a device id and startup logs to ~/.workbuddy and reaches auth through
+    # ~/.local/share/CodeBuddyExtension as the CN build does, so all three are
+    # per-instance: an international account must not share state with a CN one.
+    workbuddy-ai = {
+      paths = [
+        ".workbuddy-ai"
+        ".workbuddy"
+        ".sheetagent"
+        "WorkBuddy"
+        ".local/share/CodeBuddyExtension"
+      ];
+      persist = [
+        {
+          directory = ".workbuddy-ai";
+          mode = "0700";
+        }
+        {
+          directory = ".workbuddy";
+          mode = "0700";
+        }
+        {
+          directory = ".local/share/CodeBuddyExtension";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "WorkBuddy International";
+        icon = "workbuddy-ai";
+        # The window class comes from the app's own name, which the package's
+        # rename does not change, so both builds report "workbuddy".
+        wmclass = "workbuddy";
+      };
+    };
+
+    # It overwrites --user-data-dir, so ~/.config/LobsterAI is the only profile
+    # path; ~/lobsterai is the default working directory it creates at startup.
+    # Its OpenClaw gateway keeps a startup-migration lock and state database under
+    # /tmp, which is private per instance, so no further entry is needed here.
+    lobsterai = {
+      paths = [
+        ".config/LobsterAI"
+        "lobsterai"
+      ];
+      persist = [
+        {
+          directory = ".config/LobsterAI";
+          mode = "0700";
+        }
+        "lobsterai"
+      ];
+      desktop = {
+        label = "LobsterAI";
+        icon = "lobsterai";
+        wmclass = "LobsterAI";
+      };
+    };
+
+    # Its single-instance lock is named after the user data directory, so two
+    # accounts would share one window without `userDataDir`.
+    trae-cn = {
+      paths = [
+        ".trae-cn"
+        ".config/Trae CN"
+      ];
+      userDataDir = ".config/Trae CN";
+      persist = [
+        ".trae-cn"
+        {
+          directory = ".config/Trae CN";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "Trae CN";
+        icon = "trae-cn";
+        wmclass = "Trae CN";
+      };
+    };
+
+    trae = {
+      paths = [
+        ".trae"
+        ".config/Trae"
+      ];
+      userDataDir = ".config/Trae";
+      persist = [
+        ".trae"
+        {
+          directory = ".config/Trae";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "Trae";
+        icon = "trae";
+        wmclass = "Trae";
+      };
+    };
+
+    # The CN and international editions are one AppImage (same productName, no
+    # dataFolderName), so one GUI app serves both: ~/.zcode holds CLI sessions,
+    # wiki and agent runtimes; ~/.config/ZCode is the Electron user data
+    # directory. Its single-instance lock is named after the user data
+    # directory, so two accounts would share one window without userDataDir.
+    zcode = {
+      paths = [
+        ".zcode"
+        ".config/ZCode"
+      ];
+      userDataDir = ".config/ZCode";
+      persist = [
+        {
+          # 0700 so the GUI entry collapses into the zcode-cli one below
+          # (lib.unique needs identical values); .zcode holds credentials.
+          directory = ".zcode";
+          mode = "0700";
+        }
+        {
+          directory = ".config/ZCode";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "ZCode";
+        icon = "zcode";
+        wmclass = "ZCode";
+      };
+    };
+
+    # The ACP adapter (what WebMux drives) and the vendor TUI (what a terminal
+    # runs) are separate binaries, but both instance forms share one state key
+    # so a session created through the ACP bridge can be resumed with
+    # `zcode-cli --resume` in the TUI and the other way round. Only ~/.zcode is
+    # redirected: the GUI app above owns ~/.config/ZCode. The executable
+    # defaults to the app key: the desktop package owns bin/zcode, so the CLI
+    # wrapper is the separately named zcode-cli.
+    zcode-cli = {
+      stateDirectoryKey = "zcode-cli";
+      paths = [
+        ".zcode"
+      ];
+      persist = [
+        {
+          directory = ".zcode";
+          mode = "0700";
+        }
+      ];
+    };
+
+    # The adapter's TTY dispatch makes one multi-instance entry serve both
+    # sides: under WebMux's PTY (match argv) bin/zcode-acp opens the Martty
+    # chat TUI, over plain pipes (acp argv) it falls back to the stdio ACP
+    # server. The resume entry wraps the session id into the boot-resume
+    # environment for the same instance. All three share one state key, so a
+    # session created on either side resumes on the other.
+    zcode-acp = {
+      executable = "zcode-acp";
+      stateDirectoryKey = "zcode-cli";
+      paths = [
+        ".zcode"
+      ];
+      persist = [
+        {
+          directory = ".zcode";
+          mode = "0700";
+        }
+      ];
+    };
+
+    zcode-acp-resume = {
+      executable = "zcode-acp-resume";
+      stateDirectoryKey = "zcode-cli";
+      paths = [
+        ".zcode"
+      ];
+      persist = [
+        {
+          directory = ".zcode";
+          mode = "0700";
+        }
+      ];
+    };
+
+    # Qoder has two product lines, each with a CN and an international build.
+    # The IDE stores state in ~/.qoder(-cn) + ~/.config/Qoder(CN); the Electron
+    # workbench uses ~/.qoder(-cn) + ~/.config/com.qoder(cn).app.stable. The
+    # shared ~/.qoder directory is the agent resource tree used by both
+    # products; per-app accounts still get their own copy because the app key
+    # differs.
+    qoder-ide = {
+      executable = "qoder-ide";
+      paths = [
+        ".qoder"
+        ".config/Qoder"
+      ];
+      userDataDir = ".config/Qoder";
+      persist = [
+        ".qoder"
+        {
+          directory = ".config/Qoder";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "Qoder IDE";
+        icon = "qoder-ide";
+        wmclass = "qoder-ide";
+      };
+    };
+
+    qoder = {
+      executable = "qoder";
+      stateDirectoryKey = "qoder-app";
+      paths = [
+        ".qoder"
+        ".config/com.qoder.app.stable"
+      ];
+      userDataDir = ".config/com.qoder.app.stable";
+      persist = [
+        ".qoder"
+        {
+          directory = ".config/com.qoder.app.stable";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "Qoder";
+        icon = "qoder";
+        wmclass = "qoder";
+      };
+    };
+
+    qoder-cn-ide = {
+      executable = "qoder-cn-ide";
+      stateDirectoryKey = "qoder-cn";
+      paths = [
+        ".qoder-cn"
+        ".config/QoderCN"
+      ];
+      userDataDir = ".config/QoderCN";
+      persist = [
+        ".qoder-cn"
+        {
+          directory = ".config/QoderCN";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "Qoder CN IDE";
+        icon = "qoder-cn-ide";
+        wmclass = "qoder-cn-ide";
+      };
+    };
+
+    qoder-cn = {
+      executable = "qoder-cn";
+      stateDirectoryKey = "qoder-cn-app";
+      paths = [
+        ".qoder-cn"
+        ".config/com.qodercn.app.stable"
+      ];
+      userDataDir = ".config/com.qodercn.app.stable";
+      persist = [
+        ".qoder-cn"
+        {
+          directory = ".config/com.qodercn.app.stable";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "Qoder CN";
+        icon = "qoder-cn";
+        wmclass = "qoder-cn";
+      };
+    };
+
+    # The terminal clients repeat the desktop split: the brand decides the user
+    # config root, `~/.qoder` for the international build and `~/.qoder-cn` for
+    # the CN one, and the login, the sessions under `projects`, the skills and
+    # the plugins all hang below it. Each gets its own state key, so a CLI
+    # account is independent of the desktop account that shares its directory.
+    # The `persist` items stay plain strings so they collapse into the entries
+    # above instead of declaring the same path twice.
+    qodercli = {
+      stateDirectoryKey = "qoder-cli";
+      paths = [ ".qoder" ];
+      persist = [ ".qoder" ];
+    };
+
+    qoderclicn = {
+      stateDirectoryKey = "qoder-cn-cli";
+      paths = [ ".qoder-cn" ];
+      persist = [ ".qoder-cn" ];
+    };
+
+    # The AutoClaw launchers pin XDG_CONFIG_HOME per edition; the app writes
+    # two sibling directories under it (AutoClaw plus AutoClaw-official for CN
+    # or AutoClaw-oversea-official for International), which are the per-account
+    # state.
+    autoclaw-cn = {
+      executable = "autoclaw-cn";
+      paths = [
+        ".config/autoclaw-cn/AutoClaw"
+        ".config/autoclaw-cn/AutoClaw-official"
+      ];
+      userDataDir = ".config/autoclaw-cn/AutoClaw-official";
+      persist = [
+        {
+          directory = ".config/autoclaw-cn/AutoClaw";
+          mode = "0700";
+        }
+        {
+          directory = ".config/autoclaw-cn/AutoClaw-official";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "AutoClaw CN";
+        icon = "autoclaw-cn";
+        wmclass = "AutoClaw";
+      };
+    };
+
+    autoclaw-intl = {
+      executable = "autoclaw-intl";
+      paths = [
+        ".config/autoclaw-intl/AutoClaw"
+        ".config/autoclaw-intl/AutoClaw-oversea-official"
+      ];
+      userDataDir = ".config/autoclaw-intl/AutoClaw-oversea-official";
+      persist = [
+        {
+          directory = ".config/autoclaw-intl/AutoClaw";
+          mode = "0700";
+        }
+        {
+          directory = ".config/autoclaw-intl/AutoClaw-oversea-official";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "AutoClaw";
+        icon = "autoclaw-intl";
+        wmclass = "AutoClaw";
+      };
+    };
+
+    # The profile root is ~/.config/office-raccoon: it holds userData, sessions
+    # and logs, and the app rejects it unless it is owner-only and not a
+    # symlink (multi-instance creates each state directory 0700 for that
+    # reason). ~/.box-agent is the agent home: the login (config/auth.json),
+    # model profiles, skills, run sockets and the provisioned Python/Node
+    # runtime all live there, so without it every account opens signed in as
+    # the same user. ~/RaccoonWork is the default agent workspace and
+    # ~/.openclaw / ~/.hermes are the bundled agent runtimes' homes.
+    xiaohuanxiong = {
+      paths = [
+        ".config/office-raccoon"
+        ".box-agent"
+        "RaccoonWork"
+        ".openclaw"
+        ".hermes"
+      ];
+      persist = [
+        {
+          directory = ".config/office-raccoon";
+          mode = "0700";
+        }
+        {
+          directory = ".box-agent";
+          mode = "0700";
+        }
+        "RaccoonWork"
+        {
+          directory = ".openclaw";
+          mode = "0700";
+        }
+        {
+          directory = ".hermes";
+          mode = "0700";
+        }
+      ];
+      desktop = {
+        label = "Raccoon Work";
+        icon = "raccoon-ai";
+        wmclass = "raccoon-ai";
+      };
+    };
+
+    # ~/.config/com.cmss.mobileclaw-desktop holds the config, device ID and auth
+    # token; ~/.config/MobileClaw is the Electron userData directory, whose
+    # single-instance lock is named after that path, so without `userDataDir`
+    # a second account would just hand its window to the first; and
+    # ~/Documents/MobileClaw is the default agent workspace.
+    mobileclaw = {
+      executable = "mobileclaw";
+      paths = [
+        ".config/com.cmss.mobileclaw-desktop"
+        ".config/MobileClaw"
+        "Documents/MobileClaw"
+      ];
+      userDataDir = ".config/MobileClaw";
+      persist = [
+        {
+          directory = ".config/com.cmss.mobileclaw-desktop";
+          mode = "0700";
+        }
+        {
+          directory = ".config/MobileClaw";
+          mode = "0700";
+        }
+        "Documents/MobileClaw"
+      ];
+      desktop = {
+        label = "MobileClaw";
+        icon = "mobileclaw-desktop";
+        wmclass = "MobileClaw";
+      };
+    };
+  };
+in
+{
+  options.modules.agent-accounts = {
+    enable = lib.mkEnableOption ''
+      the `multi-instance` launcher that runs the AI agents and IDEs above under
+      bubblewrap with one state directory per account
+    '';
+
+    desktopAccounts = lib.mkOption {
+      type = lib.types.attrsOf (
+        lib.types.oneOf [
+          lib.types.ints.positive
+          (lib.types.listOf lib.types.str)
+        ]
+      );
+      default = { };
+      example = {
+        workbuddy = 6;
+        lobsterai = 2;
+        trae-cn = [
+          "work"
+          "home"
+        ];
+      };
+      description = ''
+        Accounts to create a desktop launcher for, keyed by app. A number means
+        that many accounts, named "1".."N"; a list names them explicitly. Each
+        account gets one entry labelled "<app> <account>" that starts the app
+        through `multi-instance` in its own state directory. Only the GUI apps
+        have a launcher: workbuddy, workbuddy-ai, lobsterai, trae-cn, trae,
+        zcode, qoder, qoder-ide, qoder-cn, qoder-cn-ide,
+        autoclaw-cn, autoclaw-intl, xiaohuanxiong, mobileclaw.
+      '';
+    };
+  };
+
+  # Declared whether or not the launcher is enabled: the paths are facts about
+  # the apps, and their logins must survive a host that stops enabling this
+  # module.
+  config = {
+    modules.multi-instance.apps = apps;
+    modules.multi-instance.aliases.codebuddy = "codebuddy-acp";
+    modules.multi-instance.aliases.zcode-intl = "zcode";
+    modules.multi-instance.enable = cfg.enable;
+    modules.multi-instance.instances = cfg.desktopAccounts;
+  };
+}
diff --git a/modules/nixos/base/custom/ai/agent2api.nix b/modules/nixos/base/custom/ai/agent2api.nix
new file mode 100644
index 00000000..1e335200
--- /dev/null
+++ b/modules/nixos/base/custom/ai/agent2api.nix
@@ -0,0 +1,104 @@
+# ===============================================================================
+#
+# Agent2API - multi-provider subscription accounts to OpenAI/Anthropic
+# compatible API gateway, with a web management panel.
+#
+# The gateway and its provider plugins are maintained outside this repository:
+# the `agent2api-nix` flake packages the plugins (autoPatchelf'd so the native
+# ELF packs run on NixOS) and provides `services.agent2api`, including the
+# plugin sync and both systemd units. This wrapper only pins the headless
+# server package (`agent2api-server`, from the DataEraserC NUR) and maps the
+# fork's host options onto that module.
+#
+# Binds to 0.0.0.0:1108 and serves both the OpenAI-compatible API (/v1/*) and
+# the panel on that single port. The host firewall only trusts the VPN overlays
+# (tailscale/zerotier/easytier), so the panel is not exposed to the LAN; the
+# API and panel are plain HTTP, so keep a TLS reverse proxy in front when
+# reaching them from an untrusted network.
+#
+# The adminPasswordFile secret seeds the panel administrator on first start and
+# again whenever its content changes (the password is stored as a bcrypt hash,
+# so rotating the file takes effect on the next restart). The panel captcha is
+# off: the panel is reachable over the VPN only and the password is a random
+# agenix value.
+#
+# The gateway fails closed: /v1/* answers 401 until an API key is created in the
+# panel, which is the intended posture for a host that stores provider
+# credentials. State (SQLite database with accounts, API keys, request logs, and
+# the credential encryption key) lives in /var/lib/agent2api, preserved by the
+# host's impermanence setup.
+#
+# `plugins` is empty by default. Add any of
+# `inputs.agent2api-nix.packages.${system}.*` to install provider packs:
+#   agent2api-providers       - 提供商增强 (native)
+#   agent2api-web-providers   - 网页提供商 (native)
+#   agent2api-wasm-trae       - Trae (wasm)
+#   agent2api-wasm-zcode      - ZCode 国内版 (wasm)
+# `mode = "managed"` reconciles the set (and the per-provider switches) on every
+# start; `mode = "mutable"` seeds once and then leaves the plugin directory
+# alone.
+#
+# Check Service Status
+#   systemctl status agent2api
+# Check logs
+#   journalctl -u agent2api --since "2 minutes ago"
+# Read the admin password
+#   sudo cat /run/agenix/agent2api-admin-password
+{
+  config,
+  lib,
+  pkgs,
+  inputs,
+  ...
+}:
+let
+  cfg = config.modules.agent2api;
+  system = pkgs.stdenv.hostPlatform.system;
+in
+{
+  imports = [ inputs.agent2api-nix.nixosModules.default ];
+
+  options.modules.agent2api = {
+    enable = lib.mkEnableOption "Agent2API gateway";
+    port = lib.mkOption {
+      type = lib.types.port;
+      description = "Port Agent2API listens on for both the API and the panel; the host that uses this module must set it (port registry myvars.networking.services.agent2api.hosts.<machine>.port).";
+    };
+    panelPort = lib.mkOption {
+      type = lib.types.nullOr lib.types.port;
+      default = null;
+      description = "Serve the management panel on its own port instead of `port`, so only the API port has to be reachable; must differ from `port`.";
+    };
+    mode = lib.mkOption {
+      type = lib.types.enum [
+        "managed"
+        "mutable"
+      ];
+      default = "managed";
+      description = "managed reconciles the plugin set and provider switches on every start; mutable seeds once and then leaves the plugin directory alone.";
+    };
+    plugins = lib.mkOption {
+      type = lib.types.listOf lib.types.package;
+      default = [ ];
+      description = "Agent2API provider plugin packs to install; empty by default.";
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    services.agent2api = {
+      enable = true;
+      package = inputs.agent2api-nix.packages.${system}.agent2api-server;
+      inherit (cfg)
+        port
+        panelPort
+        mode
+        plugins
+        ;
+      host = "0.0.0.0";
+      adminUser = "admin";
+      adminPasswordFile = "/run/agenix/agent2api-admin-password";
+      captcha = false;
+      openFirewall = false;
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/ai/astrbot.nix b/modules/nixos/base/custom/ai/astrbot.nix
new file mode 100644
index 00000000..717b29ea
--- /dev/null
+++ b/modules/nixos/base/custom/ai/astrbot.nix
@@ -0,0 +1,405 @@
+# ===============================================================================
+#
+# AstrBot - multi-platform LLM chatbot / agent framework with a WebUI
+#           (QQ, Telegram, WeCom, Feishu, DingTalk, Slack, Discord, ...),
+#           https://github.com/AstrBotDevs/AstrBot
+#
+# Runs upstream's source tree directly under a Nix-managed Python 3.12 with a
+# per-host virtualenv - no Docker, no Compose, no `uv tool install` outside the
+# system. The unit, user, state layout, listen address and WebUI assets are all
+# declared here; only the third-party Python wheels are resolved by `uv`.
+#
+# State layout - dataDir = /var/lib/astrbot (systemd StateDirectory):
+#   /var/lib/astrbot/venv          virtualenv, built by astrbot-venv.service
+#   /var/lib/astrbot/.cache/uv     uv download cache (kept across upgrades)
+#   /var/lib/astrbot/.nix-source   store path the venv was built from (stamp)
+#   /var/lib/astrbot/data/         ASTRBOT_ROOT/data: cmd_config.json, plugins,
+#                                  plugin_data, knowledge_base, dist (WebUI)
+#
+# Why the virtualenv is provisioned at start instead of being a Nix derivation:
+#   AstrBot's 65 direct requirements pull in packages nixpkgs does not carry
+#   (aiocqhttp, qq-botpy, py-cord, wechatpy, silk-python, dingtalk-stream,
+#   xinference-client, shipyard-*-sdk, markitdown-no-magika, python-ripgrep, ...);
+#   several only ship binary wheels and upstream keeps no lock file, so every
+#   version bound floats. A buildPythonApplication port would need a hand-written
+#   derivation per missing package plus overrides for each floating bound, and it
+#   would break again the next time upstream adds a dependency. Nix therefore owns
+#   the source pin, the WebUI bundle, the interpreter, uv and the service
+#   plumbing, and `uv pip install -r requirements.txt` fills the venv once per
+#   source version. Consequences, both documented in WORKAROUNDS_downstream.md
+#   (DS-013): the first start needs network access, and the resolved wheel set is
+#   not bit-for-bit reproducible - rerun provisioning after wiping the venv if it
+#   ever drifts.
+#
+# WebUI assets: the git tree carries no built dashboard, so the release asset
+# AstrBot-v<version>-dashboard.zip is fetched with a pinned hash and unpacked as
+# data/dist, which AstrBot prefers over a (here absent) bundled dist. The asset
+# is built from the same tag, so its assets/version matches core's VERSION.
+#
+# ASTRBOT_CLI=1 disables the in-app core updater - it would try to rewrite the
+# read-only store tree. Upgrade by bumping `version` plus `srcHash` and
+# `dashboardHash` below, then redeploy; the stamp mismatch rebuilds the venv.
+#
+# The listen address is owned here: every start rewrites dashboard.host and
+# dashboard.port in data/cmd_config.json, while every other setting stays
+# WebUI-managed (AstrBot merges its defaults into the stored config itself).
+# IM adapters that open their own port (OneBot v11, webhook callbacks, ...) are
+# configured in the WebUI and need that port allowed by the host firewall - on
+# this repo's hosts the LAN and overlays are trusted wholesale, so only
+# `openFirewall` on other hosts is a concern.
+#
+# Check service status
+#   systemctl status astrbot astrbot-venv
+# Check logs (first deploy logs the generated dashboard password once)
+#   journalctl -u astrbot --since "2 minutes ago"
+# Rebuild the python environment from scratch
+#   sudo rm -rf /var/lib/astrbot/venv /var/lib/astrbot/.nix-source
+#   systemctl restart astrbot
+#
+# Two things the environment below exists for, both verified on the pinned
+# version: pip's manylinux wheels link against the host's libstdc++/zlib, which
+# NixOS has no /lib for (hence LD_LIBRARY_PATH - without it `import numpy`
+# dies with "libstdc++.so.6: cannot open shared object file"), and faiss-cpu
+# spawns OpenMP threads at import, so on a host with a tight pids/threads limit
+# (`import faiss` segfaulting, knowledge base unusable) add
+# OMP_NUM_THREADS=1 through `environment`.
+# ===============================================================================
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.astrbot;
+
+  version = "4.29.3";
+  # Bump together with `version`: `nix store prefetch-file --unpack <tarball>`
+  # for srcHash, plain `nix store prefetch-file <zip>` for dashboardHash.
+  srcHash = "sha256-cpdaLct3OBVF3lJW9rGQBQz5O0dE0z7+pz1mWGHON9I=";
+  dashboardHash = "sha256-oJ9WDEFAuTAYD2OkkpyIXagOJPubvaVmGXJ70l6YWhE=";
+
+  dataDir = "/var/lib/astrbot";
+
+  src = pkgs.fetchFromGitHub {
+    owner = "AstrBotDevs";
+    repo = "AstrBot";
+    tag = "v${version}";
+    hash = srcHash;
+  };
+
+  # Prebuilt WebUI bundle from the release page; unpacked so the derivation
+  # exposes `dist/` and can be copied to <dataDir>/data/dist.
+  dashboard =
+    pkgs.runCommand "astrbot-dashboard-${version}" { nativeBuildInputs = [ pkgs.unzip ]; }
+      ''
+        mkdir -p $out
+        unzip -q ${
+          pkgs.fetchurl {
+            url = "https://github.com/AstrBotDevs/AstrBot/releases/download/v${version}/AstrBot-v${version}-dashboard.zip";
+            hash = dashboardHash;
+          }
+        } -d $out
+      '';
+
+  # Runtime tools AstrBot shells out to: ffmpeg for the silk/voice pipeline,
+  # ripgrep and node for plugins and the agent sandbox, git for plugin installs.
+  runtimePackages = [
+    pkgs.coreutils
+    pkgs.bash
+    pkgs.ffmpeg
+    pkgs.git
+    pkgs.nodejs
+    pkgs.ripgrep
+    pkgs.uv
+  ];
+
+  # manylinux wheels dlopen libstdc++/libgomp (faiss-cpu) and zlib (pandas,
+  # pillow) from the host instead of bundling them, and NixOS has no /lib;
+  # export the Nix copies so `import faiss` and friends resolve.
+  wheelLibraryPath = lib.makeLibraryPath [
+    pkgs.stdenv.cc.cc.lib
+    pkgs.zlib
+  ];
+
+  # One-shot provisioning: venv + requirements + WebUI bundle, keyed by the
+  # source store path so an upgrade (or a wiped venv) reinstalls exactly once.
+  provision = pkgs.writeShellApplication {
+    name = "astrbot-provision";
+    runtimeInputs = runtimePackages ++ [
+      cfg.python
+      pkgs.gcc
+      pkgs.pkg-config
+    ];
+    text = ''
+      state=${lib.escapeShellArg dataDir}
+      venv="$state/venv"
+      stamp="$state/.nix-source"
+      target=${lib.escapeShellArg "${src}"}
+
+      export HOME="$state"
+      export UV_CACHE_DIR="$state/.cache/uv"
+      # Never let uv fetch its own interpreter: the version is Nix's.
+      export UV_PYTHON_DOWNLOADS=never
+      export UV_LINK_MODE=copy
+      export SSL_CERT_FILE=${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt
+      export LD_LIBRARY_PATH=${wheelLibraryPath}
+      ${lib.optionalString (cfg.packageIndex != null) ''
+        export UV_DEFAULT_INDEX=${lib.escapeShellArg cfg.packageIndex}
+      ''}
+
+      mkdir -p "$state/data" "$UV_CACHE_DIR"
+
+      if [[ -x "$venv/bin/python" && -f "$stamp" ]] && [[ "$(cat "$stamp")" == "$target" ]]; then
+        echo "astrbot: environment for $target already provisioned"
+        exit 0
+      fi
+
+      echo "astrbot: provisioning python environment from $target"
+      if [[ ! -x "$venv/bin/python" ]]; then
+        uv venv --python ${cfg.python}/bin/python3 "$venv"
+      fi
+
+      # requirements.txt holds ranges (no upstream lock file), so this resolves
+      # at first start; pip itself is one of the requirements.
+      uv pip install --python "$venv/bin/python" -r "$target/requirements.txt"
+
+      # Extras the Docker image installs by hand: a SOCKS transport for
+      # httpx[socks], the silk/pilk voice codec, and uv for the plugin
+      # installer's newer path.
+      uv pip install --python "$venv/bin/python" socksio uv pilk
+
+      # The WebUI bundle is versioned with core, so replace it wholesale. Store
+      # files arrive read-only (0555/0444), so grant the service user write
+      # access first - otherwise the rm below fails on a read-only directory
+      # and AstrBot could not update its own dashboard either.
+      if [[ -d "$state/data/dist" ]]; then
+        chmod -R u+w "$state/data/dist"
+        rm -rf "$state/data/dist"
+      fi
+      cp -r ${dashboard}/dist "$state/data/dist"
+      chmod -R u+w "$state/data/dist"
+
+      printf '%s\n' "$target" > "$stamp"
+      echo "astrbot: environment ready"
+    '';
+  };
+
+  # Declarative listen address: AstrBot only exposes dashboard.host/port through
+  # its JSON config, so seed/patch that file (merging defaults is AstrBot's job)
+  # before every start. Other keys are left untouched.
+  seedConfig = pkgs.writeShellApplication {
+    name = "astrbot-seed-config";
+    runtimeInputs = [
+      pkgs.coreutils
+      pkgs.jq
+    ];
+    text = ''
+      conf=${lib.escapeShellArg "${dataDir}/data/cmd_config.json"}
+      mkdir -p "$(dirname "$conf")"
+      if [[ ! -s "$conf" ]]; then
+        printf '{}\n' > "$conf"
+      fi
+
+      tmp="$(mktemp "$conf.XXXXXX")"
+      jq --arg host ${lib.escapeShellArg cfg.host} \
+        --argjson port ${toString cfg.port} \
+        '.dashboard = ((.dashboard // {}) + {host: $host, port: $port})' \
+        "$conf" > "$tmp"
+      mv "$tmp" "$conf"
+    '';
+  };
+in
+{
+  options.modules.astrbot = {
+    enable = lib.mkEnableOption "AstrBot multi-platform LLM chatbot (native, no Docker)";
+
+    port = lib.mkOption {
+      type = lib.types.port;
+      description = "Port the AstrBot dashboard/WebUI listens on; the host that uses this module must set it (port registry myvars.networking.services.astrbot.hosts.<machine>.port).";
+    };
+
+    host = lib.mkOption {
+      type = lib.types.str;
+      default = "0.0.0.0";
+      description = ''
+        Dashboard bind address written to dashboard.host on every start. The
+        default listens on all interfaces; the shared host firewall only trusts
+        the LAN and the overlay interfaces, so this is reachable there unless
+        the host firewall says otherwise.
+      '';
+    };
+
+    user = lib.mkOption {
+      type = lib.types.str;
+      default = "astrbot";
+      description = ''
+        Account astrbot.service and astrbot-venv.service run as. This module
+        only creates the default `astrbot` account; any other value is assumed
+        to exist already (a normal user, or one declared elsewhere), so no
+        account is generated for it. Switching after the first start needs the
+        state directory handed over: `chown -R <user>:<group> /var/lib/astrbot`.
+      '';
+    };
+
+    group = lib.mkOption {
+      type = lib.types.str;
+      default = "astrbot";
+      description = ''
+        Primary group of the service account. Created by this module only when
+        left at the default name; otherwise it must already exist. Keep it
+        group-readable if other accounts need to read the venv or the WebUI
+        bundle: StateDirectoryMode gives the group r-x.
+      '';
+    };
+
+    python = lib.mkOption {
+      type = lib.types.package;
+      default = pkgs.python312;
+      description = "Python interpreter used to build the virtualenv (upstream requires >= 3.12).";
+    };
+
+    environment = lib.mkOption {
+      type = lib.types.attrsOf lib.types.str;
+      default = { };
+      example = {
+        ASTRBOT_DASHBOARD_INITIAL_PASSWORD = "change-me";
+      };
+      description = ''
+        Extra environment variables for astrbot.service, e.g. the initial
+        dashboard password (ASTRBOT_DASHBOARD_INITIAL_PASSWORD, honoured on the
+        first deploy only) or proxy variables. Use environmentFile for secrets.
+      '';
+    };
+
+    environmentFile = lib.mkOption {
+      type = lib.types.nullOr lib.types.path;
+      default = null;
+      description = "Optional EnvironmentFile for astrbot.service (agenix secret path, kept out of the store-written unit).";
+    };
+
+    extraPackages = lib.mkOption {
+      type = lib.types.listOf lib.types.package;
+      default = [ ];
+      description = "Extra packages on astrbot.service's PATH, for plugins that shell out to system tools.";
+    };
+
+    packageIndex = lib.mkOption {
+      type = lib.types.nullOr lib.types.str;
+      default = null;
+      example = "https://pypi.tuna.tsinghua.edu.cn/simple";
+      description = ''
+        Alternative Python package index for the provisioning step (passed as
+        uv's UV_DEFAULT_INDEX). PyPI from mainland China is slow enough that the
+        first start can hit the provisioning timeout, so a mirror helps there.
+        Changing it does not re-provision by itself: wipe the venv and the stamp
+        (see the header) and restart.
+      '';
+    };
+
+    openFirewall = lib.mkOption {
+      type = lib.types.bool;
+      default = false;
+      description = ''
+        Open `port` in the host firewall for every interface. Note the shared
+        firewall module (modules/nixos/base/networking/firewall.nix) forces
+        allowedTCPPorts to [ ] and trusts the LAN/overlays by source, so this
+        only matters on hosts that do not import it.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    # Both are created only for the default names: a custom user/group is
+    # expected to come from the rest of the configuration, and managing it here
+    # would reset its attributes (isSystemUser, home, ...).
+    users.groups = lib.mkIf (cfg.group == "astrbot") {
+      astrbot = { };
+    };
+    users.users = lib.mkIf (cfg.user == "astrbot") {
+      ${cfg.user} = {
+        isSystemUser = true;
+        inherit (cfg) group;
+        home = dataDir;
+        description = "AstrBot chatbot service";
+      };
+    };
+
+    systemd.services.astrbot-venv = {
+      description = "Provision the AstrBot virtualenv from the pinned source";
+      after = [ "network-online.target" ];
+      wants = [ "network-online.target" ];
+      serviceConfig = {
+        Type = "oneshot";
+        RemainAfterExit = true;
+        User = cfg.user;
+        Group = cfg.group;
+        StateDirectory = "astrbot";
+        StateDirectoryMode = "0750";
+        WorkingDirectory = dataDir;
+        ExecStart = "${provision}/bin/astrbot-provision";
+        # First run downloads ~1GB of wheels.
+        TimeoutStartSec = "1800";
+        # No Restart: a failed install must surface in `systemctl status`, and a
+        # restart loop would hammer PyPI. Restart astrbot after fixing the cause.
+        Restart = "no";
+      };
+    };
+
+    systemd.services.astrbot = {
+      description = "AstrBot multi-platform LLM chatbot";
+      wantedBy = [ "multi-user.target" ];
+      wants = [ "network-online.target" ];
+      after = [
+        "network-online.target"
+        "astrbot-venv.service"
+      ];
+      requires = [ "astrbot-venv.service" ];
+
+      # `path` entries get /bin appended, so pass the venv root, not venv/bin.
+      path = [ "${dataDir}/venv" ] ++ runtimePackages ++ cfg.extraPackages;
+
+      environment = {
+        ASTRBOT_ROOT = dataDir;
+        # Declares a CLI-managed install: the in-app core updater refuses to run
+        # instead of writing into the read-only store tree.
+        ASTRBOT_CLI = "1";
+        HOME = dataDir;
+        LD_LIBRARY_PATH = wheelLibraryPath;
+        PYTHONPATH = "${src}";
+        PYTHONUNBUFFERED = "1";
+        SSL_CERT_FILE = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
+        XDG_CACHE_HOME = "${dataDir}/.cache";
+      }
+      // cfg.environment;
+
+      serviceConfig = {
+        Type = "simple";
+        User = cfg.user;
+        Group = cfg.group;
+        StateDirectory = "astrbot";
+        StateDirectoryMode = "0750";
+        WorkingDirectory = dataDir;
+        ExecStartPre = "${seedConfig}/bin/astrbot-seed-config";
+        ExecStart = "${dataDir}/venv/bin/python ${src}/main.py";
+        Restart = "on-failure";
+        RestartSec = 5;
+
+        # AstrBot only writes under its own state directory; everything else
+        # (store source, /etc, /home) stays read-only.
+        NoNewPrivileges = true;
+        ProtectSystem = "full";
+        ProtectHome = true;
+        # Left at the systemd default: get_astrbot_system_tmp_path() puts the
+        # agent sandbox's scratch under /tmp/.astrbot, which is also where the
+        # tools it spawns look for it.
+        PrivateTmp = false;
+      }
+      // lib.optionalAttrs (cfg.environmentFile != null) {
+        EnvironmentFile = cfg.environmentFile;
+      };
+    };
+
+    networking.firewall.allowedTCPPorts = lib.mkIf cfg.openFirewall [ cfg.port ];
+  };
+}
