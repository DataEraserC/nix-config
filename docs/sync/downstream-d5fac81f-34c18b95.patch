diff --git a/modules/nixos/base/custom/services/homepage/style.css b/modules/nixos/base/custom/services/homepage/style.css
new file mode 100644
index 00000000..81793d7d
--- /dev/null
+++ b/modules/nixos/base/custom/services/homepage/style.css
@@ -0,0 +1,372 @@
+:root {
+  color-scheme: light dark;
+  --bg: #f6f7f9;
+  --surface: #ffffff;
+  --surface-2: #eef1f4;
+  --border: #d8dde3;
+  --text: #1c2126;
+  --muted: #5c6670;
+  --accent: #2563eb;
+  --accent-soft: #dbeafe;
+  --ok: #15803d;
+  --ok-soft: #dcfce7;
+  --warn: #a16207;
+  --warn-soft: #fef3c7;
+  --off: #6b7280;
+  --off-soft: #e5e7eb;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #0f1215;
+    --surface: #171b20;
+    --surface-2: #1f252b;
+    --border: #2c333a;
+    --text: #e6eaee;
+    --muted: #9aa4ae;
+    --accent: #8ab4ff;
+    --accent-soft: #1c2c4d;
+    --ok: #7dd3a3;
+    --ok-soft: #173326;
+    --warn: #f2cf7a;
+    --warn-soft: #3a2f13;
+    --off: #9aa4ae;
+    --off-soft: #232a31;
+  }
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font-family:
+    system-ui,
+    -apple-system,
+    "Segoe UI",
+    Roboto,
+    "Noto Sans",
+    sans-serif;
+  line-height: 1.5;
+}
+
+#app {
+  max-width: 1200px;
+  margin: 0 auto;
+  padding: 24px 20px 64px;
+}
+
+.page-header {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 16px;
+  align-items: flex-end;
+  justify-content: space-between;
+  padding-bottom: 16px;
+  border-bottom: 1px solid var(--border);
+}
+
+.titles h1 {
+  margin: 0 0 4px;
+  font-size: 1.75rem;
+  letter-spacing: -0.01em;
