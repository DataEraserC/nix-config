@@ -0,0 +1,118 @@
+{
+  inputs,
+  lib,
+  outputs,
+  ...
+}:
+let
+  cfg = outputs.nixosConfigurations.ai-niri.config;
+  system = cfg.nixpkgs.hostPlatform.system;
+  dataEraserCPackages = inputs.nur-DataEraserC.legacyPackages.${system};
+  webmuxEnvironment = cfg.systemd.services.webmux.environment;
+  agent = builtins.fromJSON webmuxEnvironment.WEBMUX_ACP_AGENTS;
+  codebuddy = agent.codebuddy-acp;
+  canonicalCommands = lib.filter (
+    command:
+    builtins.length command.match == 3
+    && builtins.elemAt command.match 0 == "multi-instance"
+    && builtins.elemAt command.match 1 == "codebuddy-acp"
+  ) codebuddy.commands;
+  legacyCommands = lib.filter (
+    command:
+    command.match == [
+      "multi-instance"
+      "codebuddy"
+      "1"
+    ]
+  ) codebuddy.commands;
+  accountApp = cfg.modules.multi-instance.apps.codebuddy-acp;
+  accountAliases = cfg.modules.multi-instance.aliases;
+  stateRoot = cfg.modules.multi-instance.stateRoot;
+  directoryOf = entry: if builtins.isAttrs entry then entry.directory else entry;
+  persistedDirectories = map directoryOf accountApp.persist;
+  preservedDirectories = map directoryOf cfg.modules.multi-instance.preserveDirectories;
+  usesPinnedCodeBuddyPackage =
+    toString cfg.modules.codebuddy-acp.package == toString dataEraserCPackages.codebuddy-acp;
+  usesPinnedWebMuxPackage =
+    toString cfg.modules.webmux.package == toString dataEraserCPackages.webmux-acp;
+  codebuddyPackages = lib.filter (package: lib.hasPrefix "codebuddy" (package.pname or "")) (
+    cfg.environment.systemPackages
+  );
+  connectorTestConfig =
+    (outputs.nixosConfigurations.ai-niri.extendModules {
+      modules = [
+        {
+          modules.webmux.acpAgents.connector-test = {
+            title = "Connector Test";
+            processExecutables = [ "connector-native" ];
+            commands = [
+              {
+                match = [ "connector-agent" ];
+                acp = [ "connector-agent-acp" ];
+                resume = [ "connector-agent-resume" ];
+                connector = {
+                  executable = "connector-agent-acp";
+                  title = "Connector Agent ACP";
+                  installCommand = "install connector-agent-acp";
+                  docsUrl = "https://example.invalid/connector-agent-acp";
+                  verifiedVersion = null;
+                };
+              }
+            ];
+          };
+        }
+      ];
+    }).config;
+  connectorTestAgent = builtins.fromJSON (
+    connectorTestConfig.systemd.services.webmux.environment.WEBMUX_ACP_AGENTS
+  );
+  connectorTest = builtins.head connectorTestAgent.connector-test.commands;
+in
+{
+  module = {
+    enabled = cfg.modules.codebuddy-acp.enable;
+    package = cfg.modules.codebuddy-acp.package.pname;
+    version = cfg.modules.codebuddy-acp.package.version;
+    mainProgram = cfg.modules.codebuddy-acp.package.meta.mainProgram;
+    usesPinnedPackage = usesPinnedCodeBuddyPackage;
+    installedPackages = map (package: package.pname) codebuddyPackages;
+    oldKeyRemoved = !(builtins.hasAttr "codebuddy" cfg.modules);
+  };
+
+  multiInstance = {
+    appKeys = lib.filter (name: lib.hasInfix "codebuddy" name) (
+      lib.attrNames cfg.modules.multi-instance.apps
+    );
+    aliases = lib.filterAttrs (
+      name: canonical: lib.hasInfix "codebuddy" name || lib.hasInfix "codebuddy" canonical
+    ) accountAliases;
+    legacyAppKeyRemoved = !(builtins.hasAttr "codebuddy" cfg.modules.multi-instance.apps);
+    inherit (accountApp) executable stateDirectoryKey;
+    inherit stateRoot;
+    instanceOneStatePath = "${stateRoot}/${accountApp.stateDirectoryKey}/1";
+    paths = accountApp.paths;
+    persist = persistedDirectories;
+    preservedPaths = lib.filter (
+      path: path == stateRoot || builtins.elem path accountApp.paths
+    ) preservedDirectories;
+  };
+
+  webmux = {
+    package = cfg.modules.webmux.package.pname;
+    version = cfg.modules.webmux.package.version;
+    nurSourceRev = inputs.nur-DataEraserC.rev;
+    usesPinnedPackage = usesPinnedWebMuxPackage;
+    declarationEnvironmentKeys = lib.filter (lib.hasPrefix "WEBMUX_") (lib.attrNames webmuxEnvironment);
+    commandCount = builtins.length codebuddy.commands;
+    legacyCommandCount = builtins.length legacyCommands;
+    canonicalInstances = map (command: builtins.elemAt command.match 2) canonicalCommands;
+    connectorCommand = connectorTest;
+    agentKeys = lib.attrNames agent;
+    inherit (codebuddy)
+      title
+      icon
+      processExecutables
+      commands
+      ;
+  };
+}
diff --git a/outputs/x86_64-linux/tests/codebuddy-acp/runtime.nix b/outputs/x86_64-linux/tests/codebuddy-acp/runtime.nix
new file mode 100644
index 00000000..9782587f
--- /dev/null
+++ b/outputs/x86_64-linux/tests/codebuddy-acp/runtime.nix
@@ -0,0 +1,89 @@
+{
+  config,
+  pkgs,
+}:
+let
+  fakeCodeBuddy = pkgs.writeShellScriptBin "codebuddy-acp" ''
+    exit 0
+  '';
+  fakeCodeArts = pkgs.writeShellScriptBin "codearts" ''
+    exit 0
+  '';
+  fakeTrae = pkgs.writeShellScriptBin "trae-cn" ''
+    exit 0
+  '';
+  fakeBwrap = pkgs.writeShellScriptBin "bwrap" ''
+    set -euo pipefail
+
+    while [ "$#" -gt 0 ] && [ "$1" != -- ]; do
+      shift
+    done
+    test "$#" -ge 2
+    test "$1" = --
+    shift
+
+    case "''${BWRAP_CASE:?BWRAP_CASE must name the expected invocation}" in
+      canonical-1 | canonical-8 | legacy-1)
+        test "$#" -eq 2
+        test "$1" = ${fakeCodeBuddy}/bin/codebuddy-acp
+        test "$2" = --acp
+        ;;
+      codearts | alias-default)
+        test "$#" -eq 2
+        test "$1" = ${fakeCodeArts}/bin/codearts
+        test "$2" = --version
+        ;;
+      trae-cn)
+        test "$#" -eq 3
+        test "$1" = ${fakeTrae}/bin/trae-cn
+        test "$2" = "--user-data-dir=$MULTI_INSTANCE_ROOT/trae-cn/profile/data"
+        test "$3" = --inspect
+        ;;
+      *)
+        exit 2
+        ;;
+    esac
+
+    printf '%s\n' "$BWRAP_CASE" >> "$BWRAP_TRACE"
+  '';
+  launcher = ../../../../modules/nixos/base/custom/multi-instance/multi-instance.sh;
+in
+pkgs.runCommandLocal "codebuddy-acp-multi-instance-state-test"
+  {
+    nativeBuildInputs = [
+      pkgs.bash
+      pkgs.coreutils
+      fakeCodeBuddy
+      fakeCodeArts
+      fakeTrae
+      fakeBwrap
+    ];
+  }
+  ''
+    export HOME="$PWD/home"
+    export MULTI_INSTANCE_ROOT="$PWD/state"
+    export MULTI_INSTANCE_SPEC=${config.modules.multi-instance.specFile}
+    export BWRAP_TRACE="$PWD/bwrap.trace"
+    mkdir -p "$HOME"
+
+    BWRAP_CASE=canonical-1 ${pkgs.bash}/bin/bash ${launcher} codebuddy-acp 1 --acp
+    BWRAP_CASE=canonical-8 ${pkgs.bash}/bin/bash ${launcher} codebuddy-acp 8 --acp
+    BWRAP_CASE=legacy-1 ${pkgs.bash}/bin/bash ${launcher} codebuddy 1 --acp
+    BWRAP_CASE=codearts ${pkgs.bash}/bin/bash ${launcher} codearts default --version
+    BWRAP_CASE=alias-default ${pkgs.bash}/bin/bash ${launcher} codearts-old compat --version
+    BWRAP_CASE=trae-cn ${pkgs.bash}/bin/bash ${launcher} trae-cn profile --inspect
+
+    expected=$(printf 'canonical-1\ncanonical-8\nlegacy-1\ncodearts\nalias-default\ntrae-cn')
+    test "$(cat "$BWRAP_TRACE")" = "$expected"
+
+    test -d "$MULTI_INSTANCE_ROOT/codebuddy/1/.codebuddy"
+    test -d "$MULTI_INSTANCE_ROOT/codebuddy/1/.local/share/CodeBuddyExtension"
+    test -d "$MULTI_INSTANCE_ROOT/codebuddy/8/.codebuddy"
+    test -d "$MULTI_INSTANCE_ROOT/codebuddy/8/.local/share/CodeBuddyExtension"
+    test ! -e "$MULTI_INSTANCE_ROOT/codebuddy-acp"
+    test -d "$MULTI_INSTANCE_ROOT/codearts/default/.codeartsdoer"
+    test -d "$MULTI_INSTANCE_ROOT/codearts/compat/.codeartsdoer"
+    test ! -e "$MULTI_INSTANCE_ROOT/codearts-old"
+    test -d "$MULTI_INSTANCE_ROOT/trae-cn/profile/.config/Trae CN"
+    touch "$out"
+  ''
diff --git a/outputs/x86_64-linux/tests/dsh-home-patch/expected.nix b/outputs/x86_64-linux/tests/dsh-home-patch/expected.nix
new file mode 100644
index 00000000..b98cd4d9
--- /dev/null
+++ b/outputs/x86_64-linux/tests/dsh-home-patch/expected.nix
@@ -0,0 +1,23 @@
+{
+  # programs.dsh.patch 必须为 null：seeder 的 home 级复制以 homePatchFile != null 为条件，
+  # null 是 activation 符号链接存活的前提
+  homePatchDisabled = true;
+  # provider 行只引用 .credentials.yaml 中的环境变量，不落明文
+  ymlHasNoInlineKey = true;
+  # activationScripts.dsh-home 用 ln -sfnT 链接 home 级文件
+  activationSymlinksHomePatch = true;
+  # dsh-cua-driver 停用（DS-012：cua-driver 启动即宣告自己是屏幕阅读器，
+  # 把 org.a11y.Status.IsEnabled 翻成 true，GNOME 随即拉起 Orca）：bundle
+  # 不在任何 profile 的 bundle 列表里，$DSH_HOME/skills/cua-driver 也不再链接
+  cuaDriverBundleDisabled = true;
+  cuaDriverSkillRemoved = true;
+  # dsh-home 把 cua-cli 的两个 skill（cua-sandboxes / gui-automation）链接到
+  # $DSH_HOME/skills/，服务 mcp__cua-mcp__* 沙盒工具面（NUR cua-cli 直连）
+  skillsSymlinksCuaSandbox = true;
+  # rootless podman + 用户级 API socket：cua-vmm 的引擎入口
+  podmanEngineEnabled = true;
+  # dsh-cua-sandbox bundle 在 tui profile 的 bundle 列表里
+  sandboxBundleInProfile = true;
+  # mklinkRelativeToRoot 产出的 store 链接以 cordis.patch.yml 结尾
+  homeLinkTargetsCordisPatch = true;
+}
diff --git a/outputs/x86_64-linux/tests/dsh-home-patch/expr.nix b/outputs/x86_64-linux/tests/dsh-home-patch/expr.nix
new file mode 100644
index 00000000..8aa5b0d8
--- /dev/null
+++ b/outputs/x86_64-linux/tests/dsh-home-patch/expr.nix
@@ -0,0 +1,94 @@
+{
+  lib,
+  inputs,
+  mylib,
+  outputs,
+  ...
+}:
+let
+  cfg = outputs.nixosConfigurations.ai-niri.config;
+  yml = builtins.readFile ../../../../modules/nixos/base/custom/ai/dsh/common.yml;
+  activation = cfg.system.activationScripts.dsh-home.text;
+  homeLink = mylib.mklinkRelativeToRoot cfg "modules/nixos/base/custom/ai/dsh/common.yml";
+  # NUR 侧 cua-cli 预编译包（二进制 + skills）
+  nurCuaCli = inputs.nur-DataEraserC.packages.x86_64-linux.cua-cli;
+in
+{
+  # patch 必须保持 null：seed 脚本只在声明了 home patch（homePatchFile != null）
+  # 时才会 copy_owned_file 覆盖 $DSH_HOME/cordis.patch.yml（validate_owned_file
+  # 遇到符号链接直接 die），null 才能让 activation 的链接在每次 dsh 启动后存活。
+  homePatchDisabled = cfg.programs.dsh.patch == null;
+  # common.yml 现在只承载机器级 rows（当前为空 []，模型目录已收编进各 profile
+  # 的 <key>.yml，由 dsh-profile-patch 测试覆盖）；密钥只允许以环境变量引用
+  # 存在，不允许出现裸 apiKey: 行。
+  ymlHasNoInlineKey = !(lib.hasInfix "apiKey:" yml);
+  # activation 负责把仓库文件链接到 $DSH_HOME/cordis.patch.yml
+  activationSymlinksHomePatch =
+    lib.hasInfix "ln -sfnT" activation && lib.hasInfix "cordis.patch.yml" activation;
+  # dsh-cua-driver 停用（DS-012：cua-driver 启动时把 org.a11y.Status.IsEnabled
+  # 翻成 true，GNOME 随即拉起 Orca）。两处必须一起保持关闭：bundle 不在任何
+  # profile 的 bundle 列表里，$DSH_HOME/skills/cua-driver 也不再链接（activation
+  # 还会清掉旧 generation 留下的链接）。重新启用时两处一起恢复，把这两条断言
+  # 改回正向即可。
+  cuaDriverBundleDisabled = lib.all (
+    p: !(lib.any (n: lib.hasInfix "dsh-cua-driver" n) (map (b: b.name or "") p.bundles))
+  ) (lib.attrValues cfg.programs.dsh.profiles);
+  cuaDriverSkillRemoved = !(lib.hasInfix "cua-driver-skills" activation);
+  # dsh-cua-sandbox 的两个 skill（cua-sandboxes 工作流 + gui-automation 命令
+  # 参考）同样钉在 NUR cua-cli 的 outPath 上：技能与 bundle 的 runtimeDeps
+  # 钉同一个 store 路径，版本切换时两边一起换，不会出现"技能讲 0.6、二进制
+  # 是 0.7"的漂移。断言方式：正则里不出现带 context 的插值。
+  skillsSymlinksCuaSandbox =
+    let
+      capturedSandboxes = lib.match ".*(/nix/store/[a-z0-9]+-cua-cli-[0-9.]+)/share/cua-skills/cua-sandboxes.*" activation;
+      capturedGui = lib.match ".*(/nix/store/[a-z0-9]+-cua-cli-[0-9.]+)/share/cua-skills/gui-automation.*" activation;
+    in
+    capturedSandboxes != null
+    && builtins.head capturedSandboxes == nurCuaCli.outPath
+    && capturedGui != null
+    && builtins.head capturedGui == nurCuaCli.outPath;
+  # cua 沙盒引擎：cua-vmm 走 Podman 的 docker 兼容 API socket，
+  # $XDG_RUNTIME_DIR/podman/podman.sock 是它的 well-known 候选之一。
+  #
+  # 这对 rootless 用户单元由 nixpkgs 的 podman 模块交付，不是 dsh 模块：
+  # virtualisation.podman 用 `systemd.packages = [ cfg.package ]` 装 podman 自带的
+  # podman.socket / podman.service，又用 systemd.user.sockets.podman.wantedBy 在
+  # sockets.target 下启用。所以这里断言的是"模块开关打开后用到的引擎可用"，
+  # 而不是"dsh 模块自己拼了 unit 字符串"——后者曾是错的实现，见下。
+  #
+  # 真正会炸的是 ExecStart 重复：nixpkgs 的生成器会把 services.podman 渲染成
+  # podman.service.d/overrides.conf 这个 drop-in，一旦它也带 ExecStart，包自带的
+  # service 加上它就有两条，systemd 直接拒绝启动（"Service has more than one
+  # ExecStart= setting, which is only allowed for Type=oneshot services"）。
+  # 断言因此钉住两件事：包自带的两个 unit 确实存在（引擎真的可用），且模块
+  # 这一侧既不补 ExecStart 也不补 ListenStream（不会叠出第二条）。
+  podmanEngineEnabled =
+    let
+      podmanPkg = cfg.virtualisation.podman.package;
+      service = cfg.systemd.user.services.podman;
+      socket = cfg.systemd.user.sockets.podman;
+      # 包自带的两个 unit（rootless socket + socket-activated service）。
+      pkgUnits = [
+        "${podmanPkg}/lib/systemd/user/podman.socket"
+        "${podmanPkg}/lib/systemd/user/podman.service"
+      ];
+      # 模块这一侧不得再补 ExecStart/ListenStream：nixpkgs 会把
+      # systemd.user.services.<name> 渲染成 drop-in，与包自带 unit 相加就有两条。
+      noExecStart = (service.serviceConfig.ExecStart or null) == null;
+      noListenStream = (socket.socketConfig.ListenStream or null) == null;
+    in
+    cfg.virtualisation.podman.enable
+    && lib.all lib.pathExists pkgUnits
+    && noExecStart
+    && noListenStream
+    && socket.wantedBy == [ "sockets.target" ];
+  # dsh-cua-sandbox 必须落在 tui profile 的 bundle 列表里（mcp__cua-mcp__*
+  # 工具面的载体）：模型看得见沙盒工具，才谈得上"操持 podman sandbox"。
+  sandboxBundleInProfile =
+    let
+      names = map (b: b.name or "") cfg.programs.dsh.profiles.tui.bundles;
+    in
+    lib.any (n: lib.hasInfix "dsh-cua-sandbox" n) names;
+  # mkOutOfStoreSymlink 的 toString 是 store 路径，其名字 = 源文件 basename
+  homeLinkTargetsCordisPatch = lib.hasSuffix "common.yml" (toString homeLink);
+}
diff --git a/outputs/x86_64-linux/tests/dsh-profile-patch/expected.nix b/outputs/x86_64-linux/tests/dsh-profile-patch/expected.nix
new file mode 100644
index 00000000..e53b9fcd
--- /dev/null
+++ b/outputs/x86_64-linux/tests/dsh-profile-patch/expected.nix
@@ -0,0 +1,11 @@
+{
+  # 10 个 profile 全部挂上仓库 yml（isString，而非默认 [] 列表）。
+  allDeclareRepoPatch = true;
+
+  # 每个 profile 的 patch 与仓库文件逐字节一致（Nix 侧不注入任何行）。
+  everyProfileEqualsRepoFile = true;
+
+  # 反向锁定：没有任何 profile 自带 webserver 行——该行由 web-app bundle 提供，
+  # 本地复述会整块替换 config 并静默丢掉 tls 等未复述的键。
+  noProfileDeclaresWebserverRow = true;
+}
diff --git a/outputs/x86_64-linux/tests/dsh-profile-patch/expr.nix b/outputs/x86_64-linux/tests/dsh-profile-patch/expr.nix
new file mode 100644
index 00000000..1714c4f4
--- /dev/null
+++ b/outputs/x86_64-linux/tests/dsh-profile-patch/expr.nix
@@ -0,0 +1,41 @@
+{
+  lib,
+  outputs,
+  ...
+}:
+let
+  cfg = outputs.nixosConfigurations.ai-niri.config;
+  profiles = cfg.programs.dsh.profiles;
+  ymlDir = ../../../../modules/nixos/base/custom/ai;
+  repoPatch = key: builtins.readFile (ymlDir + "/dsh/${key}.yml");
+
+  allKeys = [
+    "tui"
+    "tui-failsafe"
+    "web"
+    "web-failsafe"
+    "web-qq"
+    "web-qq-failsafe"
+    "web-lan"
+    "web-lan-failsafe"
+    "web-qq-lan"
+    "web-qq-lan-failsafe"
+  ];
+in
+{
+  # 全部 10 个 profile 都声明了字符串型 patch（收编自 dsh/<key>.yml）；
+  # 若哪个还是默认的 [] 列表，说明漏挂了仓库文件。
+  allDeclareRepoPatch = lib.all (key: builtins.isString profiles.${key}.patch) allKeys;
+
+  # 每个 profile 的 patch 就是仓库文件原样读入：Nix 侧不再向任何档注入行。
+  # LAN 档与普通档的唯一区别是启动时的选择，不是 patch 内容。
+  everyProfileEqualsRepoFile = lib.all (key: profiles.${key}.patch == repoPatch key) allKeys;
+
+  # 反向锁定：任何 profile 都不能再自带 webserver 行。web-app bundle 已提供该行，
+  # 而 patch 对同一 id 是整块替换 config（dsh-app-boot 的 applyEntryPatches 是
+  # `target[key] = value`，不是深合并），本地再写一份会静默丢掉未复述的键——
+  # 包括 `tls`（`--tls-cert`/`--tls-key` 会失效且无报错）。
+  noProfileDeclaresWebserverRow = lib.all (
+    key: !(lib.hasInfix "id: webserver" profiles.${key}.patch)
+  ) allKeys;
+}
