+          configDir + "/keybindings.common.kdl",
+          configDir + "/keybindings.noctalia.kdl"
+        ];
+        for (var s = 0; s < standardFiles.length; s++) {
+          var sf = standardFiles[s];
+          if (!root.parsedFiles[sf] && root.filesToParse.indexOf(sf) === -1) {
