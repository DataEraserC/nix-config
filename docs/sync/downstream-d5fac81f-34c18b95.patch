+          // Category header: -- 1. NAME
+          var headMatch = line.match(/^\s*--\s*\d+\.\s*(.+?)\s*$/);
+          if (headMatch) {
+            currentCategory = headMatch[1].trim();
+            if (root.luaCategoryHeaders.indexOf(currentCategory) === -1) {
+              root.luaCategoryHeaders.push(currentCategory);
+            }
+            continue;
+          }
