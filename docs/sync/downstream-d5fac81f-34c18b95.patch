+    }
+
+    saveToDb(categories);
+    isCurrentlyParsing = false;
+    clearParsingData();
+  }
+
+  IpcHandler {
+    target: "plugin:keybind-cheatsheet"
+
+    function toggle() {
+      if (root.pluginApi) {
+        root.pluginApi.withCurrentScreen(screen => {
+          root.pluginApi.togglePanel(screen);
+        });
+      }
+    }
+
+    function refresh() {
+      root.refresh();
+    }
+  }
+}
