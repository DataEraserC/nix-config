+  color-scheme: light dark;
+  --bg: #f6f7f9;
+  --surface: #ffffff;
+  --surface-2: #eef1f4;
+  --border: #d8dde3;
+  --text: #1c2126;
+  --muted: #5c6670;
+  --accent: #2563eb;
+  --accent-soft: #dbeafe;
+  --ok: #15803d;
+  --ok-soft: #dcfce7;
+  --warn: #a16207;
+  --warn-soft: #fef3c7;
+  --off: #6b7280;
+  --off-soft: #e5e7eb;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #0f1215;
+    --surface: #171b20;
+    --surface-2: #1f252b;
+    --border: #2c333a;
+    --text: #e6eaee;
+    --muted: #9aa4ae;
+    --accent: #8ab4ff;
+    --accent-soft: #1c2c4d;
