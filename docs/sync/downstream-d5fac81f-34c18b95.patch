diff --git a/modules/nixos/base/custom/network/frp.nix b/modules/nixos/base/custom/network/frp.nix
new file mode 100644
index 00000000..93d32c32
--- /dev/null
+++ b/modules/nixos/base/custom/network/frp.nix
@@ -0,0 +1,144 @@
+# https://github.com/NixOS/nixpkgs/pull/386406
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.frp;
+  settingsFormat = pkgs.formats.toml { };
+  enabledInstances = lib.filterAttrs (name: conf: conf.enable) cfg.instances;
+in
+{
+  imports = [
+    # (lib.mkRenamedOptionModule
+    #   [ "services" "frp" "enable" ]
+    #   [ "modules" "frp" "instances" "" "enable" ]
+    # )
+    # (lib.mkRenamedOptionModule [ "services" "frp" "role" ] [ "modules" "frp" "instances" "" "role" ])
+    # (lib.mkRenamedOptionModule
+    #   [ "services" "frp" "settings" ]
+    #   [ "modules" "frp" "instances" "" "settings" ]
+    # )
+  ];
+
+  options = {
+    modules.frp = {
+      instances = lib.mkOption {
+        type = lib.types.attrsOf (
+          lib.types.submodule {
+            options = {
+              enable = lib.mkEnableOption "frp";
+
+              role = lib.mkOption {
+                type = lib.types.enum [
+                  "server"
+                  "client"
+                ];
+                description = ''
+                  The frp consists of `client` and `server`. The server is usually
+                  deployed on the machine with a public IP address, and
+                  the client is usually deployed on the machine
+                  where the Intranet service to be penetrated resides.
+                '';
+              };
+
+              settings = lib.mkOption {
+                type = settingsFormat.type;
+                default = { };
+                description = ''
+                  Frp configuration, for configuration options
+                  see the example of [client](https://github.com/fatedier/frp/blob/dev/conf/frpc_full_example.toml)
+                  or [server](https://github.com/fatedier/frp/blob/dev/conf/frps_full_example.toml) on github.
+                '';
+                example = {
+                  serverAddr = "x.x.x.x";
+                  serverPort = 7000;
+                };
+              };
+              configFile = lib.mkOption {
+                type = lib.types.nullOr (lib.types.either lib.types.str lib.types.path);
+                default = null;
+                description = "Frp configuration file";
+              };
+            };
+          }
+        );
+        default = { };
+        description = ''
+          Frp instances.
+        '';
+      };
+
+      package = lib.mkPackageOption pkgs "frp" { };
+    };
+  };
+
+  config = lib.mkIf (enabledInstances != { }) {
+    assertions = lib.mapAttrsToList (instance: options: {
+      assertion =
+        !(
+          options.enable && options.configFile != "" && options.configFile != null && options.settings != { }
+        );
+      message = "when setting ${instance}, the value of configFile is ${options.configFile}, however the value of settings is ${
+        lib.generators.toJSON { } options.settings
+      }, and cause a conflict";
+    }) enabledInstances;
+    systemd.services = lib.mapAttrs' (
+      instance: options:
+      let
+        serviceName = "frp" + lib.optionalString (instance != "") ("-" + instance);
+        configFile =
+          if options.configFile != null then
+            options.configFile
+          else
+            settingsFormat.generate "${serviceName}.toml" options.settings;
+        isClient = (options.role == "client");
+        isServer = (options.role == "server");
+        serviceCapability = lib.optionals isServer [ "CAP_NET_BIND_SERVICE" ];
+        executableFile = if isClient then "frpc" else "frps";
+      in
+      lib.nameValuePair serviceName {
+        wants = lib.optionals isClient [ "network-online.target" ];
+        after = if isClient then [ "network-online.target" ] else [ "network.target" ];
+        wantedBy = [ "multi-user.target" ];
+        description = "A fast reverse proxy frp ${options.role} for instance ${instance}";
+        serviceConfig = {
+          Type = "simple";
+          Restart = "on-failure";
+          RestartSec = 15;
+          LoadCredential = [ ("frpc_${instance}.toml:" + configFile) ];
+          ExecStart = "${cfg.package}/bin/${executableFile} --strict_config -c $\{CREDENTIALS_DIRECTORY}/frpc_${instance}.toml";
+          StateDirectoryMode = lib.optionalString isServer "0700";
+          DynamicUser = true;
+          # Hardening
+          UMask = lib.optionalString isServer "0007";
+          CapabilityBoundingSet = serviceCapability;
+          AmbientCapabilities = serviceCapability;
+          PrivateDevices = true;
+          ProtectHostname = true;
+          ProtectClock = true;
+          ProtectKernelTunables = true;
+          ProtectKernelModules = true;
+          ProtectKernelLogs = true;
+          ProtectControlGroups = true;
+          RestrictAddressFamilies = [
+            "AF_INET"
+            "AF_INET6"
+          ]
+          ++ lib.optionals isClient [ "AF_UNIX" ];
+          LockPersonality = true;
+          MemoryDenyWriteExecute = true;
+          RestrictRealtime = true;
+          RestrictSUIDSGID = true;
+          PrivateMounts = true;
+          SystemCallArchitectures = "native";
+          SystemCallFilter = [ "@system-service" ];
+        };
+      }
+    ) enabledInstances;
+  };
+
+  meta.maintainers = with lib.maintainers; [ zaldnoay ];
+}
diff --git a/modules/nixos/base/custom/network/gost-proxy.nix b/modules/nixos/base/custom/network/gost-proxy.nix
new file mode 100644
index 00000000..6effd7b7
--- /dev/null
+++ b/modules/nixos/base/custom/network/gost-proxy.nix
@@ -0,0 +1,373 @@
+# ===============================================================================
+#
+# gost - authenticated SOCKS5 + HTTP proxy, optionally chained through an
+#        upstream proxy (https://github.com/go-gost/gost, nixpkgs `gost`).
+#
+# Purpose here:
+#   - expose authenticated proxy entry points (SOCKS5 on 1080, HTTP on 1081, on
+#     every host that enables it) so a client reaches the host's
+#     intranet/overlay resources through
+#       --proxy socks5h://<user>:<pass>@<host>:1080   (curl, ssh, proxychains)
+#       --proxy http://<user>:<pass>@<host>:1081      (browsers, npm, git, ...)
+#   - chain one listener through another host's proxy, e.g. wsl-work:31080/31081
+#     forward through idols-ai:1080, so a client using them reaches idols-ai's
+#     LOOPBACK services (the final hop resolves 127.0.0.1 on idols-ai itself) -
+#     i.e. the dsh GUI on idols-ai 127.0.0.1:3080:
+#
+#       client -> wsl-work:31081 (auth) -> idols-ai:1080 (auth) -> 127.0.0.1:3080
+#
+# Why an HTTP listener as well: browsers do not speak authenticated SOCKS5 -
+# Chrome/Chromium/Edge/Safari cannot send a SOCKS username/password at all
+# (Firefox only via about:config) - while all of them speak an HTTP proxy and
+# answer a 407 with a Basic `Proxy-Authorization` prompt. `protocol` selects the
+# wire protocol per instance; the chain connector stays SOCKS5 regardless,
+# because gost converts between the listener protocol and the hop.
+#
+# `protocol = "auto"` is available (gost routes SOCKS4/SOCKS5/HTTP by the first
+# bytes) but NOT recommended on an entry point: the auto handler also treats a
+# bare TLS ClientHello as a transparent SNI proxy, on a path that runs BEFORE
+# authentication (go-gost/x handler/auto/handler.go, handleTLS), so the port
+# would double as an unauthenticated TLS proxy. Prefer an explicit
+# `socks5`/`http` listener.
+#
+# Browser setup - the reason the HTTP listeners exist:
+#   - Chromium/Chrome: `--proxy-server=http://<host>:1081`; the credential
+#     prompt appears once per session (Chromium strips user:pass from a proxy
+#     URL, so the credentials cannot be embedded there).
+#   - Firefox: HTTP proxy host/port, or `http://<user>:<pass>@<host>:1081`.
+#   - Both bypass localhost/127.0.0.1 implicitly - clear that bypass when the
+#     TARGET is a remote loopback service (the dsh GUI): Chromium
+#     `--proxy-bypass-list="<-loopback>"`, Firefox emptied "No proxy for".
+#
+# Authentication is MANDATORY and shared: every listener enforces auth via a
+# gost `auther` reading the agenix secret "gost-proxy.auth" (a single
+# space-separated `<username> <password>` line; identical on every host so one
+# client config works everywhere), and a chained hop sends the same credentials
+# to its upstream with `connector.auth`. Both are file loaders with a reload
+# interval, so an agenix re-encryption is picked up without a restart, and a
+# missing file fails CLOSED (every request is rejected until agenix writes it).
+#
+# One systemd unit (gost-proxy) runs every ACTIVE instance of the host from one
+# JSON config built with builtins.toJSON - the schema is fixed, nothing is
+# generated at runtime. An instance with `enable = false` (and a host whose
+# instances are all disabled) is left out of that config, so the unit is not
+# started at all: that is how a listener is retired without deleting its
+# declaration - or the port another host's `chainUpstream` points at.
+#
+# Instance keys are `<destination-host>-<protocol>` - idols-ai-socks5,
+# idols-ai-http, wsl-work-http - naming the host whose network the entry point
+# resolves on plus the protocol the client speaks. The same key therefore means
+# the same destination on every machine (direct on that host, chained through
+# it elsewhere), and it is the gost service/chain name that shows up in the
+# journal.
+#
+# Exposure: instances bind address (default 0.0.0.0) and rely on the host
+# firewall's trustedInterfaces (easytier/tailscale/zerotier) for reachability;
+# openFirewall additionally allows the port on EVERY interface (e. the campus
+# LAN). Keep it off unless needed - proxy credentials travel in clear text on
+# an unencrypted LAN hop.
+#
+# Retrieve the credentials (from the secrets/ directory, interactive):
+#   agenix -d -i ~/.ssh/id_ed25519 ./agenix/gost-proxy.auth.age
+# Check service status / logs:
+#   systemctl status gost-proxy
+#   journalctl -u gost-proxy --since "2 minutes ago"
+# Smoke-test a local listener (substitute the decrypted credentials):
+#   curl --proxy socks5h://<user>:<pass>@127.0.0.1:1080 http://example.com
+#   curl --proxy http://<user>:<pass>@127.0.0.1:1081 http://example.com
+# ===============================================================================
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.gost-proxy;
+
+  # Both the listener auther and the chained hop's connector read this one
+  # agenix secret. `or (throw ...)` yields a readable eval error when the host
+  # enables gost-proxy without declaring the secret (secrets/nixos_agenix.nix).
+  authPath =
+    config.age.secrets."gost-proxy.auth".path or (throw ''
+      modules.gost-proxy.enable requires the agenix secret "gost-proxy.auth" -
+      import secrets/nixos_agenix.nix with modules.secrets.desktop.enable = true.
+    '');
+
+  autherName = "gost-auth";
+  chainName = name: "chain-${name}";
+
+  # Instances that are actually deployed (`enable = false` pins a declaration
+  # in place while its listener is retired). Everything below - services,
+  # chains, firewall ports, uniqueness assertions - is derived from these, so a
+  # disabled instance cannot conflict with an active one on the same port and
+  # disappears from the gost config entirely.
+  activeInstances = lib.filterAttrs (_: inst: inst.enable) cfg.instances;
+
+  instanceModule =
+    { name, ... }:
+    {
+      options = {
+        enable = lib.mkOption {
+          type = lib.types.bool;
+          default = true;
+          description = ''
+            Whether this listener is deployed. `false` keeps the declaration -
+            and the port the registry documents and a chained host's
+            `chainUpstream` points at - but emits no service, no chain and no
+            firewall port, and drops it from the gost config. Use it to retire
+            a listener without deleting the entry; with every instance disabled
+            the host runs no gost process at all.
+          '';
+        };
+
+        port = lib.mkOption {
+          type = lib.types.port;
+          description = "TCP port the listener of this instance (SOCKS5 or HTTP) binds.";
+        };
+
+        protocol = lib.mkOption {
+          type = lib.types.enum [
+            "socks5"
+            "http"
+            "auto"
+          ];
+          default = "socks5";
+          description = ''
+            Wire protocol of the listener.
+            - "socks5": authenticated SOCKS5. For SOCKS-aware clients only -
+              browsers cannot send credentials over SOCKS5 (Chromium not at
+              all, Firefox through about:config).
+            - "http": HTTP proxy - CONNECT for https, absolute-form requests for
+              http - authenticated with Basic `Proxy-Authorization`, which every
+              browser supports. This is the browser-facing twin of "socks5".
+            - "auto": gost guesses SOCKS4/SOCKS5/HTTP from the first bytes. Not
+              recommended here: the auto handler also serves a bare TLS
+              ClientHello as a transparent SNI proxy and that path is NOT
+              authenticated (go-gost/x handler/auto/handler.go, handleTLS).
+          '';
+        };
+
+        address = lib.mkOption {
+          type = lib.types.str;
+          default = "0.0.0.0";
+          description = ''
+            Bind address of the listener. The default listens on all
+            interfaces, but the host firewall only exposes it on
+            trustedInterfaces (easytier/tailscale/zerotier) unless
+            openFirewall is set - bind `127.0.0.1` to keep it strictly local.
+          '';
+        };
+
+        chainUpstream = lib.mkOption {
+          type = lib.types.nullOr lib.types.str;
+          default = null;
+          example = "10.126.126.150:1080";
+          description = ''
+            Optional upstream proxy (`host:port`) this instance chains
+            through: the listener itself requires auth, then forwards every
+            client connection to the upstream with the same credentials, and
+            the upstream resolves the destination on ITS side - that is how a
+            chained instance reaches the upstream host's loopback services
+            (e.g. wsl-work:31080 -> idols-ai:1080 -> 127.0.0.1:3080 for dsh).
+            The hop speaks whatever `chainProtocol` says, independent of this
+            listener's `protocol` (gost converts between the two), so an HTTP
+            listener can chain through the upstream's SOCKS5 port.
+            null (default) makes it a plain local proxy.
+          '';
+        };
+
+        chainProtocol = lib.mkOption {
+          type = lib.types.enum [
+            "socks5"
+            "http"
+          ];
+          default = "socks5";
+          description = ''
+            Protocol the chained hop uses to reach `chainUpstream` - it has to
+            match the upstream instance's `protocol`. Defaults to "socks5",
+            the protocol of the `proxy` listeners here; set "http" when the
+            upstream listener you chain through is an HTTP one.
+          '';
+        };
+
+        openFirewall = lib.mkOption {
+          type = lib.types.bool;
+          default = false;
+          description = ''
+            Open `port` in the host firewall for every interface, not just the
+            trusted overlay interfaces. Only enable when a client that is
+            outside every overlay must connect directly - proxy username/
+            password auth travels in clear text on a plain LAN hop.
+          '';
+        };
+      };
+    };
+
+  # One gost service (listener) per instance: mandatory auther, plus a chain
+  # reference when the instance forwards to an upstream.
+  mkService = name: inst: {
+    inherit name;
+    addr = "${inst.address}:${toString inst.port}";
+    handler = {
+      type = inst.protocol;
+      auther = autherName;
+    }
+    // lib.optionalAttrs (inst.chainUpstream != null) {
+      chain = chainName name;
+    };
+    listener = {
+      type = "tcp";
+    };
+  };
+
+  # One chain per chained instance: a single hop whose connector authenticates
+  # against the upstream with the same agenix credentials (credentials live in
+  # `connector.auth`, a plain { username, password } sibling is NOT accepted).
+  mkChain = name: inst: {
+    name = chainName name;
+    hops = [
+      {
+        name = "hop";
+        nodes = [
+          {
+            name = "upstream";
+            addr = inst.chainUpstream;
+            connector = {
+              type = inst.chainProtocol;
+              auth = {
+                file = authPath;
+              };
+            };
+            dialer = {
+              type = "tcp";
+            };
+          }
+        ];
+      }
+    ];
+  };
+
+  chainedInstances = lib.filterAttrs (_: inst: inst.chainUpstream != null) activeInstances;
+
+  # Static config for `gost -C`: authers (listener side) + services + chains
+  # (upstream side), both pointing at the same decrypted secret file.
+  gostConfig = {
+    authers = [
+      {
+        name = autherName;
+        file = {
+          path = authPath;
+          reload = "5s";
+        };
+      }
+    ];
+    services = lib.mapAttrsToList mkService activeInstances;
+  }
+  // lib.optionalAttrs (lib.length (lib.attrNames chainedInstances) > 0) {
+    chains = lib.mapAttrsToList mkChain chainedInstances;
+  };
+
+  configFile = pkgs.writeText "gost-proxy.json" (builtins.toJSON gostConfig);
+
+  listenAddrs = lib.mapAttrsToList (_: inst: "${inst.address}:${toString inst.port}") activeInstances;
+  listenPorts = lib.mapAttrsToList (_: inst: inst.port) activeInstances;
+in
+{
+  options.modules.gost-proxy = {
+    enable = lib.mkEnableOption ''
+      gost SOCKS5/HTTP proxy with mandatory authentication (agenix secret
+      "gost-proxy.auth"), optionally chained through another host's proxy
+    '';
+
+    instances = lib.mkOption {
+      type = lib.types.attrsOf (lib.types.submodule instanceModule);
+      default = { };
+      example = {
+        # the local host's own entry points ...
+        wsl-work-socks5 = {
+          port = 1080;
+        };
+        wsl-work-http = {
+          port = 1081;
+          protocol = "http";
+        };
+        # ... plus one chained through another host's listener
+        idols-ai-socks5 = {
+          port = 31080;
+          chainUpstream = "10.126.126.150:1080";
+        };
+      };
+      description = ''
+        The gost listeners of this host, keyed by instance name (used for the
+        service and chain names). Each entry is one authenticated listener of
+        its own `protocol` (SOCKS5 or HTTP) on its own port; `chainUpstream`
+        turns it into a forwarder to another host's proxy, and `enable = false`
+        retires a listener while keeping its declaration. Without any instance
+        the enable flag is a configuration bug and fails the eval.
+
+        Name an instance `<destination-host>-<protocol>` - `idols-ai-socks5`,
+        `idols-ai-http`, `wsl-work-http` - where the host is the one whose
+        network the entry point resolves on. The same name then means the same
+        destination and protocol on every host (directly on that host, chained
+        through it elsewhere), and gost's own service/chain names in the
+        journal stay self-describing.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    # An enabled module with no declared instance is a config bug (nothing
+    # would ever be served); two ACTIVE instances on the same address:port
+    # would make gost fail at runtime - also a config bug. Disabled instances
+    # bind nothing, so they are exempt from the uniqueness checks.
+    assertions = [
+      {
+        assertion = lib.length (lib.attrNames cfg.instances) > 0;
+        message = "modules.gost-proxy.enable requires at least one entry in modules.gost-proxy.instances (e. instances.idols-ai-socks5.port = 1080)";
+      }
+      {
+        assertion = lib.length listenAddrs == lib.length (lib.unique listenAddrs);
+        message = "modules.gost-proxy.instances: every instance needs a unique address:port, got ${lib.concatStringsSep ", " listenAddrs}";
+      }
+      {
+        assertion = lib.length listenPorts == lib.length (lib.unique listenPorts);
+        message = "modules.gost-proxy.instances: every instance needs a unique port, got ${
+          lib.concatMapStringsSep ", " toString listenPorts
+        }";
+      }
+    ];
+
+    # openFirewall widens exposure beyond trustedInterfaces; the credentials
+    # are the only gate then (and travel unencrypted on a plain LAN hop).
+    networking.firewall.allowedTCPPorts = lib.concatMap (
+      inst: lib.optional inst.openFirewall inst.port
+    ) (lib.attrValues activeInstances);
+
+    # No active instance = nothing to serve: skip the unit entirely instead of
+    # starting a gost process with an empty service list.
+    systemd.services.gost-proxy = lib.mkIf (activeInstances != { }) {
+      description = "gost authenticated proxy (SOCKS5/HTTP, optionally chained)";
+      wantedBy = [ "multi-user.target" ];
+      after = [ "network-online.target" ];
+      wants = [ "network-online.target" ];
+      serviceConfig = {
+        ExecStart = "${lib.getExe pkgs.gost} -C ${configFile}";
+        Restart = "on-failure";
+        RestartSec = "3s";
+        # hardening - gost only needs the config in /nix/store, the agenix
+        # secret in /run/agenix and outbound sockets; it writes nothing.
+        NoNewPrivileges = true;
+        ProtectSystem = "strict";
+        ProtectHome = true;
+        PrivateTmp = true;
+        ProtectKernelTunables = true;
+        ProtectKernelModules = true;
+        ProtectControlGroups = true;
+        RestrictSUIDSGID = true;
+        LockPersonality = true;
+        SystemCallArchitectures = "native";
+      };
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/network/port-forwarding.nix b/modules/nixos/base/custom/network/port-forwarding.nix
new file mode 100644
index 00000000..2c1e6083
--- /dev/null
+++ b/modules/nixos/base/custom/network/port-forwarding.nix
@@ -0,0 +1,210 @@
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.port-forwarding;
+
+  tunnelOpts = lib.types.submodule {
+    options = {
+      name = lib.mkOption {
+        type = lib.types.str;
+        description = "Name of the tunnel (used for systemd service name)";
+      };
+      localPort = lib.mkOption {
+        type = lib.types.port;
+        description = "Local port to listen on";
+      };
+      listenAddress = lib.mkOption {
+        type = lib.types.nullOr lib.types.str;
+        default = null;
+        example = "0.0.0.0";
+        description = ''
+          socat implementation only: local address to listen on. Unset keeps the
+          safe `127.0.0.1` default. `0.0.0.0` listens on every interface, and an
+          address owned by a tunnel interface restricts the listener to that
+          overlay. An IPv6 literal selects the IPv6 listener automatically.
+        '';
+      };
+      matchAddress = lib.mkOption {
+        type = lib.types.nullOr lib.types.str;
+        default = null;
+        example = "10.126.126.150";
+        description = ''
+          nftables implementation only: destination address the DNAT rule
+          matches. Unset matches every destination address. Use `listenAddress`
+          for the socat implementation.
+        '';
+      };
+      remoteHost = lib.mkOption {
+        type = lib.types.str;
+        description = "Remote host IP address";
+      };
+      remotePort = lib.mkOption {
+        type = lib.types.port;
+        description = "Remote port to forward to";
+      };
+    };
+  };
+
+  isIPv6 = address: lib.hasInfix ":" address;
+
+  # The nftables ruleset is an IPv4 table, so a numeric in-range literal is the
+  # only address shape that implementation can express.
+  isIPv4Literal =
+    address:
+    let
+      octets = lib.splitString "." address;
+    in
+    lib.length octets == 4
+    && lib.all (octet: builtins.match "[0-9]+" octet != null && lib.toInt octet <= 255) octets;
+
+  looksNumeric = address: builtins.match "[0-9.]+" address != null;
+
+  # Inputs the IPv4 nftables ruleset certainly cannot express: an IPv6 literal, or
+  # a numeric literal that is malformed. Either one makes nft reject the whole
+  # ruleset, so these fail the build rather than the boot.
+  unsupportedByNftables = address: isIPv6 address || (looksNumeric address && !isIPv4Literal address);
+
+  # A hostname may load, but only because nft resolves it once at load time.
+  isHostname = address: !looksNumeric address && !isIPv6 address;
+
+  # A listening socket takes the bare address, and socat resolves one address in
+  # a single protocol family: `TCP-LISTEN` rejects an IPv6 literal outright.
+  socatListenSpec =
+    tunnel:
+    let
+      address = if tunnel.listenAddress == null then "127.0.0.1" else tunnel.listenAddress;
+    in
+    "${
+      if isIPv6 address then "TCP6-LISTEN" else "TCP-LISTEN"
+    }:${toString tunnel.localPort},fork,reuseaddr,bind=${address}";
+
+  # A remote IPv6 host needs brackets because the address itself contains the
+  # `host:port` separator.
+  socatRemoteSpec =
+    tunnel:
+    if isIPv6 tunnel.remoteHost then
+      "TCP6:[${tunnel.remoteHost}]:${toString tunnel.remotePort}"
+    else
+      "TCP:${tunnel.remoteHost}:${toString tunnel.remotePort}";
+
+  listenAddressOf =
+    tunnel: if tunnel.listenAddress == null then "127.0.0.1" else tunnel.listenAddress;
+
+  mkSocatService =
+    tunnel:
+    let
+      serviceName = "port-forward-${tunnel.name}";
+    in
+    {
+      ${serviceName} = {
+        description = "Port forwarding: ${tunnel.name} (${listenAddressOf tunnel}:${toString tunnel.localPort} -> ${tunnel.remoteHost}:${toString tunnel.remotePort})";
+        after = [ "network-online.target" ];
+        wants = [ "network-online.target" ];
+        serviceConfig = {
+          ExecStart = "${pkgs.socat}/bin/socat ${socatListenSpec tunnel} ${socatRemoteSpec tunnel}";
+          Restart = "always";
+          RestartSec = 5;
+        };
+        wantedBy = [ "multi-user.target" ];
+      };
+    };
+
+  # The nftables table is IPv4 (`table ip nat`), so this implementation carries
+  # no IPv6 form.
+  mkNftablesRule =
+    tunnel:
+    "${
+      lib.optionalString (tunnel.matchAddress != null) "ip daddr ${tunnel.matchAddress} "
+    }tcp dport ${toString tunnel.localPort} dnat to ${tunnel.remoteHost}:${toString tunnel.remotePort}";
+
+  nftablesRuleset = lib.concatStringsSep "\n" (map mkNftablesRule cfg.tunnels);
+in
+{
+  options.modules.port-forwarding = {
+    enable = lib.mkEnableOption "port forwarding services";
+
+    implementation = lib.mkOption {
+      type = lib.types.enum [
+        "socat"
+        "nftables"
+      ];
+      default = "socat";
+      description = ''
+        Implementation method:
+        - socat: userspace TCP forwarding (safe, no firewall side effects)
+        - nftables: kernel-level DNAT forwarding (more efficient, but may affect
+          firewall; IPv4 only)
+      '';
+    };
+
+    tunnels = lib.mkOption {
+      type = lib.types.listOf tunnelOpts;
+      default = [ ];
+      description = "List of port forwarding tunnels to create";
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    assertions = [
+      {
+        assertion =
+          cfg.implementation == "socat" || lib.all (tunnel: tunnel.listenAddress == null) cfg.tunnels;
+        message = "modules.port-forwarding: `tunnels.*.listenAddress` configures the socat listener, but `implementation` is \"nftables\". Set `matchAddress` instead, or switch `implementation` to \"socat\".";
+      }
+      {
+        assertion =
+          cfg.implementation == "nftables" || lib.all (tunnel: tunnel.matchAddress == null) cfg.tunnels;
+        message = "modules.port-forwarding: `tunnels.*.matchAddress` configures the nftables DNAT match, but `implementation` is \"socat\". Set `listenAddress` instead, or switch `implementation` to \"nftables\".";
+      }
+      {
+        assertion =
+          cfg.implementation == "socat"
+          || lib.all (
+            tunnel: tunnel.matchAddress == null || !unsupportedByNftables tunnel.matchAddress
+          ) cfg.tunnels;
+        message = "modules.port-forwarding: the nftables ruleset is an IPv4 table (`table ip nat`), so `tunnels.*.matchAddress` cannot be an IPv6 address or a malformed IPv4 literal; nft rejects the whole ruleset. Use the socat implementation to match IPv6.";
+      }
+      {
+        assertion =
+          cfg.implementation == "socat"
+          || lib.all (tunnel: !unsupportedByNftables tunnel.remoteHost) cfg.tunnels;
+        message = "modules.port-forwarding: the nftables ruleset is an IPv4 table (`table ip nat`), so `tunnels.*.remoteHost` cannot be an IPv6 address or a malformed IPv4 literal; nft rejects the whole ruleset. Use the socat implementation to forward to IPv6.";
+      }
+    ];
+
+    # A hostname is resolved once when the kernel ruleset loads, so a DNS change
+    # or a boot without DNS silently freezes or breaks the tunnel.
+    warnings =
+      lib.optional
+        (
+          cfg.implementation == "nftables"
+          && lib.any (
+            tunnel:
+            (tunnel.matchAddress != null && isHostname tunnel.matchAddress) || isHostname tunnel.remoteHost
+          ) cfg.tunnels
+        )
+        "modules.port-forwarding: an nftables address hostname is resolved once at ruleset load time, so a DNS change or a boot without DNS silently freezes or breaks the tunnel; prefer a numeric address.";
+
+    # socat implementation (default)
+    systemd.services = lib.mkIf (cfg.implementation == "socat") (
+      lib.mkMerge (map mkSocatService cfg.tunnels)
+    );
+
+    # nftables implementation (optional)
+    networking.nftables = lib.mkIf (cfg.implementation == "nftables") {
+      enable = true;
+      ruleset = ''
+        table ip nat {
+          chain prerouting {
+            type nat hook prerouting priority dstnat;
+            ${nftablesRuleset}
+          }
+        }
+      '';
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/network/proxychains.nix b/modules/nixos/base/custom/network/proxychains.nix
new file mode 100644
index 00000000..adbd2e3b
--- /dev/null
+++ b/modules/nixos/base/custom/network/proxychains.nix
@@ -0,0 +1,86 @@
+# proxychains - route CLI traffic through the local / LAN SOCKS proxies.
+#
+# Moved out of the shared desktop snippet into a proper module; the proxy list
+# is host-agnostic (localhost + tailscale/zerotier peers), so any host can opt
+# in with `modules.proxychains.enable = true`.
+{ config, lib, ... }:
+let
+  cfg = config.modules.proxychains;
+in
+{
+  options.modules.proxychains.enable = lib.mkEnableOption "proxychains with the shared SOCKS proxy list (chains through localhost clash/throne and LAN peers)";
+
+  config = lib.mkIf cfg.enable {
+    programs.proxychains = {
+      chain.type = "dynamic";
+      enable = true;
+      proxies = {
+        # local
+        localhost_clash_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "127.0.0.1";
+          port = 7890;
+        };
+        localhost_throne_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "127.0.0.1";
+          port = 2080;
+        };
+        # mondrian
+        mondrian_tailscale_nekobox_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "100.95.92.151";
+          port = 2080;
+        };
+        mondrian_zerotier_nekobox_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "10.147.20.151";
+          port = 2080;
+        };
+        # pstar
+        pstar_tailscale_nekobox_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "100.95.92.153";
+          port = 2080;
+        };
+        pstar_zerotier_nekobox_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "10.147.20.153";
+          port = 2080;
+        };
+        # infiniti
+        infiniti_tailscale_nekobox_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "100.95.92.154";
+          port = 2080;
+        };
+        infiniti_zerotier_nekobox_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "10.147.20.154";
+          port = 2080;
+        };
+        # y9000p2025
+        y9000p2025_tailscale_clash_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "100.95.92.150";
+          port = 7897;
+        };
+        y9000p2025_zerotier_clash_proxy = {
+          enable = true;
+          type = "socks5";
+          host = "10.147.20.150";
+          port = 7897;
+        };
+      };
+    };
+  };
+}
diff --git a/modules/nixos/base/custom/network/sub-store/default.nix b/modules/nixos/base/custom/network/sub-store/default.nix
new file mode 100644
index 00000000..1074ccf1
--- /dev/null
+++ b/modules/nixos/base/custom/network/sub-store/default.nix
@@ -0,0 +1,425 @@
+# ===============================================================================
+#
+# Sub-Store - advanced subscription manager (https://github.com/sub-store-org/Sub-Store).
+#
+# Purpose here: dae cannot parse Clash-YAML subscriptions, so dae is pointed at
+#   http://127.0.0.1:<port>/download/<name>/v2ray
+# which Sub-Store converts into a base64 list of v2ray URIs (the format dae accepts).
+# The upstream Clash links are registered once via POST /api/subs (see below).
+#
+# Uses the nixpkgs package (pkgs.sub-store, bundled backend; no frontend assets).
+# Data lives in /var/lib/sub-store (root.json + <name>.json - SUB_STORE_DATA_BASE_PATH):
+#   systemd StateDirectory, so it survives service restarts, reboots and nixos-rebuild
+#   (only RuntimeDirectory would be volatile). Files are written mode 0600 (UMask 0077).
+#
+# Web panel (modules.sub-store.frontend.enable, default on):
+#   Serves the official Sub-Store PWA (Sub-Store-Front-End release) from the same
+#   service on <frontend.port> (default http://127.0.0.1:24501/). The release's
+#   code-level default backend (https://sub.store) is rewritten at build time to
+#   derive from location.hostname at runtime, so the API is always called on the
+#   same host the panel page was opened with - independent of what cfg.host
+#   binds (idols-ai overrides host to 0.0.0.0). With auth.enable Caddy serves the
+#   panel and /api/* on frontend.port, so the call stays same-origin (no CORS
+#   preflight can meet the password prompt); otherwise it uses cfg.port as before.
+#   Settings > Custom Backend API can still override it.
+#
+# Authentication (modules.sub-store.auth.enable, off by default):
+#   Sub-Store has no built-in auth, so the module can front the API and the panel
+#   with a Caddy reverse proxy enforcing Basic Auth (htpasswd lines in auth.file).
+#   Sub-Store then binds loopback-internal ports while Caddy holds the public
+#   ones. Passwordless on purpose: loopback clients (dae, the local panel) and
+#   every GET /download/* - subscription links stay direct links for any client.
+#   Password: the panel page and the remaining management API, remotely.
+#   The panel site doubles as the panel's API origin: Caddy routes /api/* and
+#   /download/* on frontend.port to the backend and everything else to the
+#   static frontend, so the browser never sends a cross-origin (preflighted)
+#   request to the authenticated API - it replays the page's credentials.
+#   Without auth.enable the legacy model applies: loopback-only default bind, or
+#   a wider bind guarded solely by the host firewall (see openFirewall).
+#
+# Check Service Status
+#   systemctl status sub-store
+# Check logs
+#   journalctl -u sub-store --since "2 minutes ago"
+# Register an upstream subscription (once)
+#   curl -X POST http://127.0.0.1:24500/api/subs -H 'Content-Type: application/json' \
+#     -d '{"name":"ikuuu","url":"https://example.com/sub?token=xxx"}'
+# ===============================================================================
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  cfg = config.modules.sub-store;
+  dataDir = "/var/lib/sub-store";
+
+  # Official web panel (PWA). Keep the version aligned with pkgs.sub-store - both
+  # follow the upstream release train, so 2.22.1 pairs with backend 2.22.26.
+  frontendVersion = "2.22.1";
+  frontendRelease = pkgs.fetchzip {
+    url = "https://github.com/sub-store-org/Sub-Store-Front-End/releases/download/${frontendVersion}/dist.zip";
+    hash = "sha256-N/qDGP//4RqwBNK2x+Q+AfTzBCtFPYuqmHOruO/KfVU=";
+  };
+  # Rewrite the release's code-level default backend (https://sub.store) so the
+  # API host follows location.hostname at runtime - i.e. always the host the
+  # panel page was opened with. The whole patch (sed rewrite + guards + sw.js
+  # cache marker) lives in sub-store-frontend-patch.sh and receives the module
+  # values as plain arguments, keeping this derivation free of nested quoting.
+  frontendDist = pkgs.runCommand "sub-store-frontend-${frontendVersion}" { } ''
+    mkdir -p "$out"
+    cp -r ${frontendRelease}/. "$out"
+    chmod -R u+w "$out"
+    bash ${./sub-store-frontend-patch.sh} "$out" ${toString panelApiPort} "${frontendVersion}"
+  '';
+
+  # Parse a single-unit duration ("30min" / "2h" / "1day") into whole minutes.
+  # Only forced when autoRefresh is enabled (the env merge is a lazy mkIf).
+  autoRefreshMinutes =
+    let
+      m = builtins.match "([0-9]+)(min|h|hr|day)" cfg.autoRefresh.interval;
+    in
+    if m == null then
+      throw ''modules.sub-store.autoRefresh.interval: "${cfg.autoRefresh.interval}" is not a supported duration; use one unit, e.g. "30min", "2h" or "1day"''
+    else
+      let
+        count = builtins.fromJSON (builtins.elemAt m 0);
+        unit = builtins.elemAt m 1;
+      in
+      count
+      * (
+        if unit == "min" then
+          1
+        else if unit == "h" || unit == "hr" then
+          60
+        else
+          1440
+      );
+
+  # A cron minute field can only step by divisors of 60 (the hours field by
+  # divisors of 24), so anything else fails the eval with the accepted values.
+  cronEveryMinutes =
+    minutes:
+    if minutes > 0 && minutes < 60 && 60 / minutes * minutes == 60 then
+      "*/${toString minutes} * * * *"
+    else if
+      minutes >= 60 && minutes / 60 * 60 == minutes && 24 / (minutes / 60) * (minutes / 60) == 24
+    then
+      "0 */${toString (minutes / 60)} * * *"
+    else
+      throw "modules.sub-store.autoRefresh.interval: ${toString minutes}min cannot be expressed as a cron step; use a divisor of 60 (1 2 3 4 5 6 10 12 15 20 30 60) or full hours dividing a day (120 180 240 360 480 720 1440)";
+
+  # SUB_STORE_PRODUCE_CRON = "<cron>,<type>,<name>[;<cron>,<type>,<name>...]" - the
+  # backend splits entries on ';' and fields on ',' (so the cron expression itself
+  # must contain no commas), then runs sn({type, name}) per entry on that schedule.
+  produceCron = lib.concatMapStringsSep ";" (
+    name: "${cronEveryMinutes autoRefreshMinutes},sub,${name}"
+  ) cfg.autoRefresh.subs;
+
+  # Caddy site address for a public port. A wildcard bind must stay hostless
+  # (":24500") - "0.0.0.0:24500" would install a literal Host matcher that only
+  # requests to Host 0.0.0.0 satisfy. A concrete bind keeps its hostname.
+  siteAddr =
+    port:
+    if cfg.host == "0.0.0.0" || cfg.host == "::" then
+      ":${toString port}"
+    else
+      "${cfg.host}:${toString port}";
+
+  # Where Sub-Store itself listens: with auth enabled it is loopback-only and
+  # Caddy holds the public ports, otherwise Sub-Store binds cfg.host directly.
+  apiHost = if cfg.auth.enable then "127.0.0.1" else cfg.host;
+  apiPort = if cfg.auth.enable then cfg.auth.upstreamApiPort else cfg.port;
+  frontendHost = if cfg.auth.enable then "127.0.0.1" else cfg.host;
+  frontendPort = if cfg.auth.enable then cfg.auth.upstreamFrontendPort else cfg.frontend.port;
+
+  # Port the patched panel backend defaults to (the host always follows
+  # location.hostname). Under auth.enable it must be the frontend's own port:
+  # Caddy routes /api/* there too, keeping API calls same-origin so no CORS
+  # preflight runs into Basic Auth. Without auth the public API port as before.
+  panelApiPort = if cfg.auth.enable then cfg.frontend.port else cfg.port;
+in
+{
+  options.modules.sub-store = {
+    enable = lib.mkEnableOption "Sub-Store subscription manager (Clash -> v2ray conversion for dae)";
+
+    port = lib.mkOption {
+      type = lib.types.port;
+      # Upstream Sub-Store listens on 3000, the port new-api used to occupy on
+      # this host, so a free high port was picked instead - dae already
+      # downloads from 127.0.0.1:24500, do not move it lightly.
+      default = 24500;
+      description = "TCP port of the Sub-Store backend API.";
+    };
+
+    host = lib.mkOption {
+      type = lib.types.str;
+      default = "127.0.0.1";
+      description = ''
+        Bind address of the backend API and of the web panel, used verbatim
+        when auth.enable is off (there is no authentication then, so the default
+        stays on loopback and any wider bind must be firewalled to trusted
+        interfaces - idols-ai does this). With auth.enable, Caddy takes this
+        bind on the public ports while Sub-Store moves to loopback-internal
+        ports.
+      '';
+    };
+
+    frontend = {
+      enable = lib.mkOption {
+        type = lib.types.bool;
+        default = true;
+        description = ''
+          Serve the official Sub-Store web panel (static PWA) from the same
+          service on a separate port (see `frontend.port`), with its default
+          backend URL patched to call the API on the host this page is opened
+          with.
+        '';
+      };
+
+      port = lib.mkOption {
+        type = lib.types.port;
+        # keep the panel next to the API on 24500
+        default = 24501;
+        description = "TCP port of the Sub-Store web panel (frontend static server).";
+      };
+    };
+
+    auth = {
+      enable = lib.mkEnableOption ''
+        Basic Auth (via a Caddy reverse proxy) in front of the API and the panel.
+        Sub-Store itself has no auth; when enabled it binds loopback-internal
+        ports (auth.upstreamApiPort / auth.upstreamFrontendPort) while Caddy
+        holds the public ports. Loopback clients and GET /download/* - i.e. dae
+        and every subscription link - stay passwordless.
+      '';
+
+      file = lib.mkOption {
+        type = lib.types.nullOr lib.types.path;
+        default = null;
+        description = ''
+          Runtime path of the htpasswd file imported by Caddy's basic_auth: one
+          or more `<user> <bcrypt hash>` lines, produced by
+          `caddy hash-password --plaintext '<password>'`. Point this at an
+          agenix secret so the hash never lands in this repository.
+        '';
+      };
+
+      upstreamApiPort = lib.mkOption {
+        type = lib.types.port;
+        default = 24510;
+        description = "Loopback port of the API while auth.enable is on; Caddy proxies `port` to it.";
+      };
+
+      upstreamFrontendPort = lib.mkOption {
+        type = lib.types.port;
+        default = 24511;
+        description = "Loopback port of the panel while auth.enable is on; Caddy proxies `frontend.port` to it.";
+      };
+    };
+
+    openFirewall = lib.mkOption {
+      type = lib.types.bool;
+      default = false;
+      description = ''
+        Open `port` (and `frontend.port` when the frontend is on) in the host
+        firewall for every interface, not just `trustedInterfaces`. Requires
+        auth.enable - exposing the unauthenticated management API and panel
+        beyond trusted interfaces would be unsafe.
+      '';
+    };
+
+    autoRefresh = {
+      enable = lib.mkEnableOption ''
+        periodic upstream refresh via SUB_STORE_PRODUCE_CRON, which re-fetches
+        every subscription listed in `subs` and updates its #cacheKey disk cache
+      '';
+
+      interval = lib.mkOption {
+        type = lib.types.str;
+        default = "60min";
+        example = "2h";
+        description = ''
+          Time between refreshes as a duration with a single unit: minutes
+          (`30min`), hours (`2h`) or days (`1day`); seconds are not supported.
+          It is converted into the cron part of SUB_STORE_PRODUCE_CRON, so the
+          value must be a divisor of 60 minutes or full hours dividing a day
+          (the eval fails otherwise). Upstream fetches are additionally capped
+          by Sub-Store's 1h in-memory cache, so sub-hour intervals do not
+          re-download more often than hourly.
+        '';
+      };
+
+      subs = lib.mkOption {
+        type = lib.types.listOf lib.types.str;
+        default = [ ];
+        example = [
+          "iKuuu1"
+          "iKuuu2"
+        ];
+        description = ''
+          Sub-Store subscription names to refresh on the interval, as shown in
+          the panel and by `GET /api/subs` (`data[].name`). Each name becomes
+          one `<interval>,sub,<name>` entry in SUB_STORE_PRODUCE_CRON.
+        '';
+      };
+    };
+
+    extraEnvironment = lib.mkOption {
+      type = lib.types.attrsOf lib.types.str;
+      default = { };
+      example = {
+        SUB_STORE_BACKEND_DEFAULT_PROXY = "http://127.0.0.1:7890";
+      };
+      description = ''
+        Extra `SUB_STORE_*` environment variables passed to the service, e.g.
+        SUB_STORE_BACKEND_DEFAULT_PROXY to fetch upstream subscriptions through
+        a local proxy.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    # autoRefresh without names would set an empty (silently ignored)
+    # SUB_STORE_PRODUCE_CRON - fail the eval instead of silently doing nothing.
+    # auth without an htpasswd file would deploy an unauthenticated Caddy, and
+    # openFirewall without auth would expose that same unprotected surface to
+    # every interface - both are configuration bugs, so fail the eval on them.
+    assertions =
+      lib.optional cfg.autoRefresh.enable {
+        assertion = cfg.autoRefresh.subs != [ ];
+        message = "modules.sub-store.autoRefresh.enable requires autoRefresh.subs to list at least one subscription name";
+      }
+      ++ lib.optional cfg.auth.enable {
+        assertion = cfg.auth.file != null;
+        message = "modules.sub-store.auth.enable requires auth.file - htpasswd lines from `caddy hash-password`, ideally via an agenix secret";
+      }
+      ++ lib.optional cfg.openFirewall {
+        assertion = cfg.auth.enable;
+        message = "modules.sub-store.openFirewall requires auth.enable - without Basic Auth the management API and panel must stay limited to trusted interfaces";
+      };
+
+    systemd.services.sub-store = {
+      description = "Sub-Store subscription manager";
+      wantedBy = [ "multi-user.target" ];
+      after = [ "network-online.target" ];
+      wants = [ "network-online.target" ];
+      environment = {
+        SUB_STORE_BACKEND_API_HOST = apiHost;
+        SUB_STORE_BACKEND_API_PORT = toString apiPort;
+        SUB_STORE_DATA_BASE_PATH = dataDir;
+      }
+      // lib.optionalAttrs cfg.frontend.enable {
+        # Static panel assets; the backend starts its frontend server for them on a
+        # separate port (API and panel stay independent, UI calls the API by URL).
+        SUB_STORE_FRONTEND_PATH = frontendDist;
+        SUB_STORE_FRONTEND_HOST = frontendHost;
+        SUB_STORE_FRONTEND_PORT = toString frontendPort;
+      }
+      // lib.optionalAttrs cfg.autoRefresh.enable {
+        SUB_STORE_PRODUCE_CRON = produceCron;
+      }
+      // cfg.extraEnvironment;
+      serviceConfig = {
+        ExecStart = "${lib.getExe pkgs.sub-store}";
+        Restart = "on-failure";
+        RestartSec = "5s";
+        DynamicUser = true;
+        StateDirectory = "sub-store";
+        # Relative default paths (e.g. mmdb caches) then land in the writable state dir.
+        WorkingDirectory = dataDir;
+        UMask = "0077";
+        # hardening
+        NoNewPrivileges = true;
+        ProtectSystem = "strict";
+        ProtectHome = true;
+        PrivateTmp = true;
+        ProtectKernelTunables = true;
+        ProtectKernelModules = true;
+        ProtectControlGroups = true;
+        RestrictSUIDSGID = true;
+        LockPersonality = true;
+        SystemCallArchitectures = "native";
+      };
+    };
+
+    # Basic Auth front: with auth.enable, Caddy holds the public ports on cfg.host
+    # while Sub-Store runs on loopback behind it (apiHost/frontendHost above).
+    # The API site skips the prompt for GET /download/* (subscription links stay
+    # direct links) and for loopback callers (dae, local panel); the panel site
+    # skips it for loopback and /download/* too, then splits traffic: /api/* and
+    # /download/* to the backend, everything else to the static frontend - the
+    # panel's own origin serves its API, so authenticated XHR never preflights.
+    # Every other remote request needs auth.file.
+    services.caddy = lib.mkIf cfg.auth.enable {
+      enable = true;
+      enableReload = true;
+      # Port-only vhosts over plain HTTP - never touch the ACME/TLS machinery.
+      globalConfig = "auto_https disable_certs";
+      virtualHosts = {
+        ${siteAddr cfg.port} = {
+          extraConfig = ''
+            @apiAuth {
+              not {
+                path_regexp ^/download/
+              }
+              not {
+                remote_ip 127.0.0.1 ::1
+              }
+            }
+            basic_auth @apiAuth {
+              import ${cfg.auth.file}
+            }
+            reverse_proxy http://127.0.0.1:${toString cfg.auth.upstreamApiPort}
+          '';
+        };
+        ${siteAddr cfg.frontend.port} = {
+          extraConfig = ''
+            @panelAuth {
+              not {
+                path_regexp ^/download/
+              }
+              not {
+                remote_ip 127.0.0.1 ::1
+              }
+            }
+            basic_auth @panelAuth {
+              import ${cfg.auth.file}
+            }
+            # Same-origin panel backend: the JS builds its API base from
+            # location.hostname + frontend.port (panelApiPort above), so route
+            # the API here instead of making the browser cross port 24500,
+            # where its preflight would meet Basic Auth and CORS would hide it.
+            @panelApi path /api/*
+            reverse_proxy @panelApi http://127.0.0.1:${toString cfg.auth.upstreamApiPort}
+            @panelDl path /download/*
+            reverse_proxy @panelDl http://127.0.0.1:${toString cfg.auth.upstreamApiPort}
+            reverse_proxy http://127.0.0.1:${toString cfg.auth.upstreamFrontendPort}
+          '';
+        };
+      };
+    };
+
+    # The proxy is part of the local chain (dae -> caddy -> sub-store), so bring
+    # it up with the same ordering guarantee as the converter itself.
+    systemd.services.caddy = lib.mkIf cfg.auth.enable {
+      wants = [ "sub-store.service" ];
+      after = [ "sub-store.service" ];
+    };
+
+    # dae fetches its subscriptions exactly once (at startup/reload), so make sure
+    # the local converter - and, with auth.enable, the Caddy front dae now reaches
+    # it through - is started and reachable before dae does.
+    systemd.services.dae = lib.mkIf (config.services.dae.enable or false) {
+      wants = [ "sub-store.service" ] ++ lib.optional cfg.auth.enable "caddy.service";
+      after = [ "sub-store.service" ] ++ lib.optional cfg.auth.enable "caddy.service";
+    };
+
+    # openFirewall widens exposure beyond trustedInterfaces; the assertions above
+    # guarantee that can only happen with Basic Auth in front.
+    networking.firewall.allowedTCPPorts =
+      lib.optional cfg.openFirewall cfg.port
+      ++ lib.optional (cfg.openFirewall && cfg.frontend.enable) cfg.frontend.port;
+  };
+}
diff --git a/modules/nixos/base/custom/network/sub-store/sub-store-frontend-patch.sh b/modules/nixos/base/custom/network/sub-store/sub-store-frontend-patch.sh
new file mode 100755
index 00000000..291d01a9
--- /dev/null
+++ b/modules/nixos/base/custom/network/sub-store/sub-store-frontend-patch.sh
@@ -0,0 +1,89 @@
+#!/usr/bin/env bash
+# ===============================================================================
+# Patch a Sub-Store panel dist (Sub-Store-Front-End release) at build time.
+#
+# The release hardcodes https://sub.store as its default API origin in TWO code
+# paths (a constant, and the `|| fallback` used when the hostAPI list is empty -
+# the one that actually runs on first visit) plus several i18n help texts.
+# Rewrite them all to a local origin first, then promote the quote-delimited
+# code-level defaults to the JS template literal
+#
+#   `http://${location.hostname||"127.0.0.1"}:<port>`
+#
+# so the panel always calls the backend on the host the page was actually
+# opened with (127.0.0.1 / LAN IP / 0.0.0.0-binds / SSH tunnels). Help texts
+# embed the origin unquoted and stay a readable static example. Finally touch
+# sw.js: a byte-different service worker makes browsers re-precache on the next
+# visit even though the hashed chunk filenames did not change.
+#
+# Usage: sub-store-frontend-patch.sh <dist-dir> <backend-port> <frontend-version>
+#   <dist-dir>          writable copy of the release dist (the derivation $out)
+#   <backend-port>      TCP port of the Sub-Store backend API (cfg.port)
+#   <frontend-version>  release version, stamped into the sw.js cache marker
+#
+# All module values arrive as plain arguments from sub-store/default.nix instead
+# of Nix string interpolation, so this file stays readable bash - including the
+# JS ${...} below, which the single quotes keep literal.
+# ===============================================================================
+set -euo pipefail
+
+if [ "$#" -ne 3 ]; then
+  echo "usage: $(basename "$0") <dist-dir> <backend-port> <frontend-version>" >&2
+  exit 2
+fi
+dist=$1
+port=$2
+version=$3
+
+if [ ! -d "$dist" ]; then
+  echo "sub-store-frontend-patch: no such dist dir: $dist" >&2
+  exit 2
+fi
+if [ ! -f "$dist/sw.js" ]; then
+  echo "sub-store-frontend-patch: expected $dist/sw.js to exist" >&2
+  exit 2
+fi
+
+# Static loopback origin: the sed step-1 target result and the exact quoted
+# token the step-2 rewrite and the guards look for. Deliberately NOT derived
+# from cfg.host - a bind address like 0.0.0.0 is not connectable from a browser.
+static_origin="http://127.0.0.1:${port}"
+static_token="\"${static_origin}\""                  # "http://127.0.0.1:24500"
+# Regex-escaped sed pattern WITH the surrounding quotes: only quote-delimited
+# occurrences (code-level defaults) may become dynamic; occurrences embedded in
+# help-text sentences keep the static origin.
+static_pattern=${static_token//./\\.}
+# Backticks and ${...} stay literal inside the single quotes; only the port is
+# spliced in by the shell.
+dynamic_origin='`http://${location.hostname||"127.0.0.1"}:'"${port}"'`'
+
+# 1) official URL -> local origin (code paths + help texts)
+find "$dist" -name '*.js' -exec sed -i "s#https://sub\.store#${static_origin}#g" {} +
+if grep -rFq 'https://sub.store' "$dist" --include='*.js'; then
+  echo "sub-store-frontend-patch: official backend reference left over" >&2
+  exit 1
+fi
+
+# 2) quote-delimited occurrences are code-level defaults -> location.hostname
+#    form. Unquoted occurrences (help texts) keep the static loopback origin.
+static_before=$(grep -rhoF "$static_token" "$dist" --include='*.js' | wc -l || true)
+if [ "$static_before" -lt 2 ]; then
+  echo "sub-store-frontend-patch: expected >= 2 quoted code defaults, found $static_before" >&2
+  exit 1
+fi
+find "$dist" -name '*.js' -exec sed -i "s#${static_pattern}#${dynamic_origin}#g" {} +
+static_after=$(grep -rhoF "$static_token" "$dist" --include='*.js' | wc -l || true)
+if [ "$static_after" -ne 0 ]; then
+  echo "sub-store-frontend-patch: $static_after quoted code defaults left after dynamic patch" >&2
+  exit 1
+fi
+dyn_count=$(grep -rhoF 'location.hostname' "$dist" --include='*.js' | wc -l || true)
+if [ "$dyn_count" -ne "$static_before" ]; then
+  echo "sub-store-frontend-patch: dynamic defaults $dyn_count != expected $static_before" >&2
+  exit 1
+fi
+
+# 3) touch sw.js: bust the service-worker precache despite unchanged chunk hashes
+printf '\n// nix-patch: %s location.hostname backend\n' "$version" >> "$dist/sw.js"
+
+echo "sub-store-frontend-patch: patched $dist - port $port, $static_before code default(s) now follow location.hostname"
diff --git a/modules/nixos/base/custom/notify/cpolar-status/cpolar-status-notify.sh b/modules/nixos/base/custom/notify/cpolar-status/cpolar-status-notify.sh
new file mode 100644
index 00000000..e82c199e
--- /dev/null
+++ b/modules/nixos/base/custom/notify/cpolar-status/cpolar-status-notify.sh
@@ -0,0 +1,75 @@
+#!/usr/bin/env bash
+# One-shot after boot: report cpolar tunnel status via ntfy(markdown) and a
+# desktop notification(if an active graphical session exists).
+#
+# All inputs are injected by the systemd unit as environment variables, so this
+# script stays free of any nix/config coupling:
+#   HOST_NAME                target hostname, e.g. ai
+#   USER_NAME                primary username, e.g. nixos(used by notify-send)
+#   NTFY_TOPIC_FILE          env-file providing $NTFY_TOPIC(required)
+#   CPOLAR_CREDENTIALS_FILE  env-file providing CPOLAR_USERNAME/CPOLAR_PASSWORD
+#   CPOLAR_STATUS_BIN        absolute path to the cpolar-status binary
+#
+# Missing credentials/topic are logged and skipped gracefully(exit 0); a failing
+# cpolar-status command exits non-zero so systemd(Restart = on-failure) retries.
+#
+# Message spec(repo-wide): title "<host> · cpolar tunnels",
+# tags "satellite_antenna", priority "low", markdown body.
+set -uo pipefail
+
+credentials_file="${CPOLAR_CREDENTIALS_FILE:?CPOLAR_CREDENTIALS_FILE must be set}"
+if [ -f "$credentials_file" ]; then
+  . "$credentials_file" 2>/dev/null
+fi
+if [ -z "${CPOLAR_USERNAME:-}" ] || [ -z "${CPOLAR_PASSWORD:-}" ]; then
+  echo "cpolar credentials unavailable($credentials_file missing/unreadable or empty), skip report" >&2
+  exit 0
+fi
+
+topic_file="${NTFY_TOPIC_FILE:?NTFY_TOPIC_FILE must be set}"
+if [ -f "$topic_file" ]; then
+  . "$topic_file"
+fi
+if [ -z "${NTFY_TOPIC:-}" ]; then
+  echo "ntfy topic unavailable($topic_file missing or NTFY_TOPIC empty), skip report" >&2
+  exit 0
+fi
+
+OUTPUT="$("$CPOLAR_STATUS_BIN" --username "$CPOLAR_USERNAME" --password "$CPOLAR_PASSWORD")" || {
+  echo "cpolar-status failed" >&2
+  exit 1
+}
+
+TUNNELS_MD="$(printf '%s\n' "$OUTPUT" | sed 's/^/- /')"
+
+MSG="**Host** ${HOST_NAME}
+**Tunnels (cpolar)**
+$TUNNELS_MD
+
+**Time** $(date --iso-8601=seconds)"
+
+notify_user() {
+  local pid env line
+  for pid in $(pgrep -u "$USER_NAME" -f .); do
+    env="$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null || true)"
+    if printf '%s\n' "$env" | grep -q '^WAYLAND_DISPLAY='; then
+      while IFS= read -r line; do
+        case "$line" in
+          WAYLAND_DISPLAY=*|DISPLAY=*|DBUS_SESSION_BUS_ADDRESS=*|XDG_RUNTIME_DIR=*) export "$line" ;;
+        esac
+      done <<<"$env"
+      notify-send "cpolar tunnels" "$OUTPUT" && return 0
+    fi
+  done
+  echo "no active graphical session for $USER_NAME, skip notify-send" >&2
+  return 1
+}
+notify_user || true
+
+ntfy publish \
+  --title "${HOST_NAME} · cpolar tunnels" \
+  --tags "satellite_antenna" \
+  --priority "low" \
+  --markdown \
+  "$NTFY_TOPIC" "$MSG" || echo "ntfy publish failed" >&2
+exit 0
diff --git a/modules/nixos/base/custom/notify/cpolar-status/default.nix b/modules/nixos/base/custom/notify/cpolar-status/default.nix
new file mode 100644
index 00000000..e8617f48
--- /dev/null
+++ b/modules/nixos/base/custom/notify/cpolar-status/default.nix
@@ -0,0 +1,124 @@
+# ===============================================================================
+#
+# One-shot after boot: report cpolar tunnel status via ntfy(markdown) and a
+# desktop notification(if an active graphical session exists).
+#
+# Notification metadata follows the repo-wide ntfy message spec:
+#   title "<host> · cpolar tunnels", tags "satellite_antenna", priority "low".
+#
+# Architecture note: the script's logic lives in ./cpolar-status-notify.sh
+# as a plain shell file(no nix interpolation inside), all config-dependent values
+# are injected into the systemd unit via `environment`.
+#
+# Secrets are sourced at runtime from environment files configurable via:
+#   - credentialsFile(default /etc/agenix/cpolar-status.env)
+#   - ntfyTopicFile(default /etc/agenix/ntfy-topic.env, provides $NTFY_TOPIC)
+# Missing credentials are logged and skipped gracefully; a failing cpolar-status
+# command exits non-zero so systemd(Restart = on-failure) retries it.
+#
+# Check logs:
+#   journalctl -u cpolar-status --since "10 minutes ago"
+{
+  config,
+  lib,
+  pkgs,
+  cpolar-status,
+  ...
+}:
+let
+  cfg = config.modules.cpolar-status;
+
+  cpolarStatus = cpolar-status.packages.${pkgs.system}.default;
+
+  script = pkgs.writeShellScript "cpolar-status-boot-notify" (
+    builtins.readFile ./cpolar-status-notify.sh
+  );
+in
+{
+  options.modules.cpolar-status = {
+    enable = lib.mkEnableOption ''
+      one-shot cpolar tunnel status report(via ntfy and desktop notification) after boot
+    '';
+
+    hostName = lib.mkOption {
+      type = lib.types.str;
+      description = ''
+        Hostname shown in the report message and the ntfy title.
+        Set it explicitly from the importing host(keeps this module decoupled
+        from other modules' configuration).
+      '';
+    };
+
+    username = lib.mkOption {
+      type = lib.types.str;
+      description = ''
+        Primary username, used to look up the active graphical session for
+        notify-send. Set it explicitly from the importing host.
+      '';
+    };
+
+    credentialsFile = lib.mkOption {
+      type = lib.types.path;
+      default = "/etc/agenix/cpolar-status.env";
+      description = ''
+        Environment file providing the cpolar credentials(CPOLAR_USERNAME and
+        CPOLAR_PASSWORD). When it is missing or unreadable, the report is
+        skipped gracefully with a log message.
+      '';
+    };
+
+    ntfyTopicFile = lib.mkOption {
+      type = lib.types.path;
+      default = "/etc/agenix/ntfy-topic.env";
+      description = ''
+        Environment file sourced at runtime to obtain the ntfy topic.
+        Expected content: NTFY_TOPIC=<topic>.
+      '';
+    };
+  };
+
+  config = lib.mkIf cfg.enable {
+    systemd.timers.cpolar-status = {
+      wantedBy = [ "timers.target" ];
+      timerConfig = {
+        Unit = "cpolar-status.service";
+        OnBootSec = "120s";
+      };
+    };
+
+    systemd.services.cpolar-status = {
+      description = "Report cpolar tunnel status after boot via ntfy and notify-send";
+      after = [
+        "network-online.target"
+        "cpolar.service"
+      ];
+      wants = [ "network-online.target" ];
+      path = with pkgs; [
+        bash
+        coreutils
+        procps
+        gnugrep
+        gnused
+        util-linux
+        libnotify
+        ntfy-sh
+      ];
+      # all config-dependent values are injected as environment variables,
+      # so that the shell script stays decoupled from nix evaluation.
+      environment = {
+        HOST_NAME = cfg.hostName;
+        USER_NAME = cfg.username;
+        NTFY_TOPIC_FILE = toString cfg.ntfyTopicFile;
+        CPOLAR_CREDENTIALS_FILE = toString cfg.credentialsFile;
+        CPOLAR_STATUS_BIN = toString (lib.getExe cpolarStatus);
+      };
+      serviceConfig = {
+        Type = "oneshot";
+        User = "root";
+        ExecStart = script;
+        Restart = "on-failure";
+        RestartSec = "30s";
+      };
+    };
+  };
+}
