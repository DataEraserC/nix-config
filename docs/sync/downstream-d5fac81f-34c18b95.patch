diff --git a/outputs/x86_64-linux/tests/zcode-acp/expr.nix b/outputs/x86_64-linux/tests/zcode-acp/expr.nix
new file mode 100644
index 00000000..0067290d
--- /dev/null
+++ b/outputs/x86_64-linux/tests/zcode-acp/expr.nix
@@ -0,0 +1,61 @@
+{
+  inputs,
+  lib,
+  outputs,
+  ...
+}:
+let
+  cfg = outputs.nixosConfigurations.ai-niri.config;
+  system = cfg.nixpkgs.hostPlatform.system;
+  dataEraserCPackages = inputs.nur-DataEraserC.legacyPackages.${system};
+  webmuxEnvironment = cfg.systemd.services.webmux.environment;
+  agent = builtins.fromJSON webmuxEnvironment.WEBMUX_ACP_AGENTS;
+  directoryOf = entry: if builtins.isAttrs entry then entry.directory else entry;
+  acpApp = cfg.modules.multi-instance.apps.zcode-acp;
+  cliApp = cfg.modules.multi-instance.apps.zcode-cli;
+  # `executable = null` means "use the app key" (resolved with command -v at
+  # runtime); compare what the launcher actually runs, not the raw option.
+  resolvedExecutable = name: app: if app.executable == null then name else app.executable;
+  guiApp = cfg.modules.multi-instance.apps.zcode;
+  stateRoot = cfg.modules.multi-instance.stateRoot;
+  preservedDirectories = map directoryOf cfg.modules.multi-instance.preserveDirectories;
+in
+{
+  module = {
+    enabled = cfg.modules.zcode-acp.enable;
+    package = cfg.modules.zcode-acp.package.pname;
+    version = cfg.modules.zcode-acp.package.version;
+    mainProgram = cfg.modules.zcode-acp.package.meta.mainProgram;
+    usesPinnedPackage =
+      toString cfg.modules.zcode-acp.package == toString dataEraserCPackages.zcode-acp;
+    vendorCliPname = cfg.modules.zcode-acp.vendorCli.pname or null;
+    vendorCliInstalled = builtins.elem cfg.modules.zcode-acp.vendorCli cfg.environment.systemPackages;
+    guiModuleEnabled = cfg.modules.zcode.enable;
+    guiEditionKeysRemoved =
+      !(builtins.hasAttr "zcode-cn" cfg.modules) && !(builtins.hasAttr "zcode-intl" cfg.modules);
+  };
+
+  multiInstance = {
+    appKeys = lib.filter (name: lib.hasPrefix "zcode" name) (
+      lib.attrNames cfg.modules.multi-instance.apps
+    );
+    acpExecutable = resolvedExecutable "zcode-acp" acpApp;
+    cliExecutable = resolvedExecutable "zcode-cli" cliApp;
+    sharedStateKey = acpApp.stateDirectoryKey == cliApp.stateDirectoryKey;
+    stateDirectoryKey = cliApp.stateDirectoryKey;
+    stateRoot = stateRoot;
+    instanceOneStatePath = "${stateRoot}/${cliApp.stateDirectoryKey}/1";
+    paths = cliApp.paths;
+    guiStateKey = if guiApp.stateDirectoryKey == null then "zcode" else guiApp.stateDirectoryKey;
+    preservedPaths = lib.filter (path: path == stateRoot || builtins.elem path cliApp.paths) (
+      lib.unique preservedDirectories
+    );
+  };
+
+  # Direct-only binding: the terminal side is the bridge's Martty TUI
+  # (bin/zcode-acp under a TTY); the official bundled CLI has no TUI.
+  webmux = {
+    agentKeys = lib.attrNames agent;
+    zcode = agent.zcode-acp;
+  };
+}
diff --git a/outputs/x86_64-linux/tests/zcode-acp/runtime.nix b/outputs/x86_64-linux/tests/zcode-acp/runtime.nix
new file mode 100644
index 00000000..69a33796
--- /dev/null
+++ b/outputs/x86_64-linux/tests/zcode-acp/runtime.nix
@@ -0,0 +1,89 @@
+{
+  config,
+  pkgs,
+}:
+let
+  fakeZcodeCli = pkgs.writeShellScriptBin "zcode-cli" ''
+    exit 0
+  '';
+  fakeZcodeAcp = pkgs.writeShellScriptBin "zcode-acp" ''
+    exit 0
+  '';
+  fakeZcodeAcpResume = pkgs.writeShellScriptBin "zcode-acp-resume" ''
+    exit 0
+  '';
+  fakeBwrap = pkgs.writeShellScriptBin "bwrap" ''
+    set -euo pipefail
+
+    while [ "$#" -gt 0 ] && [ "$1" != -- ]; do
+      shift
+    done
+    test "$#" -ge 2
+    test "$1" = --
+    shift
+
+    case "''${BWRAP_CASE:?BWRAP_CASE must name the expected invocation}" in
+      acp-1)
+        test "$#" -eq 1
+        test "$1" = ${fakeZcodeAcp}/bin/zcode-acp
+        ;;
+      acp-resume-1)
+        test "$#" -eq 2
+        test "$1" = ${fakeZcodeAcpResume}/bin/zcode-acp-resume
+        test "$2" = sess_test
+        ;;
+      cli-1)
+        test "$#" -eq 1
+        test "$1" = ${fakeZcodeCli}/bin/zcode-cli
+        ;;
+      cli-resume)
+        test "$#" -eq 2
+        test "$1" = ${fakeZcodeCli}/bin/zcode-cli
+        test "$2" = --resume
+        ;;
+      *)
+        exit 2
+        ;;
+    esac
+
+    printf '%s\n' "$BWRAP_CASE" >> "$BWRAP_TRACE"
+  '';
+  launcher = ../../../../modules/nixos/base/custom/multi-instance/multi-instance.sh;
+in
+pkgs.runCommandLocal "zcode-acp-multi-instance-state-test"
+  {
+    nativeBuildInputs = [
+      pkgs.bash
+      pkgs.coreutils
+      fakeZcodeCli
+      fakeZcodeAcp
+      fakeZcodeAcpResume
+      fakeBwrap
+    ];
+  }
+  ''
+    export HOME="$PWD/home"
+    export MULTI_INSTANCE_ROOT="$PWD/state"
+    export MULTI_INSTANCE_SPEC=${config.modules.multi-instance.specFile}
+    export BWRAP_TRACE="$PWD/bwrap.trace"
+    mkdir -p "$HOME"
+
+    # The adapter's TTY dispatch makes one multi-instance argv serve both
+    # sides: WebMux launches it in a PTY (Martty TUI) and over pipes (stdio).
+    BWRAP_CASE=acp-1 ${pkgs.bash}/bin/bash ${launcher} zcode-acp 1
+    BWRAP_CASE=acp-resume-1 ${pkgs.bash}/bin/bash ${launcher} zcode-acp-resume 1 sess_test
+    BWRAP_CASE=cli-1 ${pkgs.bash}/bin/bash ${launcher} zcode-cli 1
+    BWRAP_CASE=cli-resume ${pkgs.bash}/bin/bash ${launcher} zcode-cli 1 --resume
+
+    expected=$(printf 'acp-1\nacp-resume-1\ncli-1\ncli-resume')
+    test "$(cat "$BWRAP_TRACE")" = "$expected"
+
+    # Every zcode form shares one state directory per instance, so a session
+    # created on one side resumes on the other.
+    test -d "$MULTI_INSTANCE_ROOT/zcode-cli/1/.zcode"
+    test ! -e "$MULTI_INSTANCE_ROOT/zcode-acp"
+    test ! -e "$MULTI_INSTANCE_ROOT/zcode-acp-resume"
+    # The GUI app keeps its own state key; this test never creates it.
+    test ! -e "$MULTI_INSTANCE_ROOT/zcode"
+    touch "$out"
+  ''
diff --git a/outputs/x86_64-wsl/default.nix b/outputs/x86_64-wsl/default.nix
new file mode 100644
index 00000000..c73627df
--- /dev/null
+++ b/outputs/x86_64-wsl/default.nix
@@ -0,0 +1,46 @@
+{
+  lib,
+  inputs,
+  ...
+}@args:
+let
+  inherit (inputs) haumea;
+
+  # Contains all the flake outputs of this system architecture.
+  data = haumea.lib.load {
+    src = ./src;
+    inputs = args;
+  };
+  # nix file names is redundant, so we remove it.
+  dataWithoutPaths = builtins.attrValues data;
+
+  # Merge all the machine's data into a single attribute set.
+  outputs = {
+    nixosConfigurations = lib.attrsets.mergeAttrsList (
+      map (it: it.nixosConfigurations or { }) dataWithoutPaths
+    );
+    packages = lib.attrsets.mergeAttrsList (map (it: it.packages or { }) dataWithoutPaths);
+    # colmena contains some meta info, which need to be merged carefully.
+    colmenaMeta = {
+      nodeNixpkgs = lib.attrsets.mergeAttrsList (
+        map (it: it.colmenaMeta.nodeNixpkgs or { }) dataWithoutPaths
+      );
+      nodeSpecialArgs = lib.attrsets.mergeAttrsList (
+        map (it: it.colmenaMeta.nodeSpecialArgs or { }) dataWithoutPaths
+      );
+    };
+    colmena = lib.attrsets.mergeAttrsList (map (it: it.colmena or { }) dataWithoutPaths);
+  };
+in
+outputs
+// {
+  inherit data; # for debugging purposes
+
+  # NixOS's unit tests.
+  evalTests = haumea.lib.loadEvalTests {
+    src = ./tests;
+    inputs = args // {
+      inherit outputs;
+    };
+  };
+}
