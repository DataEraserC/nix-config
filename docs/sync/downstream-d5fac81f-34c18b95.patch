diff --git a/hosts/idols-ai/step-ca.nix b/hosts/idols-ai/step-ca.nix
new file mode 100644
index 00000000..5766f009
--- /dev/null
+++ b/hosts/idols-ai/step-ca.nix
@@ -0,0 +1,52 @@
+{
+  pkgs,
+  config,
+  ...
+}:
+let
+  domain = "ca.r";
+in
+{
+  # NOTE: local ca server for pki
+  # https://localhost
+  services.step-ca = {
+    enable = false;
+    intermediatePasswordFile = "/dev/null";
+    address = "0.0.0.0";
+    port = 1443;
+    settings = {
+      root = "${config.age.secrets.rootCAcrt.path}";
+      crt = "${config.age.secrets.intermediateCAcrt.path}";
+      key = "${config.age.secrets.intermediateCAkey.path}";
+      dnsNames = [ domain ];
+      logger.format = "text";
+      db = {
+        type = "badger";
+        dataSource = "/var/lib/step-ca/db";
+      };
+      authority = {
+        provisioners = [
+          {
+            type = "ACME";
+            name = "acme";
+            forceCN = true;
+          }
+        ];
+        claims = {
+          maxTLSCertDuration = "2160h";
+          defaultTLSCertDuration = "2160h";
+        };
+        backdate = "1m0s";
+      };
+      tls = {
+        cipherSuites = [
+          "TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256"
+          "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
+        ];
+        minVersion = 1.2;
+        maxVersion = 1.3;
+        renegotiation = false;
+      };
+    };
+  };
+}
diff --git a/hosts/idols-ai/sunshine.nix b/hosts/idols-ai/sunshine.nix
new file mode 100644
index 00000000..8634e9e8
--- /dev/null
+++ b/hosts/idols-ai/sunshine.nix
@@ -0,0 +1,71 @@
+{
+  config,
+  lib,
+  myvars,
+  ...
+}:
+let
+  # gdm-greeter users are declared by the nixpkgs gdm module as a fixed pool:
+  #   lib.genAttrs' [ null 1 2 3 4 ] (...)
+  # producing `gdm-greeter`, `gdm-greeter-2`, ..., `gdm-greeter-5`.
+  # Keep this list in sync with that module if the pool changes.
+  greeters = [
+    "gdm-greeter"
+  ]
+  ++ (map (i: "gdm-greeter-${toString i}") [
+    2
+    3
+    4
+    5
+  ]);
+  sunshineUsers = [
+    myvars.username
+  ]
+  ++ (if config.services.displayManager.gdm.enable then greeters else [ ]);
+in
+{
+  config = lib.mkIf (config.services.sunshine.enable) {
+    # The GDM greeter is itself a full graphical session running as one of the
+    # `gdm-greeter` users, so the globally-enabled sunshine user service also
+    # starts there. Its XDG dirs point at /var/lib/gdm/seat0/{config,state},
+    # which GDM recreates on every greeter start, so each time it generated a
+    # fresh self-signed certificate -> Moonlight required a new pairing every
+    # boot. Give both the login session and the greeter the same persistent
+    # identity by pointing them at one shared, group-writable data directory.
+    #
+    # Note: on hosts with an ephemeral root, persisting /var/lib/sunshine
+    # across reboots is declared in the host's preservation module, NOT here.
+
+    # dedicated group whose sole purpose is sharing sunshine data
+    users.groups.sunshine = { };
+
+    users.users = lib.genAttrs (sunshineUsers) (name: {
+      extraGroups = [ "sunshine" ];
+    });
+
+    # Bootstrap the shared dirs. `d` creates them; `z` re-asserts
+    # group/ownership/mode on every boot (setgid so anything created inside
+    # inherits group `sunshine`).
+    systemd.tmpfiles.rules = [
+      # The preservation bind mount itself must be traversable by members of
+      # the sunshine group. Fix the mount root before its child directories.
+      "d /var/lib/sunshine 2770 root sunshine - -"
+      "z /var/lib/sunshine 2770 root sunshine - -"
+      "d /var/lib/sunshine/config 2770 root sunshine - -"
+      "z /var/lib/sunshine/config 2770 root sunshine - -"
+      "d /var/lib/sunshine/state 2770 root sunshine - -"
+      "z /var/lib/sunshine/state 2770 root sunshine - -"
+    ];
+
+    # login + greeter sunshine instances share one identity directory
+    systemd.user.services.sunshine.serviceConfig = {
+      Environment = [
+        "XDG_CONFIG_HOME=/var/lib/sunshine/config"
+        "XDG_STATE_HOME=/var/lib/sunshine/state"
+      ];
+      # New files are group-writable so whichever instance (login or greeter,
+      # both members of group `sunshine`) wrote a file, the other can update it.
+      UMask = "0002";
+    };
+  };
+}
diff --git a/hosts/idols-ai/tpm_luks.nix b/hosts/idols-ai/tpm_luks.nix
new file mode 100644
index 00000000..655d2673
--- /dev/null
+++ b/hosts/idols-ai/tpm_luks.nix
@@ -0,0 +1,36 @@
+# https://github.com/Seanwanq/nix-config/blob/545b69d896b86749fe26a8ff4af8a66240cdde88/modules/tpm-luks.nix
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+
+{
+  # TPM 2.0 自动解锁 LUKS 加密磁盘
+  # 这样开机时不需要输入密码，只在登录时输入密码
+
+  # 启用 TPM 2.0 支持
+  security.tpm2 = {
+    enable = true;
+    pkcs11.enable = true; # PKCS#11 支持（可选）
+    tctiEnvironment.enable = true; # 设置 TCTI 环境变量
+  };
+
+  # 安装 TPM 管理工具
+  environment.systemPackages = with pkgs; [
+    tpm2-tools # TPM 2.0 命令行工具
+    tpm2-tss # TPM 2.0 软件栈
+  ];
+
+  # 启用 systemd-cryptenroll 用于 TPM 自动解锁
+  boot.initrd.systemd = {
+    enable = true;
+    # 在 initrd 阶段启用 TPM 支持
+    tpm2.enable = true;
+  };
+
+  # 配置 LUKS 设备使用 TPM 解锁
+  # 注意：这个配置在 TPM 注册完成后才会生效
+  # 首次需要手动注册（见下方说明）
+}
diff --git a/hosts/service-user-ids.nix b/hosts/service-user-ids.nix
new file mode 100644
index 00000000..8b0ae099
--- /dev/null
+++ b/hosts/service-user-ids.nix
@@ -0,0 +1,120 @@
+# Shared downstream service-id table for the AI and WSL hosts.
+#
+# Linux stores the numeric owner on disk, not the account name. When NixOS
+# reallocates a service UID/GID after the system user set changes, files under
+# /var/lib keep the old number and can resolve to an unrelated account. Pinning
+# every service id prevents that remap; a service that is currently disabled is
+# declared here too so enabling it later cannot shift its number.
+#
+# Values are the current numeric ids on idols-ai, read from /etc/passwd and
+# /var/lib/nixos/{uid,gid}-map:
+#
+#   getent passwd gnome-remote-desktop cliproxyapi m365-copilot2api \
+#     opencode2api ollama new-api alist agent2api omniroute \
+#     our-free-model-standalone mimocode2api cpolar meoo2api workbuddy2api
+#   getent group sunshine
+#
+# They are used for the WSL hosts under the same-allocation assumption. Verify
+# them there with getent before relying on the pins there; NixOS never changes
+# an existing account's uid/gid, so a mismatch only means the pin is inactive
+# (the account keeps its old number) rather than corrupting the data.
+#
+# Not in this table:
+#   - astrbot: not a pined/NUR service user, currently disabled, and its
+#     historical gid 958 now belongs to wpa_supplicant; pinning it would need a
+#     fresh gid and a data migration, which is outside this id-only change.
+#   - hadoop: local bigdata module, disabled, and its uid is in the normal-user
+#     range.
+#
+# The ids are global across these hosts on purpose: one table, no per-host
+# copies. If the WSL hosts turn out to have different historical allocations,
+# split this file per host and document why; do not silently change the shared
+# values.
+{ lib, ... }:
+let
+  serviceUsers = {
+    gnome-remote-desktop = {
+      uid = 989;
+      gid = 984;
+    };
+    cliproxyapi = {
+      uid = 995;
+      gid = 994;
+    };
+    m365-copilot2api = {
+      uid = 988;
+      gid = 982;
+    };
+    opencode2api = {
+      uid = 980;
+      gid = 974;
+    };
+    ollama = {
+      uid = 982;
+      gid = 976;
+    };
+    new-api = {
+      uid = 986;
+      gid = 980;
+    };
+    alist = {
+      uid = 998;
+      gid = 997;
+    };
+    agent2api = {
+      uid = 999;
+      gid = 998;
+    };
+    omniroute = {
+      uid = 981;
+      gid = 975;
+    };
+    our-free-model-standalone = {
+      uid = 979;
+      gid = 973;
+    };
+    mimocode2api = {
+      uid = 987;
+      gid = 981;
+    };
+    meoo2api = {
+      uid = 949;
+      gid = 949;
+    };
+    cpolar = {
+      uid = 993;
+      gid = 992;
+    };
+    # ACB issue service: a new account, so take a free id below the current
+    # 970+ block. The id must be fixed because the preserved SQLite database
+    # under /var/lib/acb-issue is owned by this account across reboots.
+    acb-issue = {
+      uid = 950;
+      gid = 950;
+    };
+    # workbuddy2api: a new account, so it takes the next free id in the 950+
+    # block. Fixed because its preserved tree under /var/lib/workbuddy2api
+    # (accounts, IDE pools, request logs) is owned by this account.
+    workbuddy2api = {
+      uid = 951;
+      gid = 951;
+    };
+  };
+
+  # Sunshine has no account: the desktop user services run as the logged-in
+  # user and only share the `sunshine` group.
+  extraGroups = {
+    sunshine = 964;
+  };
+in
+{
+  users.users = lib.mapAttrs (name: entry: {
+    uid = entry.uid;
+    isSystemUser = true;
+    group = name;
+  }) serviceUsers;
+
+  users.groups =
+    lib.mapAttrs (name: entry: { gid = entry.gid; }) serviceUsers
+    // lib.mapAttrs (_: gid: { inherit gid; }) extraGroups;
+}
