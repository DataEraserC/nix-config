+        // If no categories found yet, create default category
+        if (!currentCategory && !hasCategories) {
+          var defaultCategoryName = pluginApi?.tr("default-category");
+          currentCategory = { "title": defaultCategoryName, "binds": [] };
+        }
+
+        if (currentCategory) {
